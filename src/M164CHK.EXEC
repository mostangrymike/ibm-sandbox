/* M164: disposable real-CMS checkout/status/add gate. */
address cms
newoid=''
newowned=0
baseowned=0
basefn=''

call absent 'M164TST','DATA','A'
if result\=0 then exit 8
call absent 'GITWORK','REPO','A'
if result\=0 then exit 8
say 'M164 DISPOSABLE TARGETS ABSENT'

cmd='EXEC GIT CHECKOUT-FILE HEAD src/GIT.EXEC M164TST DATA A'
address command cmd
grc=rc
if grc\=0 then do
 call cleanup
 say 'M164 CHECKOUT FAIL RC' grc
 exit 8
end
say 'M164 CHECKOUT DIRECT RC0'

address command 'EXEC GIT STATUS'
src=rc
if src\=0 then do
 call cleanup
 say 'M164 INITIAL STATUS FAIL RC' src
 exit 8
end

drop m.
'EXECIO * DISKR GITWORK REPO A 1 (STEM M. FINIS'
if rc\=0 | m.0\=7 then do
 call cleanup
 say 'M164 MAP READ FAIL'
 exit 8
end
if m.1\='WORK1 1' | word(m.2,1)\='ENTRY' |,
   word(m.2,2)\='1' then do
 call cleanup
 say 'M164 MAP HEADER FAIL'
 exit 8
end
base=translate(word(m.3,3))
stage=translate(word(m.4,3))
final=word(m.2,6)
expected='0FCE3C85DD9335CA7A4868E806F09B890D115F80'
if word(m.3,1)\='BASE' | word(m.4,1)\='STAGE' |,
   base\=stage | base\=expected | word(m.2,6)\='0' then do
 call cleanup
 say 'M164 INITIAL MAP STATE FAIL'
 exit 8
end
say 'M164 INITIAL CLEAN MAP PASS'

basefn=substr(base,1,8)
call absent basefn,'GITOBJ','A'
if result\=0 then do
 call cleanup
 say 'M164 BASE LOOSE TARGET COLLISION'
 exit 8
end
baseowned=1
cmd='EXEC GIT IMPORT-OBJECT' base
address command cmd
irc=rc
if irc\=0 then do
 call cleanup
 say 'M164 IMPORT FAIL RC' irc
 exit 8
end
cmd='EXEC GIT VERIFY-OBJECT' base
address command cmd
vrc=rc
if vrc\=0 then do
 call cleanup
 say 'M164 IMPORT VERIFY FAIL RC' vrc
 exit 8
end
say 'M164 VERIFIED IMPORT PASS' base

drop t.
t.1='M164 PORCELAIN MODIFIED'
t.0=1
'EXECIO 1 DISKW M164TST DATA A 1 (STEM T. FINIS'
if rc\=0 then do
 call cleanup
 say 'M164 MODIFY FAIL'
 exit 8
end

drop h.
h.0=0
cmd='GIT HASH-WORKFILE M164TST DATA A' final
'PIPE CMS' cmd '| STEM h.'
if rc\=0 | h.0\=1 then do
 call cleanup
 say 'M164 MODIFIED HASH FAIL'
 exit 8
end
newoid=translate(strip(h.1))
if length(newoid)\=40 |,
   verify(newoid,'0123456789ABCDEF')\=0 | newoid=base then do
 call cleanup
 say 'M164 MODIFIED OID FAIL'
 exit 8
end
objfn=substr(newoid,1,8)
call absent objfn,'GITOBJ','A'
if result\=0 then do
 call cleanup
 say 'M164 LOOSE TARGET COLLISION'
 exit 8
end
newowned=1
say 'M164 MODIFIED HASH PASS' newoid

address command 'EXEC GIT STATUS'
src=rc
if src\=0 then do
 call cleanup
 say 'M164 MODIFIED STATUS FAIL RC' src
 exit 8
end

address command 'EXEC GIT ADD src/GIT.EXEC'
arc=rc
if arc\=0 then do
 call cleanup
 say 'M164 ADD FAIL RC' arc
 exit 8
end
drop m.
'EXECIO * DISKR GITWORK REPO A 1 (STEM M. FINIS'
if rc\=0 | m.0\=7 then do
 call cleanup
 say 'M164 STAGED MAP READ FAIL'
 exit 8
end
stage=translate(word(m.4,3))
if stage\=newoid | stage=base then do
 call cleanup
 say 'M164 STAGE OID FAIL'
 exit 8
end
say 'M164 STAGED MAP PASS'

address command 'EXEC GIT STATUS'
src=rc
if src\=0 then do
 call cleanup
 say 'M164 STAGED STATUS FAIL RC' src
 exit 8
end
cmd='EXEC GIT VERIFY-OBJECT' newoid
address command cmd
vrc=rc
if vrc\=0 then do
 call cleanup
 say 'M164 LOOSE VERIFY FAIL RC' vrc
 exit 8
end
say 'M164 LOOSE OBJECT PASS'

call cleanup
if result\=0 then do
 say 'M164 CLEANUP FAIL'
 exit 8
end
say 'M164 DISPOSABLE CLEANUP PASS'
say 'M164 PRACTICAL PORCELAIN TARGET GATE PASS'
exit 0

absent:
 parse arg afn,aft,afm
 'STATE' afn aft afm
 if rc=28 then return 0
 say 'M164: expected absent' afn aft afm 'RC' rc
 return 8

cleanup:
 crc=0
 'STATE M164TST DATA A'
 if rc=0 then do
  'ERASE M164TST DATA A'
  if rc\=0 then crc=8
 end
 else if rc\=28 then crc=8
 'STATE GITWORK REPO A'
 if rc=0 then do
  'ERASE GITWORK REPO A'
  if rc\=0 then crc=8
 end
 else if rc\=28 then crc=8
 if newowned=1 then do
  'STATE' objfn 'GITOBJ A'
  if rc=0 then do
   'ERASE' objfn 'GITOBJ A'
   if rc\=0 then crc=8
  end
  else if rc\=28 then nop
  else crc=8
 end
 if baseowned=1 then do
  'STATE' basefn 'GITOBJ A'
  if rc=0 then do
   'ERASE' basefn 'GITOBJ A'
   if rc\=0 then crc=8
  end
  else if rc\=28 then nop
  else crc=8
 end
 return crc
