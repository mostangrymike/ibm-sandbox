GITNHEX  CSECT
         EXTRN GITNAPI
         USING GITNHEX,12
         LR    12,15
         ST    14,RETCALL
         LA    13,SAVE
*
* M13R: test the actual hex/binary conversion on both sides of
* the external native ABI before adding CMS file I/O.
*
         LA    2,INHEX
         LA    3,INBIN
         LA    4,22
         BAL   14,HEXBIN
         LTR   15,15
         BNZ   BADIN
         CLC   INBIN(11),STREAM
         BNE   BADIN
         LA    1,PARAM
         L     15,=V(GITNAPI)
         BALR  14,15
         LTR   15,15
         BNZ   BADAPI
         CLC   PARAM+16(4),=F'3'
         BNE   BADAPI
         CLC   PARAM+20(4),=F'11'
         BNE   BADAPI
         CLC   OUTBIN(3),ABC
         BNE   BADAPI
         LA    2,OUTBIN
         LA    3,OUTHEX
         LA    4,3
         BAL   14,BINHEX
         CLC   OUTHEX(6),=C'616263'
         BNE   BADOUT
*
* Reject malformed hex and verify no partial native call.
*
         LA    2,BADHEX
         LA    3,INBIN
         LA    4,2
         BAL   14,HEXBIN
         LTR   15,15
         BZ    BADNEG
         LINEWRT DATA=(OKMSG,OKLEN)
         SR    15,15
         B     EXIT
BADIN    MVI   ERRSTG,C'I'
         B     FAILED
BADAPI   MVI   ERRSTG,C'A'
         B     FAILED
BADOUT   MVI   ERRSTG,C'O'
         B     FAILED
BADNEG   MVI   ERRSTG,C'N'
FAILED   LINEWRT DATA=(ERRMSG,ERRLEN)
         LA    15,8
EXIT     L     14,RETCALL
         BR    14
*
* HEXBIN R2 -> EBCDIC uppercase hex, R3 -> binary, R4
* character count (even). R15=0 success, 4 invalid digit.
* R6 and R7 are scratch; no calls or dynamic allocation.
*
HEXBIN   LR    10,14
         SR    15,15
         LR    5,4
         SRL   5,1
         LTR   5,5
         BZ    HBEND
HBLOOP   SR    6,6
         IC    6,0(2)
         BAL   14,NIBBLE
         LTR   15,15
         BNZ   HBEND
         SLL   6,4
         LR    7,6
         SR    6,6
         IC    6,1(2)
         BAL   14,NIBBLE
         LTR   15,15
         BNZ   HBEND
         OR    6,7
         STC   6,0(3)
         LA    2,2(2)
         LA    3,1(3)
         BCT   5,HBLOOP
HBEND    BR    10
*
* NIBBLE R6 EBCDIC hex -> numeric nibble; R15=4 invalid.
* EBCDIC 0-9 F0-F9, A-F C1-C6.
*
NIBBLE   SR    15,15
         C     6,=F'240'
         BL    NBALPHA
         C     6,=F'249'
         BH    NBALPHA
         S     6,=F'240'
         BR    14
NBALPHA  C     6,=F'193'
         BL    NBBAD
         C     6,=F'198'
         BH    NBBAD
         S     6,=F'183'
         BR    14
NBBAD    LA    15,4
         BR    14
*
* BINHEX R2 -> binary, R3 -> uppercase EBCDIC hex,
* R4 byte count. Table has 16 EBCDIC characters.
*
BINHEX   LTR   4,4
         BZ    BXEND
BXLOOP   SR    6,6
         IC    6,0(2)
         LR    7,6
         SRL   6,4
         IC    6,HEXDIG(6)
         STC   6,0(3)
         N     7,=F'15'
         IC    7,HEXDIG(7)
         STC   7,1(3)
         LA    2,1(2)
         LA    3,2(3)
         BCT   4,BXLOOP
BXEND    BR    14
         LTORG
         DS    0F
RETCALL  DS    F
SAVE     DS    18F
PARAM    DC    A(INBIN),F'11',A(OUTBIN),F'16'
         DC    F'0',F'0'
INHEX    DC    C'789C4B4C4A0600024D0127'
BADHEX   DC    C'0G'
STREAM   DC    X'789C4B4C4A0600024D0127'
ABC      DC    X'616263'
HEXDIG   DC    C'0123456789ABCDEF'
INBIN    DS    16C
OUTBIN   DS    16C
OUTHEX   DS    32C
OKMSG    DC    C'GITNHEX: HEX/BINARY NATIVE ABI PASSED'
OKLEN    EQU   *-OKMSG
ERRMSG   DC    C'GITNHEX: HEX/BINARY FAILED STAGE '
ERRSTG   DC    C'?'
ERRLEN   EQU   *-ERRMSG
         END   GITNHEX
