/* M12K decode captured POST HTTP chunks into upload-pack parser. */
address command
say 'M12K TEST 1: initialize upload-pack and chunk decoder'
'EXEC GIT10UP INIT'
if rc\=0 then exit rc
say 'M12K INIT GIT10UP DONE'
'EXEC GIT12CHK INIT GIT'
if rc\=0 then exit rc
say 'M12K INIT GIT12CHK DONE'
say 'M12K REPLAY START'
'STATE M11BODY DATA A'
if rc\=0 then exit 8
drop b.
i=1
do forever
 'EXECIO 1 DISKR M11BODY DATA A' i '(STEM B. FINIS'
 if rc\=0 & rc\=2 then do
  say 'M12K: input read failed record' i 'RC' rc
  exit 8
 end
 if b.0=0 then leave
 if b.0\=1 then exit 8
 h=strip(b.1)
 if h='' | length(h)//2\=0 | length(h)>128 then exit 8
 'EXEC GIT12CHK FEED' h
 if rc\=0 then do
  say 'M12K: chunk decoder failed record' i 'RC' rc
  exit rc
 end
 i=i+1
 if i//500=1 then say 'M12K REPLAY RECORD' i-1
 drop b.
end
say 'M12K REPLAY DONE RECORDS' i-1
'EXEC GIT12CHK FINAL'
if rc\=0 then do
 say 'M12K: chunk FINAL failed RC' rc
 exit rc
end
say 'M12K TEST 2: finalize live upload-pack response'
'TYPE G10CMT DATA A'
'TYPE G10META DATA A'
'TYPE GITPMETA PACK A'
'EXEC GIT10UP FINAL'
if rc\=0 then do
 say 'M12K: upload-pack FINAL failed RC' rc
 exit rc
end
say 'M12K TEST 3: verify live PACK checksum'
'EXEC GITPSHA VERIFY'
if rc\=0 then exit rc
say 'M12K TEST 4: walk live PACK'
'EXEC GITP9PWK WALK QUIET'
if rc\=0 then exit rc
say 'M12K LIVE GITHUB PACK PIPELINE PASSED'
exit 0
