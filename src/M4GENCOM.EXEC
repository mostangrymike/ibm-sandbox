/* M4 generalized Git commit regression */
address command

tree = 'B9E7816426B28421D7050FF4F501E7E796BC244A'
parent = '54BACE2202BB0C96980CDD0AAE9A752E6188D666'
want = '1E99ED02563737B793C60359F94BA587F6C1B8BD'

say 'M4 GENCOM TEST 1: tree prerequisite remains valid'
'EXEC GIT VERIFY-OBJECT' tree
if rc \= 0 then do
   say 'M4GENCOM: tree prerequisite missing RC=' rc
   exit rc
end

say 'M4 GENCOM TEST 2: parent commit remains valid'
'EXEC GIT VERIFY-OBJECT' parent
if rc \= 0 then do
   say 'M4GENCOM: parent prerequisite missing RC=' rc
   exit rc
end

say 'M4 GENCOM TEST 3: create commit with parent and mixed-case metadata'
cmd = 'EXEC GIT commit-tree' tree
cmd = cmd '-P' parent
cmd = cmd '-A Mixed_Case_<Case@Test.Invalid>'
cmd = cmd '-C Mixed_Case_<Case@Test.Invalid>'
cmd = cmd '-T 1234567890 -Z -0500'
cmd = cmd '-M Second_Commit_Message'
address command cmd
if rc \= 0 then do
   say 'M4GENCOM: COMMIT-TREE failed RC=' rc
   exit rc
end

say 'M4 GENCOM TEST 4: verify independently known commit OID'
'EXEC GIT VERIFY-OBJECT' want
if rc \= 0 then do
   say 'M4GENCOM: commit verification failed RC=' rc
   exit rc
end

say 'M4 GENCOM TEST 5: cat generalized commit'
'EXEC GIT CAT-OBJECT' want
if rc \= 0 then do
   say 'M4GENCOM: commit cat failed RC=' rc
   exit rc
end

say 'M4 GENERALIZED COMMIT-TREE TESTS PASSED'
exit 0
