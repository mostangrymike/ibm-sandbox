/* M20 native CATHEX CMS gate. No persistent file writes. */
/* Run ONLY on clean verified CMS disk after M01RES backup. */
address cms
say 'GITRCHK M20 READ-ONLY GENERATION OBJECT GATE'
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 'STATE GITFIX' typ 'A'
 if rc \= 0 then exit 12
 'STATE M15NEW' typ 'A'
 if rc \= 0 then exit 12
end
do i=0 to 1
 name='M15SL'||i
 'STATE' name 'PTR A'
 if rc \= 0 then exit 12
 name='GITSEL'||i
 'STATE' name 'PTR A'
 if rc \= 0 then exit 12
end
'STATE GITPBUF PACK A'
if rc \= 0 then exit 12
'STATE GITREC MODULE A'
if rc \= 0 then exit 12
oid='00D8D63229305230C8D37F884CE87F9E1A89468C'
'STATE M15BAD GEN A'
if rc \= 28 then do
 say 'GITRCHK STOP: missing-input fixture already exists'
 exit 12
end
'FILEDEF SEL0 DISK M15SL0 PTR A'
if rc \= 0 then exit rc
'FILEDEF SEL1 DISK M15SL1 PTR A'
if rc \= 0 then exit rc
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 dd=word('C0STG C0IDX C0SEEK C0GEN',i)
 'FILEDEF' dd 'DISK GITFIX' typ 'A'
 if rc \= 0 then exit rc
 dd=word('C1STG C1IDX C1SEEK C1GEN',i)
 'FILEDEF' dd 'DISK M15NEW' typ 'A'
 if rc \= 0 then exit rc
end
say 'CASE 1: COMPLETE NEW GENERATION GET'
'GITREC GET GITFIX M15NEW' oid
test=rc
say 'GITRCHK NEW GET RC' test
if test \= 0 then exit 12
say 'CASE 2: COMPLETE NEW GENERATION CATHEX'
'GITREC CATHEX GITFIX M15NEW' oid
test=rc
say 'GITRCHK NEW CATHEX RC' test
if test \= 0 then exit 12
say 'CASE 3: MISSING NEWER MANIFEST FALLBACK'
'FILEDEF C1GEN DISK M15BAD GEN A'
if rc \= 0 then exit rc
'GITREC CATHEX GITFIX M15NEW' oid
test=rc
say 'GITRCHK FALLBACK CATHEX RC' test
if test \= 0 then exit 12
say 'CASE 4: BOTH MANIFESTS MISSING FAIL CLOSED'
'FILEDEF C0GEN DISK M15BAD GEN A'
if rc \= 0 then exit rc
'GITREC CATHEX GITFIX M15NEW' oid
test=rc
say 'GITRCHK BOTH MISSING RC' test
if test \= 8 then exit 12
say 'CASE 5: RESTORE BOTH FULL VERIFIED INPUTS'
'FILEDEF C0GEN DISK GITFIX GEN A'
if rc \= 0 then exit rc
'FILEDEF C1GEN DISK M15NEW GEN A'
if rc \= 0 then exit rc
'GITREC CATHEX GITFIX M15NEW' oid
test=rc
say 'GITRCHK RESTORED CATHEX RC' test
if test \= 0 then exit 12
say 'GITRCHK M20 COMPLETED: NO DISK FILE WRITES'
exit 0
