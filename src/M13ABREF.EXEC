/* M13AB: unresolved REF_DELTA must fail closed. */
/* First object abc; second references nonexistent all-zero OID. */
address command
'EXEC GITPBUF INIT'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 5041434B000000020000000233789C4B4C4A0600024D0127'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 760000000000000000000000000000000000000000'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 7801010600F9FF03049003016402DB0100'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 0000000000000000000000000000000000000000'
if rc \= 0 then exit rc
'EXEC GITPBUF FINAL'
if rc \= 0 then exit rc
'EXEC GITPNWLK WALK QUIET NATIVE'
if rc = 0 then do
 say 'M13AB: ERROR unresolved REF was accepted'
 exit 8
end
if rc \= 8 then do
 say 'M13AB: unexpected failure RC' rc
 exit 8
end
say 'M13AB UNRESOLVED NATIVE REF FAIL-CLOSED PASSED'
exit 0
