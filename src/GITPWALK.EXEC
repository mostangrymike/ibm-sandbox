/* M8C complete PACK walker: ordinary, OFS_DELTA, REF_DELTA. */
parse arg command pack extra
command = translate(command)
pack = translate(pack)
if command \= 'WALK' | extra \= '' | pack = '' |,
   length(pack) // 2 \= 0 |,
   verify(pack,'0123456789ABCDEF') \= 0 then do
   say 'Usage: GITPWALK WALK pack-hex'
   exit 4
end
if length(pack) < 64 then do
   say 'GITPWALK: pack too short'
   exit 8
end
if substr(pack,1,8) \= '5041434B' then do
   say 'GITPWALK: invalid PACK signature'
   exit 8
end
version = x2d(substr(pack,9,8))
if version \= 2 & version \= 3 then do
   say 'GITPWALK: unsupported PACK version' version
   exit 8
end
count = x2d(substr(pack,17,8))
digestpos = length(pack) - 39
pos = 25
'EXEC GITPCTX CLEAR'
'EXEC GITPOID CLEAR'
do n = 1 to count
   if pos >= digestpos then do
      say 'GITPWALK: object count exceeds pack data'
      exit 8
   end
   entrypos = (pos - 1) % 2
   call objhdr
   if result \= 'OK' then exit 8
   if type = 7 then do
      if pos + 39 >= digestpos then do
         say 'GITPWALK: truncated REF_DELTA base id'
         exit 8
      end
      baseoid = substr(pack,pos,40)
      pos = pos + 40
      'EXEC GITPOID FIND' baseoid
      if rc \= 0 then exit rc
      parse pull basepos
      'EXEC GITPCTX GETSTACK' basepos
      if rc \= 0 then exit rc
      parse pull typename
      parse pull basehex
      call zentry
      if result \= 'OK' then exit 8
      deltahex = datahex
      if length(deltahex) % 2 \= objsize then do
         say 'GITPWALK: delta representation size mismatch'
         exit 8
      end
      'EXEC GITDAPP APPLYSTACK' basehex deltahex
      if rc \= 0 then exit rc
      parse pull datahex
   end
   else if type = 6 then do
      call ofshdr
      if result \= 'OK' then exit 8
      basepos = entrypos - distance
      'EXEC GITPCTX GETSTACK' basepos
      if rc \= 0 then exit rc
      parse pull typename
      parse pull basehex
      call zentry
      if result \= 'OK' then exit 8
      deltahex = datahex
      if length(deltahex) % 2 \= objsize then do
         say 'GITPWALK: delta representation size mismatch'
         exit 8
      end
      'EXEC GITDAPP APPLYSTACK' basehex deltahex
      if rc \= 0 then exit rc
      parse pull datahex
   end
   else do
      if type = 1 then typename = 'COMMIT'
      else if type = 2 then typename = 'TREE'
      else if type = 3 then typename = 'BLOB'
      else if type = 4 then typename = 'TAG'
      else do
         say 'GITPWALK: invalid packed object type' type
         exit 8
      end
      call zentry
      if result \= 'OK' then exit 8
      if length(datahex) % 2 \= objsize then do
         say 'GITPWALK: packed object size mismatch'
         exit 8
      end
   end
   'EXEC GITPCTX ADD' entrypos typename datahex
   if rc \= 0 then exit rc
   call objectoid typename,datahex
   if result = 'ERROR' then exit 8
   oid = result
   'EXEC GITPOID ADD' oid entrypos
   if rc \= 0 then exit rc
   say 'ENTRY' n 'POSITION' entrypos 'TYPE' typename 'SIZE' objsize
   say 'DATA' datahex
end
if pos \= digestpos then do
   say 'GITPWALK: bytes remain before pack checksum'
   exit 8
end
payload = substr(pack,1,digestpos-1)
expected = substr(pack,digestpos,40)
call streamsha payload
if result = 'ERROR' then exit 8
actual = result
if actual \= expected then do
   say 'GITPWALK: pack SHA-1 mismatch'
   say 'EXPECTED' expected
   say 'ACTUAL' actual
   exit 8
end
say 'PACK VERSION' version
say 'PACK OBJECTS' count
say 'PACK SHA1' actual
exit 0

objhdr:
   call nextbyte
   if result = 'ERROR' then return 'ERROR'
   b = result
   type = (b % 16) // 8
   objsize = b // 16
   shift = 4
   more = b >= 128
   do while more
      call nextbyte
      if result = 'ERROR' then return 'ERROR'
      b = result
      objsize = objsize + (b // 128) * (2 ** shift)
      shift = shift + 7
      more = b >= 128
      if shift > 60 then do
         say 'GITPWALK: object size header too large'
         return 'ERROR'
      end
   end
   return 'OK'

ofshdr:
   call nextbyte
   if result = 'ERROR' then return 'ERROR'
   b = result
   distance = b // 128
   more = b >= 128
   do while more
      call nextbyte
      if result = 'ERROR' then return 'ERROR'
      b = result
      distance = (distance + 1) * 128 + (b // 128)
      more = b >= 128
   end
   if distance < 1 | distance > entrypos then do
      say 'GITPWALK: invalid OFS_DELTA base distance' distance
      return 'ERROR'
   end
   return 'OK'

zentry:
   if pos + 3 >= digestpos then do
      say 'GITPWALK: truncated zlib header'
      return 'ERROR'
   end
   cmf = x2d(substr(pack,pos,2))
   flg = x2d(substr(pack,pos+2,2))
   if cmf // 16 \= 8 | cmf % 16 > 7 then do
      say 'GITPWALK: invalid zlib method/window'
      return 'ERROR'
   end
   if (cmf * 256 + flg) // 31 \= 0 then do
      say 'GITPWALK: invalid zlib FCHECK'
      return 'ERROR'
   end
   if (flg % 32) // 2 then do
      say 'GITPWALK: preset dictionary not supported'
      return 'ERROR'
   end
   defpos = pos + 4
   rest = substr(pack,defpos,digestpos-defpos)
   'EXEC GITINFL INFLATEINFO' rest
   if rc \= 0 then return 'ERROR'
   parse pull datahex
   parse pull used
   if datatype(used,'W') \= 1 | used < 1 then do
      say 'GITPWALK: invalid inflater byte count'
      return 'ERROR'
   end
   trailer = defpos + used * 2
   if trailer + 7 >= digestpos then do
      say 'GITPWALK: truncated zlib trailer'
      return 'ERROR'
   end
   expectedad = substr(pack,trailer,8)
   call adler datahex
   if result \= expectedad then do
      say 'GITPWALK: Adler-32 mismatch'
      return 'ERROR'
   end
   pos = trailer + 8
   return 'OK'

nextbyte:
   if pos + 1 >= digestpos then do
      say 'GITPWALK: truncated object header'
      return 'ERROR'
   end
   v = x2d(substr(pack,pos,2))
   pos = pos + 2
   return v

objectoid: procedure
   parse upper arg typename,data
   if typename = 'BLOB' then head = '626C6F62'
   else if typename = 'TREE' then head = '74726565'
   else if typename = 'COMMIT' then head = '636F6D6D6974'
   else if typename = 'TAG' then head = '746167'
   else return 'ERROR'
   size = length(data) % 2
   dec = size
   digits = ''
   if dec = 0 then digits = '30'
   else do while dec > 0
      d = dec // 10
      digits = d2x(48+d,2) || digits
      dec = dec % 10
   end
   bytes = head || '20' || digits || '00' || data
   call streamsha bytes
   return result

adler: procedure
   parse arg data
   s1 = 1
   s2 = 0
   do p = 1 to length(data) by 2
      b = x2d(substr(data,p,2))
      s1 = (s1 + b) // 65521
      s2 = (s2 + s1) // 65521
   end
   return d2x(s2,4) || d2x(s1,4)

streamsha: procedure
   parse arg data
   bytes = length(data) % 2
   'MAKEBUF'
   queue right(d2x(bytes),8,'0')
   do while length(data) > 128
      queue left(data,128)
      data = substr(data,129)
   end
   if data \= '' then queue data
   'GITSTRM'
   r = rc
   if r \= 0 then do
      'DROPBUF'
      say 'GITPWALK: GITSTRM failed RC=' r
      return 'ERROR'
   end
   parse pull digest
   'DROPBUF'
   return digest
