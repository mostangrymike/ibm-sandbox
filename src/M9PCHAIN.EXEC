/* M9P reconstructed-delta base chain regression. */
address command
say 'M9PCHAIN TEST: reconstructed delta becomes next base'
pack='5041434B0000000200000003'
pack=pack||'33789C4B4C4A0600024D0127'
pack=pack||'660C789C636699C0CC98020002DB0100'
pack=pack||'6610789C63619DC0C2980A0002EA0104'
pack=pack||'96FF1CEAC98EF64C00DD8046D67696DAD9EB72FC'
'EXEC GITPBUF WRITE' pack
if rc\=0 then exit rc
'EXEC GITPSHA VERIFY'
if rc\=0 then exit rc
'EXEC GITP9PWK WALK'
if rc\=0 then exit rc
say 'EXPECTED FINAL OID 6A8165460570531A1247BD99A73B53A5A6E500D5'
say 'M9P RECONSTRUCTED-DELTA BASE CHAIN TEST PASSED'
exit 0
