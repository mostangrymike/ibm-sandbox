/* M6B isolated Git v0/v1 ref-advertisement parser. */
parse arg command rest
command = translate(command)

if command = 'PARSE' then do
   parse var rest datahex extra
   if datahex = '' | extra \= '' | length(datahex) // 2 \= 0 |,
      verify(translate(datahex),'0123456789ABCDEF') \= 0 then do
      say 'Usage: GITADV PARSE payload-hex'
      exit 4
   end
   nul = bytepos('00',datahex)
   if nul > 0 then do
      mainhex = substr(datahex,1,nul-1)
      caphex = substr(datahex,nul+2)
   end
   else do
      mainhex = datahex
      caphex = ''
   end
   sp = bytepos('20',mainhex)
   if sp \= 41 then do
      say 'GITADV: invalid advertised ref payload'
      exit 8
   end
   oidhex = translate(substr(mainhex,1,40))
   if verify(oidhex,'0123456789ABCDEF') \= 0 then do
      say 'GITADV: invalid object-id'
      exit 8
   end
   refhex = substr(mainhex,43)
   if refhex = '' then do
      say 'GITADV: missing ref name'
      exit 8
   end
   refname = asciitocms(refhex)
   if refname = 'ERROR' then exit 8
   if pos(' ',refname) > 0 then do
      say 'GITADV: invalid ref name'
      exit 8
   end
   say 'OID' oidhex
   say 'REF' refname
   if caphex \= '' then do
      caps = asciitocms(caphex)
      if caps = 'ERROR' then exit 8
      say 'CAPS' caps
   end
   exit 0
end
say 'GITADV: unknown command' command
exit 4

bytepos: procedure
   parse arg needle, hex
   needle = translate(needle)
   do p = 1 to length(hex)-1 by 2
      if translate(substr(hex,p,2)) = needle then return p
   end
   return 0

asciitocms: procedure
   parse arg hex
   if length(hex) // 2 \= 0 |,
      verify(translate(hex),'0123456789ABCDEF') \= 0 then do
      say 'GITADV: invalid ASCII hex'
      return 'ERROR'
   end
   ascii = x2c(hex)
   atab = x2c('202122232425262728292A2B2C2D2E2F')
   atab = atab || x2c('303132333435363738393A3B3C3D3E3F')
   atab = atab || x2c('404142434445464748494A4B4C4D4E4F')
   atab = atab || x2c('505152535455565758595A5B5C5D5E5F')
   atab = atab || x2c('606162636465666768696A6B6C6D6E6F')
   atab = atab || x2c('707172737475767778797A7B7C7D7E')
   etab = x2c('405A7F7B5B6C507D4D5D5C4E6B604B61')
   etab = etab || x2c('F0F1F2F3F4F5F6F7F8F97A5E4C7E6E6F')
   etab = etab || x2c('7CC1C2C3C4C5C6C7C8C9D1D2D3D4D5D6')
   etab = etab || x2c('D7D8D9E2E3E4E5E6E7E8E9BAE0BBB06D')
   etab = etab || x2c('79818283848586878889919293949596')
   etab = etab || x2c('979899A2A3A4A5A6A7A8A9C04FD0A1')
   return translate(ascii,etab,atab)
