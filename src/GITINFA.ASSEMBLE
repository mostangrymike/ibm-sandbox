GITINFA  CSECT
         USING GITINFA,12
         LR    12,15
         ST    14,RETADDR
*
* M13N stage 1: prove native CMS MODULE loading and bounded
* 32 KiB history work area before moving DEFLATE hot loops.
* Stage 1 accepts any invocation; argument parsing is not needed yet.
*
         MVC   HIST(256),PATTERN
         CLC   HIST(256),PATTERN
         BNE   BADHIST
         LA    4,HIST
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,3840(4)
         MVC   0(256,4),PATTERN
         CLC   0(256,4),PATTERN
         BNE   BADHIST
         LINEWRT DATA=(OKMSG,OKLEN)
         SR    15,15
         B     RETURN
BADHIST  LINEWRT DATA=(HMSG,HMSGLEN)
         LA    15,8
RETURN   L     14,RETADDR
         BR    14
         LTORG
OKMSG    DC    C'GITINFA: NATIVE 32K WINDOW SELFTEST PASSED'
OKLEN    EQU   *-OKMSG
HMSG     DC    C'GITINFA: 32K WINDOW SELFTEST FAILED'
HMSGLEN  EQU   *-HMSG
RETADDR  DS    F
PATTERN  DC    32CL8'GITINFL!'
         DS    0D
HIST     DS    32768C
         END   GITINFA
