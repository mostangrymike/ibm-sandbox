GITINFA  CSECT
         USING GITINFA,12
         LR    12,15
         LA    1,4095(12)
         LA    1,1(1)
         USING GITINFA+4096,1
         L     13,=A(DATAORG)
         USING DATAORG,13
         ST    14,RETADDR
*
* M13N native DEFLATE core regression.
* Exercise window, bit reader, fixed Huffman, and LZ77 in one run.
*
         L     4,=A(HIST)
         MVC   0(256,4),PATTERN
         CLC   0(256,4),PATTERN
         BNE   BADHIST
         L     4,=A(HIST)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,4095(4)
         LA    4,1(4)
         LA    4,3840(4)
         MVC   0(256,4),PATTERN
         CLC   0(256,4),PATTERN
         BNE   BADHIST
*
* Decode complete fixed-Huffman streams in native code.
* ABCFIX expands to abc using literals.
* REPTEST expands to 259 a bytes and forces length/distance copying.
*
         LA    2,ABCFIX
         LA    3,5
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,INFLATE
         LTR   15,15
         BNZ   BADFIX
         C     6,=F'3'
         BNE   BADFIX
         C     7,=F'5'
         BNE   BADFIX
         L     4,=A(ABCOUT)
         CLC   0(3,4),ABCDATA
         BNE   BADFIX
         LA    2,REPTEST
         LA    3,6
         L     4,=A(REPOUT)
         LA    5,300
         BAL   14,INFLATE
         LTR   15,15
         BNZ   BADLZ
         C     6,=F'259'
         BNE   BADLZ
         L     4,=A(REPOUT)
         CLI   0(4),X'61'
         BNE   BADLZ
         CLI   258(4),X'61'
         BNE   BADLZ
         LA    2,DYNTEST
         L     3,DYNLEN
         L     4,=A(DYNOUT)
         L     5,DYNOCAP
         BAL   14,INFLATE
         C     15,=F'12'
         BE    BADTREE
         LTR   15,15
         BNZ   BADDECO
         C     6,DYNOEXP
         BNE   BADSIZE
         L     4,=A(DYNOUT)
         CLC   0(16,4),DYNPFX
         BNE   BADPFX
         LA    9,120
DYNVLP   CLC   0(45,4),DYNLINE
         BNE   BADPFX
         LA    4,45(4)
         BCT   9,DYNVLP
         LA    2,STTEST
         LA    3,8
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,INFLATE
         LTR   15,15
         BNZ   BADSTORE
         C     6,=F'3'
         BNE   BADSTORE
         C     7,=F'8'
         BNE   BADSTORE
         L     4,=A(ABCOUT)
         CLC   0(3,4),ABCDATA
         BNE   BADSTORE
         LA    2,MBTEST
         LA    3,13
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,INFLATE
         LTR   15,15
         BNZ   BADMULT
         C     6,=F'6'
         BNE   BADMULT
         C     7,=F'13'
         BNE   BADMULT
         L     4,=A(ABCOUT)
         CLC   0(6,4),ABC6
         BNE   BADMULT
         LA    2,ZTEST
         LA    3,11
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,ZINFLATE
         LTR   15,15
         BNZ   BADZLIB
         C     6,=F'3'
         BNE   BADZLIB
         C     7,=F'11'
         BNE   BADZLIB
         L     4,=A(ABCOUT)
         CLC   0(3,4),ABCDATA
         BNE   BADZLIB
         LA    2,ZTRAIL
         LA    3,14
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,ZINFLATE
         LTR   15,15
         BNZ   BADZLIB
         C     6,=F'3'
         BNE   BADZLIB
         C     7,=F'11'
         BNE   BADZLIB
         L     4,=A(ABCOUT)
         CLC   0(3,4),ABCDATA
         BNE   BADZLIB
*
* PACK boundary gate: two adjacent zlib streams. The first call
* must stop at its own Adler32; the second starts at byte 11.
*
         LA    2,ZPAIR
         LA    3,22
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,ZINFLATE
         LTR   15,15
         BNZ   BADZLIB
         C     6,=F'3'
         BNE   BADZLIB
         C     7,=F'11'
         BNE   BADZLIB
         LA    2,ZPAIR+11
         LA    3,11
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,ZINFLATE
         LTR   15,15
         BNZ   BADZLIB
         C     6,=F'3'
         BNE   BADZLIB
         C     7,=F'11'
         BNE   BADZLIB
         L     4,=A(ABCOUT)
         CLC   0(3,4),ABCDATA
         BNE   BADZLIB
*
* Bounded zlib failure cases: truncated header/trailer, too-small
* output, and corrupt checksum with trailing PACK data.
*
         LA    2,ZTEST
         LA    3,5
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,ZINFLATE
         LTR   15,15
         BZ    BADZLIB
         LA    2,ZTEST
         LA    3,10
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,ZINFLATE
         LTR   15,15
         BZ    BADZLIB
         LA    2,ZTEST
         LA    3,11
         L     4,=A(ABCOUT)
         LA    5,2
         BAL   14,ZINFLATE
         LTR   15,15
         BZ    BADZLIB
         LA    2,ZBADTL
         LA    3,14
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,ZINFLATE
         LTR   15,15
         BZ    BADZLIB
*
* Dynamic Huffman zlib gate: 5400 bytes, 76-byte DEFLATE body.
* Verify complete output and total 82-byte stream consumption.
*
         LA    2,ZDYTEST
         LA    3,82
         L     4,=A(DYNOUT)
         L     5,DYNOCAP
         BAL   14,ZINFLATE
         LTR   15,15
         BNZ   BADZLIB
         C     6,DYNOEXP
         BNE   BADZLIB
         C     7,=F'82'
         BNE   BADZLIB
         L     4,=A(DYNOUT)
         LA    9,120
ZDYNVLP  CLC   0(45,4),DYNLINE
         BNE   BADZLIB
         LA    4,45(4)
         BCT   9,ZDYNVLP
         LA    2,ZDYTEST
         LA    3,82
         L     4,=A(DYNOUT)
         LA    5,100
         BAL   14,ZINFLATE
         LTR   15,15
         BZ    BADZLIB
*
* Native callable parameter-list contract, using the same
* bounded binary interface a CMS adapter will invoke.
*
         LA    2,ZPAIR
         ST    2,APITEST
         LA    2,22
         ST    2,APITEST+4
         L     2,=A(ABCOUT)
         ST    2,APITEST+8
         LA    2,16
         ST    2,APITEST+12
         XC    APITEST+16(8),APITEST+16
         LA    2,APITEST
         BAL   14,APICALL
         LTR   15,15
         BNZ   BADZLIB
         CLC   APITEST+16(4),=F'3'
         BNE   BADZLIB
         CLC   APITEST+20(4),=F'11'
         BNE   BADZLIB
         L     4,=A(ABCOUT)
         CLC   0(3,4),ABCDATA
         BNE   BADZLIB
         LA    2,2
         ST    2,APITEST+12
         LA    2,APITEST
         BAL   14,APICALL
         LTR   15,15
         BZ    BADZLIB
         CLC   APITEST+16(8),ZERO8
         BNE   BADZLIB
         LA    2,ZBADHDR
         LA    3,11
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,ZINFLATE
         LTR   15,15
         BZ    BADZLIB
         LA    2,ZBADSUM
         LA    3,11
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,ZINFLATE
         LTR   15,15
         BZ    BADZLIB
         LA    2,ABCFIX
         LA    3,2
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,INFLATE
         LTR   15,15
         BZ    BADNEG
         LA    2,ABCFIX
         LA    3,5
         L     4,=A(ABCOUT)
         LA    5,2
         BAL   14,INFLATE
         LTR   15,15
         BZ    BADNEG
         LA    2,STBAD
         LA    3,8
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,INFLATE
         LTR   15,15
         BZ    BADNEG
         LA    2,RSVTEST
         LA    3,1
         L     4,=A(ABCOUT)
         LA    5,16
         BAL   14,INFLATE
         LTR   15,15
         BZ    BADNEG
         LINEWRT DATA=(OKMSG,OKLEN)
         LINEWRT DATA=(FIXMSG,FIXLEN)
         LINEWRT DATA=(LZMSG,LZLEN)
         LINEWRT DATA=(DYNMSG,DYNLENM)
         LINEWRT DATA=(STMSG,STMLEN)
         LINEWRT DATA=(MBMSG,MBMLEN)
         LINEWRT DATA=(ZMSG,ZMLEN)
         LINEWRT DATA=(NEGMSG,NEGLEN)
         SR    15,15
         B     RETURN
BADHIST  LINEWRT DATA=(HMSG,HMSGLEN)
         LA    15,8
         B     RETURN
BADFIX   LINEWRT DATA=(FMSG,FMSGLEN)
         LA    15,8
         B     RETURN
BADLZ    LINEWRT DATA=(LMSG,LMSGLEN)
         LA    15,8
         B     RETURN
BADTREE  LINEWRT DATA=(TMSG,TMSGLEN)
         LA    15,8
         B     RETURN
BADDECO  LINEWRT DATA=(EMSG,EMSGLEN)
         LA    15,8
         B     RETURN
BADSIZE  LINEWRT DATA=(SMSG,SMSGLEN)
         LA    15,8
         B     RETURN
BADPFX   LINEWRT DATA=(PMSG,PMSGLEN)
         LA    15,8
         B     RETURN
BADSTORE LINEWRT DATA=(STERR,STERLEN)
         LA    15,8
         B     RETURN
BADMULT  LINEWRT DATA=(MBERR,MBERLEN)
         LA    15,8
         B     RETURN
BADZLIB  LINEWRT DATA=(ZERR,ZERLEN)
         LA    15,8
         B     RETURN
BADNEG   LINEWRT DATA=(NEGERR,NERLEN)
         LA    15,8
         B     RETURN
RETURN   L     14,RETADDR
         BR    14
         LTORG
*
*
* APICALL: internal bounded binary ABI for the CMS adapter.
* R2 -> six fullwords: input ptr, input bytes, output ptr,
* output capacity, decoded bytes, consumed zlib bytes.
* R15=0 success, 4 invalid arguments, 8 decode failure.
* On failure both output counts remain zero.
*
APICALL  ST    14,APIRET
         ST    2,APIPTR
         LTR   2,2
         BZ    APIBAD
         LR    11,2
         XC    16(8,11),16(11)
         L     2,0(11)
         L     3,4(11)
         L     4,8(11)
         L     5,12(11)
         LTR   2,2
         BZ    APIBAD
         LTR   4,4
         BZ    APIBAD
         LTR   3,3
         BNP   APIBAD
         LTR   5,5
         BNP   APIBAD
         BAL   14,ZINFLATE
         LTR   15,15
         BNZ   APIEXIT
         L     11,APIPTR
         ST    6,16(11)
         ST    7,20(11)
APIEXIT  L     14,APIRET
         BR    14
APIBAD   LA    15,4
         B     APIEXIT
         LTORG
*
* ZINFLATE - bounded zlib wrapper with CMF/FLG and Adler32.
* R2=input, R3=bytes, R4=output, R5=capacity.
* No preset dictionaries. R7=total consumed bytes on success.
* Checksum computed over decoded bytes, not trailing PACK data.
*
ZINFLATE ST    14,ZRET
         C     3,=F'6'
         BL    ZFAIL
         ST    2,ZPTR
         ST    3,ZSIZE
         ST    4,ZOUT
         XR    7,7
         IC    7,0(2)
         LR    8,7
         N     8,=F'15'
         C     8,=F'8'
         BNE   ZFAIL
         SRL   7,4
         C     7,=F'7'
         BH    ZFAIL
         XR    8,8
         IC    8,1(2)
         LR    9,8
         N     9,=F'32'
         BNZ   ZFAIL
         SLL   7,4
         LA    7,8(7)
         SLL   7,8
         OR    7,8
         LR    8,7
         SR    6,6
         D     6,=F'31'
         LTR   6,6
         BNZ   ZFAIL
         L     2,ZPTR
         LA    2,2(2)
         L     3,ZSIZE
         S     3,=F'6'
         BAL   14,INFLATE
         LTR   15,15
         BNZ   ZFAIL
         ST    6,ZLEN
         L     7,BITUSED
         LA    7,6(7)
         ST    7,ZUSED
         LA    7,1
         SR    8,8
         L     4,ZOUT
         SR    9,9
ZADLOOP  C     9,ZLEN
         BNL   ZADCMP
         XR    10,10
         IC    10,0(4,9)
         AR    7,10
         C     7,=F'65521'
         BL    ZADSUM
         S     7,=F'65521'
ZADSUM   AR    8,7
         C     8,=F'65521'
         BL    ZADNEXT
         S     8,=F'65521'
ZADNEXT  LA    9,1(9)
         B     ZADLOOP
ZADCMP   SLL   8,16
         OR    8,7
         L     2,ZUSED
         C     2,ZSIZE
         BH    ZFAIL
         L     2,ZPTR
         A     2,BITUSED
         LA    2,2(2)
         XR    9,9
         IC    9,0(2)
         SLL   9,8
         XR    10,10
         IC    10,1(2)
         OR    9,10
         SLL   9,8
         XR    10,10
         IC    10,2(2)
         OR    9,10
         SLL   9,8
         XR    10,10
         IC    10,3(2)
         OR    9,10
         CR    8,9
         BNE   ZFAIL
         L     6,ZLEN
         L     7,ZUSED
         SR    15,15
         L     14,ZRET
         BR    14
ZFAIL    LA    15,8
         L     14,ZRET
         BR    14
         LTORG
*
* INFLATE - raw DEFLATE core for native regression.
* R2=input, R3=input bytes, R4=output, R5=output capacity.
* Success: R6=output bytes, R7=compressed bytes, R15=0.
*
INFLATE  ST    14,INFRET
         ST    2,INPTR
         ST    3,INLEN
         ST    4,OUTPTR
         ST    5,OUTCAP
         XC    BITPOS(4),BITPOS
         XC    OUTLEN(4),OUTLEN
IFBLOCK  LA    2,1
         BAL   14,GETBITS
         LTR   15,15
         BNZ   INFERR
         ST    5,ISFINAL
         LA    2,2
         BAL   14,GETBITS
         LTR   15,15
         BNZ   INFERR
         C     5,=F'0'
         BE    IFSTORE
         C     5,=F'1'
         BE    IFFIX
         C     5,=F'2'
         BNE   INFERR
         BAL   14,DYNTREE
         LTR   15,15
         BNZ   INFTERR
         LA    11,1
         ST    11,INFMODE
         B     IFLOOP
IFFIX    XC    INFMODE(4),INFMODE
IFLOOP   L     11,INFMODE
         LTR   11,11
         BNZ   IFDYSYM
         BAL   14,FIXSYM
         B     IFGOT
IFDYSYM  LA    2,1
         BAL   14,HUFFSYM
IFGOT    DS    0H
         LTR   15,15
         BNZ   INFERR
         C     5,=F'256'
         BE    IFEND
         C     5,=F'256'
         BL    INFLIT
         C     5,=F'285'
         BH    INFERR
         LR    2,5
         BAL   14,GETLEN
         LTR   15,15
         BNZ   INFERR
         ST    5,RUNLEN
         L     11,INFMODE
         LTR   11,11
         BNZ   IFDYDST
         BAL   14,DISTSYM
         B     IFGOTD
IFDYDST  LA    2,2
         BAL   14,HUFFSYM
IFGOTD   DS    0H
         LTR   15,15
         BNZ   INFERR
         C     5,=F'29'
         BH    INFERR
         LR    2,5
         BAL   14,GETDIST
         LTR   15,15
         BNZ   INFERR
         ST    5,DISTVAL
         BAL   14,COPYRUN
         LTR   15,15
         BNZ   INFERR
         B     IFLOOP
INFLIT   LR    2,5
         BAL   14,PUTBYTE
         LTR   15,15
         BNZ   INFERR
         B     IFLOOP
IFEND    L     7,ISFINAL
         LTR   7,7
         BZ    IFBLOCK
         B     INFDONE
*
* Stored blocks start at the next byte boundary.
* LEN and NLEN are little-endian and must complement.
*
IFSTORE  L     7,BITPOS
         LA    7,7(7)
         N     7,=X'FFFFFFF8'
         ST    7,BITPOS
         LA    2,16
         BAL   14,GETBITS
         LTR   15,15
         BNZ   INFERR
         ST    5,STOLEN
         LA    2,16
         BAL   14,GETBITS
         LTR   15,15
         BNZ   INFERR
         X     5,STOLEN
         C     5,=X'0000FFFF'
         BNE   INFERR
IFSTLP   L     7,STOLEN
         LTR   7,7
         BZ    IFEND
         LA    2,8
         BAL   14,GETBITS
         LTR   15,15
         BNZ   INFERR
         LR    2,5
         BAL   14,PUTBYTE
         LTR   15,15
         BNZ   INFERR
         L     7,STOLEN
         BCTR  7,0
         ST    7,STOLEN
         B     IFSTLP
INFTERR  LA    15,12
         L     14,INFRET
         BR    14
INFDONE  L     7,BITPOS
         LA    7,7(7)
         SRL   7,3
         ST    7,BITUSED
         L     6,OUTLEN
         SR    15,15
         L     14,INFRET
         BR    14
INFERR   LA    15,8
         L     14,INFRET
         BR    14
         LTORG
*
* FIXSYM decodes RFC1951 fixed literal/length symbols.
* Canonical codes are compared after bit reversal.
*
FIXSYM   ST    14,SYMRET
         XC    SYMLEN(4),SYMLEN
         XC    SYMCODE(4),SYMCODE
FXLOOP   LA    2,1
         BAL   14,GETBITS
         LTR   15,15
         BNZ   FXERR
         L     7,SYMCODE
         SLL   7,1
         OR    7,5
         ST    7,SYMCODE
         L     6,SYMLEN
         C     6,=F'6'
         BL    FXNEXT
         C     6,=F'6'
         BNE   FX8
         C     7,=F'0'
         BL    FXNEXT
         C     7,=F'23'
         BH    FXNEXT
         LR    5,7
         A     5,=F'256'
         B     FXOK
FX8      C     6,=F'7'
         BNE   FX9
         C     7,=F'48'
         BL    FX8B
         C     7,=F'191'
         BH    FX8B
         LR    5,7
         S     5,=F'48'
         B     FXOK
FX8B     C     7,=F'192'
         BL    FXNEXT
         C     7,=F'199'
         BH    FXNEXT
         LR    5,7
         S     5,=F'192'
         A     5,=F'280'
         B     FXOK
FX9      C     6,=F'8'
         BNE   FXERR
         C     7,=F'400'
         BL    FXERR
         C     7,=F'511'
         BH    FXERR
         LR    5,7
         S     5,=F'400'
         A     5,=F'144'
         B     FXOK
FXNEXT   LA    6,1(6)
         ST    6,SYMLEN
         C     6,=F'9'
         BL    FXLOOP
FXERR    LA    15,8
         L     14,SYMRET
         BR    14
FXOK     SR    15,15
         L     14,SYMRET
         BR    14
         LTORG
*
* DISTSYM: fixed distance tree has 5-bit codes, bit-reversed on wire.
*
DISTSYM ST    14,SYMRET
         LA    2,5
         BAL   14,GETBITS
         LTR   15,15
         BNZ   DSERR
         LR    6,5
         SR    5,5
         LA    7,5
DSREV    SLL   5,1
         LR    8,6
         N     8,=F'1'
         OR    5,8
         SRL   6,1
         BCT   7,DSREV
         SR    15,15
         L     14,SYMRET
         BR    14
DSERR    LA    15,8
         L     14,SYMRET
         BR    14
         LTORG
*
* DYNTREE builds RFC1951 dynamic code-length, literal, and distance
* canonical tables. HUFFSYM uses count/symbol tables like puff.c.
*
DYNTREE  ST    14,DYNRET
         XC    CLLENS(19),CLLENS
         LA    2,5
         BAL   14,GETBITS
         LTR   15,15
         BNZ   DYNERR
         A     5,=F'257'
         ST    5,NLIT
         C     5,=F'286'
         BH    DYNERR
         LA    2,5
         BAL   14,GETBITS
         LTR   15,15
         BNZ   DYNERR
         A     5,=F'1'
         ST    5,NDIST
         C     5,=F'30'
         BH    DYNERR
         LA    2,4
         BAL   14,GETBITS
         LTR   15,15
         BNZ   DYNERR
         A     5,=F'4'
         ST    5,NCODE
         XC    DYIDX(4),DYIDX
DYCLLP   L     6,DYIDX
         C     6,NCODE
         BNL   DYCLDN
         LA    2,3
         BAL   14,GETBITS
         LTR   15,15
         BNZ   DYNERR
         L     6,DYIDX
         LR    7,6
         SLL   7,1
         LH    8,CLORD(7)
         LA    7,CLLENS
         AR    7,8
         STC   5,0(7)
         LA    6,1(6)
         ST    6,DYIDX
         B     DYCLLP
DYCLDN   LA    2,CLLENS
         LA    3,19
         LA    4,CLCOUNT
         LA    5,CLSYMS
         BAL   14,HUFFBLD
         LTR   15,15
         BNZ   DYNERR
         L     6,NLIT
         A     6,NDIST
         ST    6,NTOTAL
         XC    DYIDX(4),DYIDX
DYLENLP  L     6,DYIDX
         C     6,NTOTAL
         BNL   DYLENDN
         LA    2,0
         BAL   14,HUFFSYM
         LTR   15,15
         BNZ   DYNERR
         L     6,DYIDX
         C     5,=F'15'
         BH    DYREPT
         LA    7,ALLLENS
         AR    7,6
         STC   5,0(7)
         LA    6,1(6)
         ST    6,DYIDX
         B     DYLENLP
DYREPT   C     5,=F'16'
         BNE   DYREP17
         LTR   6,6
         BZ    DYNERR
         LR    7,6
         BCTR  7,0
         LA    8,ALLLENS
         AR    8,7
         XR    9,9
         IC    9,0(8)
         ST    9,PREVLEN
         LA    2,2
         BAL   14,GETBITS
         LTR   15,15
         BNZ   DYNERR
         A     5,=F'3'
         L     9,PREVLEN
         B     DYFILL
DYREP17  C     5,=F'17'
         BNE   DYREP18
         SR    9,9
         LA    2,3
         BAL   14,GETBITS
         LTR   15,15
         BNZ   DYNERR
         A     5,=F'3'
         SR    9,9
         B     DYFILL
DYREP18  C     5,=F'18'
         BNE   DYNERR
         SR    9,9
         LA    2,7
         BAL   14,GETBITS
         LTR   15,15
         BNZ   DYNERR
         A     5,=F'11'
         SR    9,9
DYFILL   L     6,DYIDX
         LR    7,6
         AR    7,5
         C     7,NTOTAL
         BH    DYNERR
DYFLLP   LA    8,ALLLENS
         AR    8,6
         STC   9,0(8)
         LA    6,1(6)
         ST    6,DYIDX
         BCT   5,DYFLLP
         B     DYLENLP
DYLENDN  CLI   ALLLENS+256,X'00'
         BE    DYNERR
         LA    2,ALLLENS
         L     3,NLIT
         LA    4,LLCOUNT
         LA    5,LLSYMS
         BAL   14,HUFFBLD
         LTR   15,15
         BNZ   DYNERR
         LA    2,ALLLENS
         L     6,NLIT
         AR    2,6
         L     3,NDIST
         LA    4,DDCOUNT
         LA    5,DDSYMS
         BAL   14,HUFFBLD
         LTR   15,15
         BNZ   DYNERR
         SR    15,15
         L     14,DYNRET
         BR    14
DYNERR   LA    15,8
         L     14,DYNRET
         BR    14
         LTORG
*
* HUFFBLD: R2 lengths, R3 count, R4 count[0..15], R5 symbols.
* Reject oversubscribed codes. Incomplete sets remain decodable.
*
HUFFBLD  ST    14,BLDRET
         ST    4,HBCPTR
         ST    5,HBSPTR
         MVC   0(64,4),ZERO64
         SR    6,6
HBCLP    CR    6,3
         BNL   HBCDN
         XR    7,7
         IC    7,0(2,6)
         C     7,=F'15'
         BH    HBDERR
         SLL   7,2
         L     8,0(4,7)
         LA    8,1(8)
         ST    8,0(4,7)
         LA    6,1(6)
         B     HBCLP
HBCDN    LA    6,1
         LA    7,1
HBLEFT   SLL   7,1
         LR    8,6
         SLL   8,2
         S     7,0(4,8)
         LTR   7,7
         BM    HBDERR
         LA    6,1(6)
         C     6,=F'15'
         BNH   HBLEFT
         XC    HBOFF(64),HBOFF
         LA    6,1
         SR    7,7
HBOFLP   C     6,=F'15'
         BH    HBSORT
         LR    8,6
         BCTR  8,0
         SLL   8,2
         ST    7,HBOFF(8)
         L     10,HBCPTR
         LR    8,6
         SLL   8,2
         A     7,0(10,8)
         LA    6,1(6)
         B     HBOFLP
HBSORT   SR    6,6
HBSLP    CR    6,3
         BNL   HBDONE
         XR    7,7
         IC    7,0(2,6)
         LTR   7,7
         BZ    HBSNXT
         LR    8,7
         BCTR  8,0
         SLL   8,2
         L     9,HBOFF(8)
         L     10,HBSPTR
         LR    11,9
         SLL   11,1
         STH   6,0(10,11)
         LA    9,1(9)
         ST    9,HBOFF(8)
HBSNXT   LA    6,1(6)
         B     HBSLP
HBDONE   SR    15,15
         L     14,BLDRET
         BR    14
HBDERR   LA    15,8
         L     14,BLDRET
         BR    14
         LTORG
*
* HUFFSYM: R2 selects CL=0, LL=1, DD=2. Returns symbol in R5.
*
HUFFSYM  ST    14,HUFRET
         C     2,=F'0'
         BNE   HSLL
         LA    3,CLCOUNT
         LA    4,CLSYMS
         B     HSINIT
HSLL     C     2,=F'1'
         BNE   HSDD
         LA    3,LLCOUNT
         LA    4,LLSYMS
         B     HSINIT
HSDD     LA    3,DDCOUNT
         LA    4,DDSYMS
HSINIT   ST    3,HCPTR
         ST    4,HSPTR
         XC    HCODE(4),HCODE
         XC    HFIRST(4),HFIRST
         XC    HINDEX(4),HINDEX
         LA    6,1
         ST    6,HLEN
HSLOOP   LA    2,1
         BAL   14,GETBITS
         LTR   15,15
         BNZ   HSERR
         L     7,HCODE
         OR    7,5
         ST    7,HCODE
         L     3,HCPTR
         L     6,HLEN
         LR    8,6
         SLL   8,2
         L     9,0(3,8)
         L     10,HFIRST
         LR    11,7
         SR    11,10
         LTR   11,11
         BM    HSNEXT
         CR    11,9
         BL    HSFOUND
HSNEXT   DS    0H
         L     8,HINDEX
         AR    8,9
         ST    8,HINDEX
         AR    10,9
         SLL   10,1
         ST    10,HFIRST
         SLL   7,1
         ST    7,HCODE
         LA    6,1(6)
         ST    6,HLEN
         C     6,=F'15'
         BNH   HSLOOP
HSERR    LA    15,8
         L     14,HUFRET
         BR    14
HSFOUND  L     8,HINDEX
         AR    8,11
         SLL   8,1
         L     4,HSPTR
         LH    5,0(4,8)
         N     5,=X'0000FFFF'
         SR    15,15
         L     14,HUFRET
         BR    14
         LTORG
*
* GETLEN/GETDIST implement RFC1951 base and extra-bit tables.
*
GETLEN   ST    14,TABRET
         S     2,=F'257'
         C     2,=F'28'
         BH    TABERR
         SLL   2,2
         L     5,LENBASE(2)
         L     6,LENEXT(2)
         LTR   6,6
         BZ    TABOK
         ST    5,TABBASE
         LR    2,6
         BAL   14,GETBITS
         LTR   15,15
         BNZ   TABERR
         A     5,TABBASE
TABOK    SR    15,15
         L     14,TABRET
         BR    14
GETDIST  ST    14,TABRET
         C     2,=F'29'
         BH    TABERR
         SLL   2,2
         L     5,DSTBASE(2)
         L     6,DSTEXT(2)
         LTR   6,6
         BZ    TABOK
         ST    5,TABBASE
         LR    2,6
         BAL   14,GETBITS
         LTR   15,15
         BNZ   TABERR
         A     5,TABBASE
         B     TABOK
TABERR   LA    15,8
         L     14,TABRET
         BR    14
         LTORG
*
* PUTBYTE writes output and mirrors it into the 32 KiB circular window.
*
PUTBYTE  ST    14,PUTRET
         L     6,OUTLEN
         C     6,OUTCAP
         BNL   PUTERR
         L     7,OUTPTR
         AR    7,6
         STC   2,0(7)
         LR    8,6
         N     8,=F'32767'
         L     7,=A(HIST)
         AR    7,8
         STC   2,0(7)
         LA    6,1(6)
         ST    6,OUTLEN
         SR    15,15
         L     14,PUTRET
         BR    14
PUTERR   LA    15,8
         L     14,PUTRET
         BR    14
         LTORG
*
* COPYRUN copies from circular history and permits overlap.
*
COPYRUN  ST    14,COPYRET
         L     6,DISTVAL
         L     7,OUTLEN
         C     6,=F'1'
         BL    COPYERR
         CR    6,7
         BH    COPYERR
         L     9,RUNLEN
COPYLP   L     6,DISTVAL
         L     7,OUTLEN
         SR    7,6
         N     7,=F'32767'
         L     8,=A(HIST)
         AR    8,7
         XR    2,2
         IC    2,0(8)
         BAL   14,PUTBYTE
         LTR   15,15
         BNZ   COPYERR
         BCT   9,COPYLP
         SR    15,15
         L     14,COPYRET
         BR    14
COPYERR  LA    15,8
         L     14,COPYRET
         BR    14
         LTORG
*
* GETBITS reads R2 bits LSB-first.  Value is returned in R5.
*
GETBITS  ST    14,SUBRET
         ST    2,COUNT
         SR    5,5
         SR    6,6
GBLOOP   L     7,BITPOS
         LR    8,7
         SRL   8,3
         C     8,INLEN
         BNL   GBERR
         L     9,INPTR
         AR    9,8
         XR    10,10
         IC    10,0(9)
         N     7,=F'7'
         SRL   10,0(7)
         N     10,=F'1'
         SLL   10,0(6)
         OR    5,10
         L     7,BITPOS
         LA    7,1(7)
         ST    7,BITPOS
         LA    6,1(6)
         C     6,COUNT
         BL    GBLOOP
         SR    15,15
         L     14,SUBRET
         BR    14
GBERR    LA    15,8
         L     14,SUBRET
         BR    14
         LTORG
DATAORG  DS    0D
OKMSG    DC    C'GITINFA: NATIVE 32K WINDOW SELFTEST PASSED'
OKLEN    EQU   *-OKMSG
FIXMSG   DC    C'GITINFA: FIXED HUFFMAN ABC DECODE PASSED'
FIXLEN   EQU   *-FIXMSG
LZMSG    DC    C'GITINFA: FIXED HUFFMAN LZ77 DECODE PASSED'
LZLEN    EQU   *-LZMSG
DYNMSG   DC    C'GITINFA: DYNAMIC HUFFMAN DECODE PASSED'
DYNLENM  EQU   *-DYNMSG
HMSG     DC    C'GITINFA: 32K WINDOW SELFTEST FAILED'
HMSGLEN  EQU   *-HMSG
FMSG     DC    C'GITINFA: FIXED HUFFMAN ABC DECODE FAILED'
FMSGLEN  EQU   *-FMSG
LMSG     DC    C'GITINFA: FIXED HUFFMAN LZ77 DECODE FAILED'
LMSGLEN  EQU   *-LMSG
DMSG     DC    C'GITINFA: DYNAMIC HUFFMAN DECODE FAILED'
DMSGLEN  EQU   *-DMSG
TMSG     DC    C'GITINFA: DYNAMIC TREE CONSTRUCTION FAILED'
TMSGLEN  EQU   *-TMSG
EMSG     DC    C'GITINFA: DYNAMIC SYMBOL DECODE FAILED'
EMSGLEN  EQU   *-EMSG
SMSG     DC    C'GITINFA: DYNAMIC OUTPUT LENGTH MISMATCH'
SMSGLEN  EQU   *-SMSG
PMSG     DC    C'GITINFA: DYNAMIC OUTPUT PREFIX MISMATCH'
PMSGLEN  EQU   *-PMSG
STMSG    DC    C'GITINFA: STORED BLOCK DECODE PASSED'
STMLEN   EQU   *-STMSG
MBMSG    DC    C'GITINFA: MIXED MULTIBLOCK DECODE PASSED'
MBMLEN   EQU   *-MBMSG
STERR    DC    C'GITINFA: STORED BLOCK DECODE FAILED'
STERLEN  EQU   *-STERR
MBERR    DC    C'GITINFA: MIXED MULTIBLOCK DECODE FAILED'
MBERLEN  EQU   *-MBERR
ZMSG     DC    C'GITINFA: ZLIB HEADER AND ADLER32 PASSED'
ZMLEN    EQU   *-ZMSG
ZERR     DC    C'GITINFA: ZLIB HEADER OR ADLER32 FAILED'
ZERLEN   EQU   *-ZERR
NEGMSG   DC    C'GITINFA: MALFORMED STREAM TESTS PASSED'
NEGLEN   EQU   *-NEGMSG
NEGERR   DC    C'GITINFA: MALFORMED STREAM TESTS FAILED'
NERLEN   EQU   *-NEGERR
         DS    0F
