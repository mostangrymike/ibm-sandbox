ZTRAIL   DC    X'789C4B4C4A0600024D0127AABBCC'
ZPAIR    DC    X'789C4B4C4A0600024D0127789C4B4C4A0600024D0127'
ZBADTL   DC    X'789C4B4C4A0600024D0126AABBCC'
ZDYTEST  DC    X'78DAEDCA571180301445412B57016A628092D0792110'
