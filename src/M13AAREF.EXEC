/* M13AA: native PACK walker with REF_DELTA base by object ID. */
/* Git blob SHA-1 for abc is f2ba8f84ab5c1bce84a7b441cb1959cfc7093b7f. */
address command
'EXEC GITPBUF INIT'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 5041434B000000020000000233789C4B4C4A0600024D0127'
if rc \= 0 then exit rc
/* REF_DELTA type 7, six-byte delta, base object ID. */
'EXEC GITPBUF APPEND 76F2BA8F84AB5C1BCE84A7B441CB1959CFC7093B7F'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 7801010600F9FF03049003016402DB0100'
if rc \= 0 then exit rc
/* Placeholder PACK trailer; isolated walker does not verify SHA-1. */
'EXEC GITPBUF APPEND 0000000000000000000000000000000000000000'
if rc \= 0 then exit rc
'EXEC GITPBUF FINAL'
if rc \= 0 then exit rc
'EXEC GITPNWLK WALK QUIET NATIVE'
if rc \= 0 then do
 say 'M13AA: native REF delta PACK walk failed'
 exit rc
end
'EXEC GITOBUF READSTACK 0 4'
if rc \= 0 | queued() < 1 then exit 8
parse pull h
if h \= '61626364' then do
 say 'M13AA: reconstructed REF delta mismatch' h
 exit 8
end
say 'M13AA NATIVE REF DELTA PACK WALK PASSED'
exit 0
