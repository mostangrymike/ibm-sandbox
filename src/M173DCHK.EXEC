/* M173: safe one-line MAINT directory delta checker. */
/* Read-only: never display directory source or passwords. */
address cms
parse upper arg extra
if strip(extra)\='' then do
 say 'Usage: M173DCHK'
 exit 4
end
'STATE USER DIRECT C'
if rc\=0 then do
 say 'M173 DIR ORIGINAL MISSING'
 exit 8
end
'STATE M173BAK DIRECT C'
if rc\=0 then do
 say 'M173 DIR BACKUP MISSING'
 exit 8
end
'STATE M173NEW DIRECT C'
if rc\=0 then do
 say 'M173 DIR CANDIDATE MISSING'
 exit 8
end
drop u. b. n.
'EXECIO * DISKR USER DIRECT C 1 (STEM U. FINIS'
if rc\=0 then do
 say 'M173 DIR ORIGINAL READ FAIL'
 exit 8
end
'EXECIO * DISKR M173BAK DIRECT C 1 (STEM B. FINIS'
if rc\=0 then do
 say 'M173 DIR BACKUP READ FAIL'
 exit 8
end
'EXECIO * DISKR M173NEW DIRECT C 1 (STEM N. FINIS'
if rc\=0 then do
 say 'M173 DIR CANDIDATE READ FAIL'
 exit 8
end
if u.0\=4282 | b.0\=u.0 | n.0\=u.0+1 then do
 say 'M173 DIR RECORD COUNT FAIL'
 exit 8
end
/* Verify preserved source and backup record by record. */
heads=0
do i=1 to u.0
 if u.i\==b.i then do
  say 'M173 DIR BACKUP CONTENT MISMATCH'
  exit 8
 end
 if translate(word(u.i,1))='USER' &,
    translate(word(u.i,2))='MAINT' then heads=heads+1
end
/* Locate the exact approved line anywhere; never print content. */
expected='MDISK 0600 3390 6000 1600 VMCOM1 W'
matches=0
prefix=0
prefixat=0
added=0
do i=1 to n.0
 if translate(strip(n.i))=expected then do
  matches=matches+1
  added=i
 end
 if translate(word(n.i,1))='MDISK' &,
    translate(word(n.i,2))='0600' then do
  prefix=prefix+1
  prefixat=i
 end
end
if matches\=1 then do
 say 'M173 DIR APPROVED LINE COUNT' matches
 say 'M173 DIR MDISK 0600 PREFIX COUNT' prefix
 if prefix=1 then do
  say 'M173 DIR 0600 RECORD NUMBER' prefixat
  say 'M173 DIR 0600 FIELD COUNT' words(n.prefixat)
  do w=1 to 7
   flag='DIFF'
   if translate(word(n.prefixat,w))=word(expected,w) then do
    flag='MATCH'
   end
   say 'M173 DIR 0600 FIELD' w flag
  end
  spacing='NO'
  if space(translate(strip(n.prefixat)),1)=expected then do
   spacing='YES'
  end
  say 'M173 DIR 0600 SPACING ONLY' spacing
  norm=translate(word(n.prefixat,1))
  do w=2 to 7
   norm=norm||' '||translate(word(n.prefixat,w))
  end
  rebuilt='NO'
  if norm=expected then rebuilt='YES'
  say 'M173 DIR REBUILT WORDS MATCH' rebuilt
  say 'M173 DIR STRIPPED LENGTH' length(strip(n.prefixat))
  say 'M173 DIR EXPECTED LENGTH' length(expected)
  prev=prefixat-1
  head='NO'
  if prev>=1 then do
   if translate(word(u.prev,1))='USER' &,
      translate(word(u.prev,2))='MAINT' then head='YES'
  end
  say 'M173 DIR PRECEDING SOURCE MAINT' head
  sect='NONE'
  sectat=0
  owner='NO'
  do si=1 to prev
   t=translate(word(u.si,1))
   if t='USER' | t='IDENTITY' | t='SUBCONFIG' then do
    sect=t
    sectat=si
    owner='NO'
    if t='USER' & translate(word(u.si,2))='MAINT' then,
       owner='YES'
   end
  end
  say 'M173 DIR ENCLOSING SECTION' sect
  say 'M173 DIR ENCLOSING HEADER RECORD' sectat
  say 'M173 DIR ENCLOSING USER MAINT' owner
  other=0
  first=0
  do ix=1 to u.0
   j=ix
   if ix>=prefixat then j=ix+1
   if u.ix\==n.j then do
    other=other+1
    if first=0 then first=ix
   end
  end
  say 'M173 DIR OUTSIDE INSERT DIFFERENCES' other
  if other>0 then say 'M173 DIR FIRST OUTSIDE CHANGE' first
 end
 say 'M173 DIR INSERTED RECORD INVALID'
 exit 8
end
if added<2 then do
 say 'M173 DIR INSERT POSITION INVALID'
 exit 8
end
before=added-1
if translate(word(u.before,1))\='USER' |,
   translate(word(u.before,2))\='MAINT' then do
 say 'M173 DIR INSERT NOT AFTER MAINT HEADER'
 exit 8
end
/* Verify every original record equals shifted candidate record. */
do i=1 to u.0
 j=i
 if i>=added then j=i+1
 if u.i\==n.j then do
  say 'M173 DIR OTHER CHANGE AT RECORD' i
  say 'M173 DIR CANDIDATE EXTRA CHANGE'
  exit 8
 end
end
if heads<1 then do
 say 'M173 DIR MAINT HEADER MISSING'
 exit 8
end
say 'M173 DIR ORIGINAL/BACKUP VERIFIED' u.0
say 'M173 DIR MAINT INSERT VERIFIED 1'
say 'M173 DIR DELTA CHECK PASS'
exit 0
