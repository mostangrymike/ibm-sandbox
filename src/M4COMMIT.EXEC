/* M4 public deterministic commit creation regression */
address command

tree = '2030C0B68CCC4116B0CB9990EF04B53EA30140C8'
want = '54BACE2202BB0C96980CDD0AAE9A752E6188D666'

say 'M4 COMMIT TEST 1: create deterministic commit through GIT command'
'EXEC GIT COMMIT-TREE' tree
if rc \= 0 then do
   say 'M4COMMIT: COMMIT-TREE failed RC=' rc
   exit rc
end

say 'M4 COMMIT TEST 2: verify independently known commit OID'
'EXEC GIT VERIFY-OBJECT' want
if rc \= 0 then do
   say 'M4COMMIT: commit verification failed RC=' rc
   exit rc
end

say 'M4 COMMIT TEST 3: cat newly written commit'
'EXEC GIT CAT-OBJECT' want
if rc \= 0 then do
   say 'M4COMMIT: commit cat failed RC=' rc
   exit rc
end

say 'M4 PUBLIC COMMIT CREATION TESTS PASSED'
exit 0
