/* M3E streaming SHA-1 regression driver */

address command

say 'M3E STACK/LINERD DIAGNOSTIC'
'MAKEBUF'
queue '0000000A'
queue '626C6F62203300616263'
say 'QUEUED=' queued()
pull a
pull b
say 'FIRST=' a 'LEN=' length(a)
say 'SECOND=' b 'LEN=' length(b)
queue a
queue b
say 'REQUEUED=' queued()
'GITRD'
rdrc = rc
say 'GITRD RC=' rdrc
'DROPBUF'
if rdrc \= 0 then exit rdrc

say 'M3E HEADER PARSER DIAGNOSTIC'
'MAKEBUF'
queue '0000000A'
'GITHDR'
hdrc = rc
say 'GITHDR RC=' hdrc
'DROPBUF'
if hdrc \= 0 then exit hdrc

say 'M3E TEST 1: Git blob abc'
'MAKEBUF'
queue '0000000A'
queue '626C6F62203300616263'
'GITSTRM'
strmrc = rc
say 'GITSTRM RC=' strmrc
if strmrc \= 0 then do
   'DROPBUF'
   exit strmrc
end
pull oid
'DROPBUF'
say 'OID=' oid
if oid \= 'F2BA8F84AB5C1BCE84A7B441CB1959CFC7093B7F' then exit 8

say 'M3E TEST 2: Git blob of 300 ASCII a bytes'
'MAKEBUF'
queue '00000135'
queue '626C6F62203330300061616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161'
queue '61616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161'
queue '61616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161'
queue '61616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161'
queue '6161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161'
'GITSTRM'
if rc \= 0 then do
   'DROPBUF'
   exit rc
end
pull oid
'DROPBUF'
say oid
if oid \= '8EF7A53A7502434FF1BBB9502F5C7A6E66C78BDD' then exit 8

say 'M3E SHA-1 PADDING/CHUNK BOUNDARIES'
call streamtest 55,  'C1C8BBDC22796E28C0E15163D20899B65621D65A'
if result \= 0 then exit result
call streamtest 56,  'C2DB330F6083854C99D4B5BFB6E8F29F201BE699'
if result \= 0 then exit result
call streamtest 63,  '03F09F5B158A7A8CDAD920BDDC29B81C18A551F5'
if result \= 0 then exit result
call streamtest 64,  '0098BA824B5C16427BD7A1122A5A442A25EC644D'
if result \= 0 then exit result
call streamtest 128, 'AD5B3FDBCB526778C2839D2F151EA753995E26A0'
if result \= 0 then exit result

say 'M3E STREAMING SHA-1 TESTS PASSED'
exit 0

streamtest: procedure
parse arg n, expected
hex = copies('61',n)
header = right(d2x(n),8,'0')
'MAKEBUF'
queue header
do while length(hex) > 128
   queue left(hex,128)
   hex = substr(hex,129)
end
if length(hex) > 0 then queue hex
'GITSTRM'
strc = rc
if strc \= 0 then do
   'DROPBUF'
   say 'BOUNDARY' n 'GITSTRM RC=' strc
   return strc
end
pull got
'DROPBUF'
say 'BOUNDARY' n 'OID=' got
if got \= expected then do
   say 'BOUNDARY' n 'EXPECTED=' expected
   return 8
end
return 0
