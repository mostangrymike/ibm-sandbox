/* M13Y: two adjacent blob objects through native PACK walker. */
/* Each blob is 'abc', encoded as 33 + 11-byte zlib member. */
address command
'EXEC GITPBUF INIT'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 5041434B000000020000000233789C4B4C4A0600024D0127'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 33789C4B4C4A0600024D0127'
if rc \= 0 then exit rc
/* Placeholder trailer: isolated walker does not check PACK SHA-1. */
'EXEC GITPBUF APPEND 0000000000000000000000000000000000000000'
if rc \= 0 then exit rc
'EXEC GITPBUF FINAL'
if rc \= 0 then exit rc
'EXEC GITPNWLK WALK QUIET NATIVE'
if rc \= 0 then do
 say 'M13Y: native two-object PACK walk failed'
 exit rc
end
'EXEC GITOBUF READSTACK 0 3'
if rc \= 0 | queued() < 1 then exit 8
parse pull h
if h \= '616263' then do
 say 'M13Y: wrong final blob content' h
 exit 8
end
say 'M13Y NATIVE TWO-OBJECT PACK WALK PASSED'
exit 0
