/* M166: safe modern REF2 compare-and-swap updater. */
address cms
parse arg ref newoid oldoid extra

zeros='0000000000000000000000000000000000000000'
if ref='' | newoid='' | oldoid='' | extra\='' then do
 say 'Usage: GITUPD refs/heads/name new-oid expected-old-oid'
 exit 4
end
if left(ref,11)\='refs/heads/' then do
 say 'GITUPD: ref must name refs/heads/<branch>'
 exit 4
end
call validref ref
if result\='OK' then exit 4

newoid=translate(newoid)
oldoid=translate(oldoid)
if length(newoid)\=40 |,
   verify(newoid,'0123456789ABCDEF')\=0 then do
 say 'GITUPD: invalid new object-id' newoid
 exit 4
end
if length(oldoid)\=40 |,
   verify(oldoid,'0123456789ABCDEF')\=0 then do
 say 'GITUPD: invalid expected old object-id' oldoid
 exit 4
end
if newoid=zeros & oldoid=zeros then do
 say 'GITUPD: zero-to-zero update is invalid'
 exit 4
end

if newoid\=zeros then do
 call requirecommit newoid
 if result\='OK' then exit 8
end

call readrefs
if result\='OK' then exit 8
drop bak.
bak.0=rr.0
do bi=1 to rr.0
 bak.bi=rr.bi
end
found=0
slot=0
current=''
do i=1 to refcount
 if refname.i=ref then do
  found=found+1
  slot=i
  current=refoid.i
 end
end
if found>1 then do
 say 'GITUPD: duplicate ref records' ref
 exit 8
end

if oldoid=zeros then do
 if found\=0 then do
  say 'GITUPD: stale ref' ref
  say 'EXPECTED' zeros
  say 'ACTUAL' current
  exit 8
 end
 if newoid=zeros then exit 4
 refcount=refcount+1
 slot=refcount
 refname.slot=ref
 refoid.slot=newoid
end
else do
 if found\=1 | current\=oldoid then do
  say 'GITUPD: stale ref' ref
  say 'EXPECTED' oldoid
  if found=1 then say 'ACTUAL' current
  else say 'ACTUAL' zeros
  exit 8
 end
 if newoid=zeros then do
  if ref=headref then do
   say 'GITUPD: refusing to delete symbolic HEAD target'
   exit 8
  end
  do i=slot to refcount-1
   ni=i+1
   refname.i=refname.ni
   refoid.i=refoid.ni
  end
  drop refname.refcount refoid.refcount
  refcount=refcount-1
 end
 else refoid.slot=newoid
end

call writerefs
if result\='OK' then do
 call restore
 exit 8
end
call readrefs
if result\='OK' then do
 call restore
 exit 8
end
found=0
current=''
do i=1 to refcount
 if refname.i=ref then do
  found=found+1
  current=refoid.i
 end
end
if newoid=zeros then do
 if found\=0 then do
  say 'GITUPD: delete verification failed' ref
  call restore
  exit 8
 end
 say 'DELETED' ref oldoid
end
else do
 if found\=1 | current\=newoid then do
  say 'GITUPD: update verification failed' ref
  call restore
  exit 8
 end
 say newoid ref
end
exit 0

validref:
 parse arg vr
 if left(vr,11)\='refs/heads/' then return 'ERROR'
 name=substr(vr,12)
 if name='' | name='.' | name='..' | pos(' ',name)>0 |,
    pos('..',name)>0 | pos('~',name)>0 | pos('^',name)>0 |,
    pos(':',name)>0 | pos('?',name)>0 | pos('*',name)>0 |,
    pos('[',name)>0 | right(name,1)='.' then do
  say 'GITUPD: invalid branch name' name
  return 'ERROR'
 end
 return 'OK'

requirecommit:
 parse arg oid
 address command 'EXEC GIT VERIFY-OBJECT' oid
 if rc\=0 then do
  say 'GITUPD: target object failed verification' oid
  return 'ERROR'
 end
 fn=substr(oid,1,8)
 drop obj.
 'EXECIO * DISKR' fn 'GITOBJ A 1 (STEM OBJ. FINIS'
 if rc\=0 then return 'ERROR'
 if obj.0<2 | word(obj.1,1)\='OID' | word(obj.1,2)\=oid |,
    word(obj.2,1)\='TYPE' then return 'ERROR'
 if word(obj.2,2)\='COMMIT' then do
  say 'GITUPD: branch target is not a COMMIT object' oid
  return 'ERROR'
 end
 return 'OK'

readrefs:
 drop refname. refoid. rr.
 refcount=0
 headref=''
 headcount=0
 'STATE GITREF2 REPO A'
 if rc\=0 then do
  say 'GITUPD: REF2 database not found'
  return 'ERROR'
 end
 'EXECIO * DISKR GITREF2 REPO A 1 (STEM RR. FINIS'
 if rc\=0 | rr.0<2 | rr.1\='REF2 1' then do
  say 'GITUPD: invalid REF2 header'
  return 'ERROR'
 end
 do ri=2 to rr.0
  line=rr.ri
  tag=word(line,1)
  if tag='HEAD' then do
   if words(line)\=2 | headcount\=0 then return 'ERROR'
   headref=word(line,2)
   call validref headref
   if result\='OK' then return 'ERROR'
   headcount=1
  end
  else if tag='REF' then do
   if words(line)\=3 then return 'ERROR'
   rname=word(line,2)
   roid=translate(word(line,3))
   call validref rname
   if result\='OK' then return 'ERROR'
   if length(roid)\=40 |,
      verify(roid,'0123456789ABCDEF')\=0 then return 'ERROR'
   do rj=1 to refcount
    if refname.rj=rname then do
     say 'GITUPD: duplicate ref records' rname
     return 'ERROR'
    end
   end
   refcount=refcount+1
   refname.refcount=rname
   refoid.refcount=roid
  end
  else return 'ERROR'
 end
 if headcount\=1 then return 'ERROR'
 foundhead=0
 do ri=1 to refcount
  if refname.ri=headref then foundhead=foundhead+1
 end
 if foundhead\=1 then do
  say 'GITUPD: symbolic HEAD target is missing'
  return 'ERROR'
 end
 return 'OK'

restore:
 if bak.0<2 then return 'ERROR'
 'EXECIO' bak.0 'DISKW GITREF2 REPO A 1 (STEM BAK. FINIS'
 if rc\=0 then do
  say 'GITUPD: REF2 rollback failed'
  return 'ERROR'
 end
 say 'GITUPD: REF2 rollback restored prior snapshot'
 return 'OK'

writerefs:
 drop wr.
 wr.1='REF2 1'
 wr.2='HEAD' headref
 wn=2
 do wi=1 to refcount
  wn=wn+1
  wr.wn='REF' refname.wi refoid.wi
 end
 wr.0=wn
 'ERASE GITREF2 REPO A'
 if rc\=0 then do
  say 'GITUPD: cannot replace REF2 database'
  return 'ERROR'
 end
 'EXECIO' wr.0 'DISKW GITREF2 REPO A 1 (STEM WR. FINIS'
 if rc\=0 then do
  say 'GITUPD: cannot write REF2 database'
  return 'ERROR'
 end
 return 'OK'
