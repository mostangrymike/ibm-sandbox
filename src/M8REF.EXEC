/* M8C whole-PACK REF_DELTA regression. */
address command
baseoid = 'F2BA8F84AB5C1BCE84A7B441CB1959CFC7093B7F'
pack = '5041434B0000000200000002'
pack = pack || '33789C4B4C4A0600024D0127'
pack = pack || '76' || baseoid
pack = pack || '789C636699C0CC98020002DB0100'
pack = pack || '7C95D709D4D46C612315060323DF0B5671650684'

say 'M8 REF TEST 1: whole PACK reconstructs REF_DELTA abcd'
'EXEC GITPWALK WALK' pack
if rc \= 0 then exit rc

say 'M8 REF TEST 2: base context is abc at position 12'
'EXEC GITPCTX GET 12'
if rc \= 0 then exit rc

say 'M8 REF TEST 3: delta context is reconstructed abcd at position 24'
'EXEC GITPCTX GET 24'
if rc \= 0 then exit rc

say 'M8 REF TEST 4: unknown REF base object id is rejected'
badid = '02BA8F84AB5C1BCE84A7B441CB1959CFC7093B7F'
bad = substr(pack,1,50) || badid || substr(pack,91)
'EXEC GITPWALK WALK' bad
if rc = 0 then do
   say 'M8REF: unknown REF base unexpectedly succeeded'
   exit 8
end
say 'EXPECTED FAILURE RC=' rc

say 'M8 WHOLE-PACK REF_DELTA TESTS PASSED'
exit 0
