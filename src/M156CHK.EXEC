/* M156: compact sealed-fixture gate for closed presence duration. */
address cms
parse arg extra
if extra\='' then do
 say 'Usage: M156CHK'
 exit 4
end

lvl.0=0
'PIPE CMS GIT LEVEL | STEM lvl.'
lrc=rc
if lrc\=0 then do
 say 'M156 LEVEL FAIL RC' lrc
 exit lrc
end
if lvl.0\=2 then exit 8
parse var lvl.1 g1 e1 l1 gv
parse var lvl.2 g2 e2 l2 vv
if g1\='GIT' | e1\='EXEC' | l1\='LEVEL' then exit 8
if g2\='GITVREF' | e2\='EXEC' | l2\='LEVEL' then exit 8
if left(gv,1)\='M' | left(vv,1)\='M' then exit 8
gn=substr(gv,2)
vn=substr(vv,2)
if datatype(gn,'W')\=1 | datatype(vn,'W')\=1 then exit 8
if gn\=vn | gn<156 then exit 8
say 'M156 LEVEL PASS' gv'/'vv
drop sig.
sig.0=0
'PIPE CMS EXEC GITVREF STAMP | STEM sig.'
src=rc
if src\=0 | sig.0\=1 | sig.1\='GITVREF INTERNAL STAMP P2' then do
 say 'M156 GITVREF STAMP FAIL'
 exit 8
end
say 'M156 GITVREF STAMP PASS P2'
spec='486ADAA5B02080720F4B329C6F68550B13C6AA87'
path='src/GITPBWALK.EXEC'
cmd='GIT HISTORYFIRSTPRESENCEDURATION-REF-FULL' spec 5 path
drop out.
out.0=0
'PIPE CMS' cmd '| STEM out.'
grc=rc
if grc\=0 then do
 say 'M156 DURATION FAIL RC' grc
 exit grc
end
mark=0
sumok=0
proof=0
dend=0
seenS=''
seenR=''
do i=1 to out.0
 line=space(out.i)
 if line='HISTORYFIRSTPRESENCEDURATION FULL SNAPSHOTS VERIFIED' then mark=1
 if pos('HFPD P2 S ',line)=1 then do
  seenS=line
  if line='HFPD P2 S 3 1 1 1 0 3 4 2' then sumok=1
 end
 if pos('HFPD P2 R ',line)=1 then do
  seenR=line
  if line='HFPD P2 R 2 PRESENT 5 ADDED 1 DELETED 50 50' then proof=1
 end
 if line='HISTORYFIRSTPRESENCEDURATION DATA END' then dend=1
end
if mark+sumok+proof+dend\=4 then do
 say 'M156 DURATION FAIL PROOF' mark sumok proof dend
 if seenS\='' then say seenS
 if seenR\='' then say seenR
 exit 8
end
say 'M156 DURATION PASS RUN 2 PRESENT 50/50'
say 'M156 COMPACT TARGET GATE PASS'
exit 0
