/* M156: compact sealed-fixture gate for closed presence duration. */
address cms
parse arg extra
if extra\='' then do
 say 'Usage: M156CHK'
 exit 4
end

lvl.0=0
'PIPE CMS GIT LEVEL | STEM lvl.'
lrc=rc
if lrc\=0 then do
 say 'M156 LEVEL FAIL RC' lrc
 exit lrc
end
if lvl.0\=2 then do
 say 'M156 LEVEL FAIL COUNT'
 exit 8
end
if lvl.1\='GIT EXEC LEVEL M156' then exit 8
if lvl.2\='GITVREF EXEC LEVEL M156' then exit 8
say 'M156 LEVEL PASS M156/M156'

spec='486ADAA5B02080720F4B329C6F68550B13C6AA87'
path='src/GITPBWALK.EXEC'
cmd='GIT HISTORYFIRSTPRESENCEDURATION-REF-FULL' spec 5 path
drop out.
out.0=0
'PIPE CMS' cmd '| STEM out.'
grc=rc
if grc\=0 then do
 say 'M156 DURATION FAIL RC' grc
 exit grc
end
mark=0
mixed=0
changed=0
runs=0
closed=0
apos=0
azero=0
aneg=0
cpos=0
czero=0
cneg=0
state=0
begin=0
finish=0
asec=0
csec=0
dend=0
do i=1 to out.0
 if out.i='HISTORYFIRSTPRESENCEDURATION FULL SNAPSHOTS VERIFIED' then mark=1
 if out.i='HISTORYFIRSTPRESENCEDURATION PATH STATUS MIXED' then mixed=1
 if out.i='HISTORYFIRSTPRESENCEDURATION EXISTENCE STATUS CHANGED' then changed=1
 if out.i='HISTORYFIRSTPRESENCEDURATION PRESENCE RUNS 3' then runs=1
 if out.i='HISTORYFIRSTPRESENCEDURATION CLOSED RUNS 1' then closed=1
 if out.i='HISTORYFIRSTPRESENCEDURATION AUTHOR POSITIVE CLOSED 1' then apos=1
 if out.i='HISTORYFIRSTPRESENCEDURATION AUTHOR ZERO CLOSED 0' then azero=1
 if out.i='HISTORYFIRSTPRESENCEDURATION AUTHOR NEGATIVE CLOSED 0' then aneg=1
 if out.i='HISTORYFIRSTPRESENCEDURATION COMMITTER POSITIVE CLOSED 1' then cpos=1
 if out.i='HISTORYFIRSTPRESENCEDURATION COMMITTER ZERO CLOSED 0' then czero=1
 if out.i='HISTORYFIRSTPRESENCEDURATION COMMITTER NEGATIVE CLOSED 0' then cneg=1
 if out.i='HISTORYFIRSTPRESENCEDURATION RUN 2 STATE PRESENT' then state=1
 if out.i='HISTORYFIRSTPRESENCEDURATION RUN 2 BEGIN EDGE 5 STATUS ADDED' then,
  begin=1
 if out.i='HISTORYFIRSTPRESENCEDURATION RUN 2 END EDGE 1 STATUS DELETED' then,
  finish=1
 if out.i='HISTORYFIRSTPRESENCEDURATION RUN 2 AUTHOR SECONDS 50' then asec=1
 if out.i='HISTORYFIRSTPRESENCEDURATION RUN 2 COMMITTER SECONDS 50' then csec=1
 if out.i='HISTORYFIRSTPRESENCEDURATION DATA END' then dend=1
end
sum=mark+mixed+changed+runs+closed+apos+azero+aneg
sum=sum+cpos+czero+cneg+state+begin+finish+asec+csec+dend
if sum\=17 then do
 say 'M156 DURATION FAIL SUMMARY' sum
 exit 8
end
say 'M156 DURATION PASS RUN 2 PRESENT 50/50'
say 'M156 COMPACT TARGET GATE PASS'
exit 0
