/* M4 chunked CMS object database regression */
address command

tree = '2030C0B68CCC4116B0CB9990EF04B53EA30140C8'
commit = '54BACE2202BB0C96980CDD0AAE9A752E6188D666'
big = 'F96567C0F557CCE820219AE6483F2171A106810B'

say 'M4 DB TEST 1: old three-record tree remains readable'
'EXEC GIT VERIFY-OBJECT' tree
if rc \= 0 then exit rc

say 'M4 DB TEST 2: old three-record commit remains readable'
'EXEC GIT VERIFY-OBJECT' commit
if rc \= 0 then exit rc

say 'M4 DB TEST 3: create 303-byte canonical CMS text payload'
drop t.
t.0 = 4
do i = 1 to 4
   t.i = copies('a',75)
end
'EXECIO 4 DISKW BIG TXT A 1 (STEM T. FINIS'
if rc \= 0 then do
   say 'M4DB: cannot create BIG TXT A RC=' rc
   exit rc
end

say 'M4 DB TEST 4: write payload through public GIT command'
'EXEC GIT WRITE-OBJECT BIG TXT A'
if rc \= 0 then exit rc

say 'M4 DB TEST 5: verify independently known large blob OID'
'EXEC GIT VERIFY-OBJECT' big
if rc \= 0 then exit rc

say 'M4 DB TEST 6: inspect bounded physical DATA records'
drop o.
'EXECIO * DISKR F96567C0 GITOBJ A 1 (STEM O. FINIS'
if rc \= 0 then exit rc
if o.0 \= 8 then do
   say 'M4DB: expected 8 object records, got' o.0
   exit 8
end
if o.3 \= 'SIZE 303' then do
   say 'M4DB: expected SIZE 303, got' o.3
   exit 8
end
do i = 4 to o.0
   if word(o.i,1) \= 'DATA' then do
      say 'M4DB: record' i 'is not DATA'
      exit 8
   end
   if length(word(o.i,2)) > 128 then do
      say 'M4DB: DATA record' i 'exceeds 128 hex digits'
      exit 8
   end
end
say 'OBJECT RECORDS=' o.0 'SIZE=303 DATA RECORDS=5'
say 'M4 CHUNKED OBJECT DATABASE TESTS PASSED'
exit 0
