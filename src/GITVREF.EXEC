/* M82: read-only REF2 verified path edge changes. */
address cms
parse arg command spec depth extra
command=translate(command)
if command\='RESOLVE' & command\='SHOW' & command\='LOG' &,
   command\='DAG' & command\='READ' & command\='DIR' &,
   command\='HISTPATH' & command\='HISTCHG' then do
 say 'Usage: GITVREF command ref [depth] [path]'
 exit 4
end
if spec='' then exit 4
if command='HISTPATH' | command='HISTCHG' then do
 if depth='' | extra='' then exit 4
end
else if extra\='' then exit 4
if command='LOG' | command='DAG' | command='HISTPATH' |,
   command='HISTCHG' then do
 if depth='' | length(depth)>2 | verify(depth,'0123456789')\=0 then exit 4
 if command='LOG' & depth+0>16 then exit 4
 if command='DAG' & depth+0>8 then exit 4
 if command='HISTPATH' & depth+0>8 then exit 4
 if command='HISTCHG' & depth+0>8 then exit 4
 if command='HISTPATH' | command='HISTCHG' then do
  call pathasciihex extra
  if result='ERROR' then exit 4
  pathhex=result
 end
end
else if command='READ' | command='DIR' then do
 if depth='' then exit 4
 call pathasciihex depth
 if result='ERROR' then exit 4
 pathhex=result
end
else if depth\='' then exit 4
call readrefs
if result\='OK' then exit 8
call resolve spec
if result='ERROR' then exit 8
oid=result
call bindnative
if result\='OK' then exit 8
if command='LOG' then do
 cmd='GITREC LOGFULL GITFIX M15NEW' oid depth
 marker='LOG FULL SNAPSHOTS VERIFIED'
end
else if command='DAG' then do
 cmd='GITREC LOGDAGFULL GITFIX M15NEW' oid depth
 marker='LOGDAG FULL SNAPSHOTS VERIFIED'
end
else if command='HISTPATH' | command='HISTCHG' then do
 cmd='GITREC HISTORYDAGPATH GITFIX M15NEW' oid depth pathhex
 marker='HISTORYDAGPATH FULL SNAPSHOTS VERIFIED'
end
else if command='READ' then do
 cmd='GITREC PATHFULLCAT GITFIX M15NEW' oid pathhex
 marker='COMMIT ROOT FULL CLOSURE VERIFIED'
end
else if command='DIR' then do
 cmd='GITREC PATHFULLDIR GITFIX M15NEW' oid pathhex
 marker='COMMIT ROOT FULL CLOSURE VERIFIED'
end
else do
 cmd='GITREC SHOWFULL GITFIX M15NEW' oid
 marker='SHOW FULL ROOT CLOSURE VERIFIED'
end
out.0=0
'PIPE CMS' cmd '| STEM out.'
if rc\=0 then exit rc
ok=0
do i=1 to out.0
 if pos(marker,out.i)>0 then ok=1
end
if \ok then exit 8
if command='HISTCHG' then do
 call changecheck
 if result\='OK' then exit 8
 drop depthtext.
 members=0
 do vi=1 to distinct
  call depthlist vi
  if result='ERROR' then exit 8
  depthtext.vi=result
  members=members+freq.vi
  do ci=1 to freq.vi
   if length(vcommit.vi.ci)\=40 then exit 8
   if verify(vcommit.vi.ci,'0123456789ABCDEF')\=0 then exit 8
   if length(vtree.vi.ci)\=40 then exit 8
   if verify(vtree.vi.ci,'0123456789ABCDEF')\=0 then exit 8
   if datatype(vnode.vi.ci,'W')\=1 then exit 8
   if vnode.vi.ci<1 | vnode.vi.ci>64 then exit 8
   if datatype(vdepth.vi.ci,'W')\=1 then exit 8
   if vdepth.vi.ci<0 | vdepth.vi.ci>8 then exit 8
  end
 end
 if members\=nodes then exit 8
 say 'VERIFIED REF' spec oid
 say 'HISTORYCHANGES FULL SNAPSHOTS VERIFIED'
 say 'HISTORYCHANGES DATA BEGIN'
 do i=1 to out.0
  if left(out.i,20)='HISTORYDAGPATH NODE ' |,
     left(out.i,22)='HISTORYDAGPATH COMMIT ' |,
     left(out.i,25)='HISTORYDAGPATH PATH TYPE ' |,
     left(out.i,23)='HISTORYDAGPATH PATHOID ' then say out.i
 end
 say 'HISTORYCHANGES DISTINCT PATH OIDS' distinct
 if distinct=1 then status='UNCHANGED'
 else status='CHANGED'
 say 'HISTORYCHANGES STATUS' status
 do vi=1 to distinct
  say 'HISTORYCHANGES VERSION' vi 'OID' version.vi,
      'COUNT' freq.vi 'MINDEPTH' mindepth.vi,
      'MAXDEPTH' maxdepth.vi
  say 'HISTORYCHANGES VERSION' vi 'DEPTHS' depthtext.vi
  do ci=1 to freq.vi
   say 'HISTORYCHANGES VERSION' vi 'COMMIT' vcommit.vi.ci,
       'DEPTH' vdepth.vi.ci
   say 'HISTORYCHANGES VERSION' vi 'NODE' vnode.vi.ci,
       'DEPTH' vdepth.vi.ci
   say 'HISTORYCHANGES VERSION' vi 'NODE' vnode.vi.ci,
       'COMMIT' vcommit.vi.ci
   say 'HISTORYCHANGES VERSION' vi 'NODE' vnode.vi.ci,
       'TREE' vtree.vi.ci
  end
  say 'HISTORYCHANGES VERSION' vi 'TYPE' vtype.vi 'SIZE' vsize.vi
  say 'HISTORYCHANGES VERSION' vi 'MINDEPTHCOMMIT' mincommit.vi
  say 'HISTORYCHANGES VERSION' vi 'MAXDEPTHCOMMIT' maxcommit.vi
 end
 say 'HISTORYCHANGES NODES' pathoids
 say 'HISTORYCHANGES DATA END'
 exit 0
end
if command='RESOLVE' then do
 say 'VERIFIED REF' spec oid
 exit 0
end
emit=0
say 'VERIFIED REF' spec oid
do i=1 to out.0
 if pos(marker,out.i)>0 then emit=1
 if emit then say out.i
end
exit 0

changecheck:
 pathoids=0
 parsednodes=0
 distinct=0
 edgecount=0
 nodes=-1
 edges=-1
 drop seen. seencommit. version. freq. mindepth. maxdepth.
 drop mincommit. maxcommit. vtype. vsize. depthseen.
 drop vcommit. vdepth. vnode. vtree. nodeversion.
 drop edgechild. edgeparent. edgekey.
 curnode=-1
 curdepth=-1
 curcommit=''
 curtree=''
 curtype=-1
 cursize=-1
 havecommit=1
 havetree=1
 havemeta=1
 havepath=1
 do ci=1 to out.0
  if left(out.ci,20)='HISTORYDAGPATH NODE ' then do
   if havepath=0 | havecommit=0 | havetree=0 | havemeta=0 then,
    return 'ERROR'
   parsednodes=parsednodes+1
   curnode=word(out.ci,3)
   if datatype(curnode,'W')\=1 then return 'ERROR'
   if curnode\=parsednodes | curnode>64 then return 'ERROR'
   havecommit=0
   havetree=0
   havemeta=0
   havepath=0
   curcommit=''
   curtree=''
   curtype=-1
   cursize=-1
   curdepth=word(out.ci,5)
   if datatype(curdepth,'W')\=1 then return 'ERROR'
   if curdepth<0 | curdepth>8 then return 'ERROR'
  end
  if left(out.ci,22)='HISTORYDAGPATH COMMIT ' then do
   if havecommit=1 | curnode<1 then return 'ERROR'
   curcommit=translate(word(out.ci,3))
   if length(curcommit)\=40 then return 'ERROR'
   if verify(curcommit,'0123456789ABCDEF')\=0 then return 'ERROR'
   if seencommit.curcommit=1 then return 'ERROR'
   seencommit.curcommit=1
   havecommit=1
  end
  if left(out.ci,20)='HISTORYDAGPATH TREE ' then do
   if havetree=1 | havecommit=0 then return 'ERROR'
   curtree=translate(word(out.ci,3))
   if length(curtree)\=40 then return 'ERROR'
   if verify(curtree,'0123456789ABCDEF')\=0 then return 'ERROR'
   havetree=1
  end
  if left(out.ci,25)='HISTORYDAGPATH PATH TYPE ' then do
   if havemeta=1 | havecommit=0 | havetree=0 then return 'ERROR'
   if word(out.ci,5)\='SIZE' then return 'ERROR'
   curtype=word(out.ci,4)
   cursize=word(out.ci,6)
   if datatype(curtype,'W')\=1 then return 'ERROR'
   if curtype<1 | curtype>3 then return 'ERROR'
   if datatype(cursize,'W')\=1 | cursize<0 then return 'ERROR'
   havemeta=1
  end
  if left(out.ci,23)='HISTORYDAGPATH PATHOID ' then do
   if havepath=1 then return 'ERROR'
   poid=translate(word(out.ci,3))
   if length(poid)\=40 then return 'ERROR'
   if verify(poid,'0123456789ABCDEF')\=0 then return 'ERROR'
   if curnode<1 | curdepth<0 | havecommit=0 | havetree=0 |,
      havemeta=0 then return 'ERROR'
   havepath=1
   pathoids=pathoids+1
   vi=seen.poid
   if datatype(vi,'W')\=1 then do
    distinct=distinct+1
    seen.poid=distinct
    version.distinct=poid
    freq.distinct=1
    mindepth.distinct=curdepth
    maxdepth.distinct=curdepth
    mincommit.distinct=curcommit
    maxcommit.distinct=curcommit
    vtype.distinct=curtype
    vsize.distinct=cursize
    depthseen.distinct.curdepth=1
    vcommit.distinct.1=curcommit
    vdepth.distinct.1=curdepth
    vnode.distinct.1=curnode
    vtree.distinct.1=curtree
   end
   else do
    if vtype.vi\=curtype | vsize.vi\=cursize then return 'ERROR'
    freq.vi=freq.vi+1
    depthseen.vi.curdepth=1
    vcidx=freq.vi
    vcommit.vi.vcidx=curcommit
    vdepth.vi.vcidx=curdepth
    vnode.vi.vcidx=curnode
    vtree.vi.vcidx=curtree
    if curdepth<mindepth.vi then do
     mindepth.vi=curdepth
     mincommit.vi=curcommit
    end
    if curdepth>maxdepth.vi then do
     maxdepth.vi=curdepth
     maxcommit.vi=curcommit
    end
   end
   nodeversion.curnode=vi
  end
  if words(out.ci)=6 & word(out.ci,1)='HISTORYDAGPATH' &,
     word(out.ci,2)='EDGE' then do
   if word(out.ci,3)\='CHILD' | word(out.ci,5)\='PARENT' then,
    return 'ERROR'
   ec=word(out.ci,4)
   ep=word(out.ci,6)
   if datatype(ec,'W')\=1 | datatype(ep,'W')\=1 then return 'ERROR'
   if ec<1 | ep<1 | ec>parsednodes | ep>parsednodes then return 'ERROR'
   if ec=ep then return 'ERROR'
   if edgekey.ec.ep=1 then return 'ERROR'
   edgekey.ec.ep=1
   edgecount=edgecount+1
   edgechild.edgecount=ec
   edgeparent.edgecount=ep
  end
  if words(out.ci)=3 & word(out.ci,1)='HISTORYDAGPATH' &,
     word(out.ci,2)='EDGES' then do
   if edges\=-1 then return 'ERROR'
   edges=word(out.ci,3)
   if datatype(edges,'W')\=1 | edges<0 then return 'ERROR'
   if edges\=edgecount then return 'ERROR'
  end
  if left(out.ci,21)='HISTORYDAGPATH NODES ' then do
   if nodes\=-1 then return 'ERROR'
   nodes=word(out.ci,3)
   if datatype(nodes,'W')\=1 | nodes<1 then return 'ERROR'
  end
 end
 if havepath=0 | havecommit=0 | havetree=0 | havemeta=0 then,
  return 'ERROR'
 if edges<0 | edges\=edgecount then return 'ERROR'
 if nodes<1 | pathoids\=nodes then return 'ERROR'
 if parsednodes\=nodes then return 'ERROR'
 return 'OK'

depthlist:
 parse arg dv
 dl=''
 do dd=0 to 8
  if depthseen.dv.dd=1 then do
   if dl='' then dl=dd
   else dl=dl||','||dd
  end
 end
 if dl='' then return 'ERROR'
 return dl

readrefs:
 drop rr. refname. refoid.
 headref=''
 refcount=0
 'EXECIO * DISKR GITREF2 REPO A 1 (STEM RR. FINIS'
 if rc\=0 then do
  say 'GITVREF: GITREF2 REPO A not found'
  return 'ERROR'
 end
 if rr.0<3 | rr.1\='REF2 1' then do
  say 'GITVREF: invalid REF2 header'
  return 'ERROR'
 end
 do i=2 to rr.0
  if word(rr.i,1)='HEAD' then do
   if words(rr.i)\=2 | headref\='' then return 'ERROR'
   headref=word(rr.i,2)
  end
  else if word(rr.i,1)='REF' then do
   if words(rr.i)\=3 then return 'ERROR'
   name=word(rr.i,2)
   oid=translate(word(rr.i,3))
   if left(name,11)\='refs/heads/' then return 'ERROR'
   if length(oid)\=40 then return 'ERROR'
   if verify(oid,'0123456789ABCDEF')\=0 then return 'ERROR'
   do j=1 to refcount
    if refname.j=name then return 'ERROR'
   end
   refcount=refcount+1
   refname.refcount=name
   refoid.refcount=oid
  end
  else return 'ERROR'
 end
 if left(headref,11)\='refs/heads/' then return 'ERROR'
 return 'OK'

resolve:
 parse arg wanted
 if translate(wanted)='HEAD' then wanted=headref
 else if left(wanted,11)\='refs/heads/' then,
  wanted='refs/heads/'||wanted
 do i=1 to refcount
  if refname.i=wanted then return refoid.i
 end
 say 'GITVREF: ref not found' wanted
 return 'ERROR'

pathasciihex:
 parse arg text
 if text='' | length(text)>255 then return 'ERROR'
 if pos('//',text)>0 | left(text,1)='/' | right(text,1)='/' then,
  return 'ERROR'
 e2ahex='000102031A091A7F1A1A1A0B0C0D0E0F' ||,
         '101112131A1A081A18191A1A1C1D1E1F' ||,
         '1A1A1C1A1A0A171B1A1A1A1A1A050607' ||,
         '1A1A161A1A1E1A041A1A1A1A14151A1A' ||,
         '20A6E180EB909FE2AB8B9B2E3C282B7C' ||,
         '26A9AA9CDBA599E3A89E21242A293B5E' ||,
         '2D2FDFDC9ADDDE989DACBA2C255F3E3F' ||,
         'D78894B0B1B2FCD6FB603A2340273D22' ||,
         'F861626364656667686996A4F3AFAEC5' ||,
         '8C6A6B6C6D6E6F7071729787CE93F1FE' ||,
         'C87E737475767778797AEFC0DA5BF2F9' ||,
         'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4' ||,
         '7B414243444546474849CBCABEE8ECED' ||,
         '7D4A4B4C4D4E4F505152A1ADF5F4A38F' ||,
         '5CE7535455565758595AA0858EE9E4D1' ||,
         '30313233343536373839B3F7F0FAA7FF'
 e2a=x2c(e2ahex)
 bytes=xrange('00'x,'FF'x)
 out=c2x(translate(text,e2a,bytes))
 if pos('00',out)>0 then return 'ERROR'
 return out

bindnative:
 'FILEDEF SEL0 DISK M15SL0 PTR A'
 if rc\=0 then return 'ERROR'
 'FILEDEF SEL1 DISK M15SL1 PTR A'
 if rc\=0 then return 'ERROR'
 do i=1 to 4
  typ=word('STAGE INDEX SEEK GEN',i)
  dd=word('C0STG C0IDX C0SEEK C0GEN',i)
  'FILEDEF' dd 'DISK GITFIX' typ 'A'
  if rc\=0 then return 'ERROR'
  dd=word('C1STG C1IDX C1SEEK C1GEN',i)
  'FILEDEF' dd 'DISK M15NEW' typ 'A'
  if rc\=0 then return 'ERROR'
 end
 return 'OK'
