/* M68: read-only REF2 verified history path bridge. */
address cms
parse arg command spec depth extra
command=translate(command)
if command\='RESOLVE' & command\='SHOW' & command\='LOG' &,
   command\='DAG' & command\='READ' & command\='DIR' &,
   command\='HISTPATH' then do
 say 'Usage: GITVREF command ref [depth] [path]'
 exit 4
end
if spec='' then exit 4
if command='HISTPATH' then do
 if depth='' | extra='' then exit 4
end
else if extra\='' then exit 4
if command='LOG' | command='DAG' | command='HISTPATH' then do
 if depth='' | length(depth)>2 | verify(depth,'0123456789')\=0 then exit 4
 if command='LOG' & depth+0>16 then exit 4
 if command='DAG' & depth+0>8 then exit 4
end
else if command='READ' | command='DIR' then do
 if depth='' then exit 4
 call pathasciihex depth
 if result='ERROR' then exit 4
 pathhex=result
end
else if depth\='' then exit 4
call readrefs
if result\='OK' then exit 8
call resolve spec
if result='ERROR' then exit 8
oid=result
call bindnative
if result\='OK' then exit 8
if command='LOG' then do
 cmd='GITREC LOGFULL GITFIX M15NEW' oid depth
 marker='LOG FULL SNAPSHOTS VERIFIED'
end
else if command='DAG' then do
 cmd='GITREC LOGDAGFULL GITFIX M15NEW' oid depth
 marker='LOGDAG FULL SNAPSHOTS VERIFIED'
end
else if command='READ' then do
 cmd='GITREC PATHFULLCAT GITFIX M15NEW' oid pathhex
 marker='COMMIT ROOT FULL CLOSURE VERIFIED'
end
else if command='DIR' then do
 cmd='GITREC PATHFULLDIR GITFIX M15NEW' oid pathhex
 marker='COMMIT ROOT FULL CLOSURE VERIFIED'
end
else do
 cmd='GITREC SHOWFULL GITFIX M15NEW' oid
 marker='SHOW FULL ROOT CLOSURE VERIFIED'
end
out.0=0
'PIPE CMS' cmd '| STEM out.'
if rc\=0 then exit rc
ok=0
do i=1 to out.0
 if pos(marker,out.i)>0 then ok=1
end
if \ok then exit 8
if command='RESOLVE' then do
 say 'VERIFIED REF' spec oid
 exit 0
end
emit=0
say 'VERIFIED REF' spec oid
do i=1 to out.0
 if pos(marker,out.i)>0 then emit=1
 if emit then say out.i
end
exit 0

readrefs:
 drop rr. refname. refoid.
 headref=''
 refcount=0
 'EXECIO * DISKR GITREF2 REPO A 1 (STEM RR. FINIS'
 if rc\=0 then do
  say 'GITVREF: GITREF2 REPO A not found'
  return 'ERROR'
 end
 if rr.0<3 | rr.1\='REF2 1' then do
  say 'GITVREF: invalid REF2 header'
  return 'ERROR'
 end
 do i=2 to rr.0
  if word(rr.i,1)='HEAD' then do
   if words(rr.i)\=2 | headref\='' then return 'ERROR'
   headref=word(rr.i,2)
  end
  else if word(rr.i,1)='REF' then do
   if words(rr.i)\=3 then return 'ERROR'
   name=word(rr.i,2)
   oid=translate(word(rr.i,3))
   if left(name,11)\='refs/heads/' then return 'ERROR'
   if length(oid)\=40 then return 'ERROR'
   if verify(oid,'0123456789ABCDEF')\=0 then return 'ERROR'
   do j=1 to refcount
    if refname.j=name then return 'ERROR'
   end
   refcount=refcount+1
   refname.refcount=name
   refoid.refcount=oid
  end
  else return 'ERROR'
 end
 if left(headref,11)\='refs/heads/' then return 'ERROR'
 return 'OK'

resolve:
 parse arg wanted
 if translate(wanted)='HEAD' then wanted=headref
 else if left(wanted,11)\='refs/heads/' then,
  wanted='refs/heads/'||wanted
 do i=1 to refcount
  if refname.i=wanted then return refoid.i
 end
 say 'GITVREF: ref not found' wanted
 return 'ERROR'

pathasciihex:
 parse arg text
 if text='' | length(text)>255 then return 'ERROR'
 if pos('//',text)>0 | left(text,1)='/' | right(text,1)='/' then,
  return 'ERROR'
 e2ahex='000102031A091A7F1A1A1A0B0C0D0E0F' ||,
         '101112131A1A081A18191A1A1C1D1E1F' ||,
         '1A1A1C1A1A0A171B1A1A1A1A1A050607' ||,
         '1A1A161A1A1E1A041A1A1A1A14151A1A' ||,
         '20A6E180EB909FE2AB8B9B2E3C282B7C' ||,
         '26A9AA9CDBA599E3A89E21242A293B5E' ||,
         '2D2FDFDC9ADDDE989DACBA2C255F3E3F' ||,
         'D78894B0B1B2FCD6FB603A2340273D22' ||,
         'F861626364656667686996A4F3AFAEC5' ||,
         '8C6A6B6C6D6E6F7071729787CE93F1FE' ||,
         'C87E737475767778797AEFC0DA5BF2F9' ||,
         'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4' ||,
         '7B414243444546474849CBCABEE8ECED' ||,
         '7D4A4B4C4D4E4F505152A1ADF5F4A38F' ||,
         '5CE7535455565758595AA0858EE9E4D1' ||,
         '30313233343536373839B3F7F0FAA7FF'
 e2a=x2c(e2ahex)
 bytes=xrange('00'x,'FF'x)
 out=c2x(translate(text,e2a,bytes))
 if pos('00',out)>0 then return 'ERROR'
 return out

bindnative:
 'FILEDEF SEL0 DISK M15SL0 PTR A'
 if rc\=0 then return 'ERROR'
 'FILEDEF SEL1 DISK M15SL1 PTR A'
 if rc\=0 then return 'ERROR'
 do i=1 to 4
  typ=word('STAGE INDEX SEEK GEN',i)
  dd=word('C0STG C0IDX C0SEEK C0GEN',i)
  'FILEDEF' dd 'DISK GITFIX' typ 'A'
  if rc\=0 then return 'ERROR'
  dd=word('C1STG C1IDX C1SEEK C1GEN',i)
  'FILEDEF' dd 'DISK M15NEW' typ 'A'
  if rc\=0 then return 'ERROR'
 end
 return 'OK'
