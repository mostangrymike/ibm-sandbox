/* M142: authenticated first-parent log and consolidated report. */
address cms
/* CMS REXX defaults to 9 digits; Git epochs are already 10 digits. */
numeric digits 20
parse arg command spec depth extra
command=translate(command)
if command='LEVEL' then do
 if spec\='' | depth\='' | extra\='' then exit 4
 say 'GITVREF EXEC LEVEL M142'
 exit 0
end
if command\='RESOLVE' & command\='SHOW' & command\='LOG' &,
   command\='DAG' & command\='READ' & command\='DIR' &,
   command\='HISTPATH' & command\='HISTCHG' &,
   command\='HISTEDGE' & command\='HISTDIFF' &,
   command\='HISTSTATE' & command\='HISTLOG' &,
   command\='HISTSTATUS' & command\='HISTNEAR' &,
   command\='HISTTRANS' & command\='HISTREPORT' &,
   command\='HISTBOUNDS' & command\='HISTCHRON' &,
   command\='HISTACTORS' & command\='HISTSUBJECTS' &,
   command\='HISTBODIES' & command\='HISTTOPO' &,
   command\='HISTPARENTS' & command\='HISTSLOTS' &,
   command\='HISTROLES' & command\='HISTFIRST' &,
   command\='HISTFCHG' & command\='HISTFTRANS' &,
   command\='HISTFCHRON' & command\='HISTFACTORS' &,
   command\='HISTFSUBJ' & command\='HISTFBODY' &,
   command\='HISTFLOG' & command\='HISTFREPORT' then do
 say 'Usage: GITVREF command ref [depth] [path]'
 exit 4
end
if spec='' then exit 4
if command='HISTPATH' | command='HISTCHG' |,
   command='HISTEDGE' | command='HISTDIFF' |,
   command='HISTSTATE' | command='HISTLOG' |,
   command='HISTSTATUS' | command='HISTNEAR' |,
   command='HISTTRANS' | command='HISTREPORT' |,
   command='HISTBOUNDS' | command='HISTCHRON' |,
   command='HISTACTORS' | command='HISTSUBJECTS' |,
   command='HISTBODIES' | command='HISTTOPO' |,
   command='HISTPARENTS' | command='HISTSLOTS' |,
   command='HISTROLES' | command='HISTFIRST' |,
   command='HISTFCHG' | command='HISTFTRANS' |,
   command='HISTFCHRON' | command='HISTFACTORS' |,
   command='HISTFSUBJ' | command='HISTFBODY' |,
   command='HISTFLOG' | command='HISTFREPORT' then do
 if depth='' | extra='' then exit 4
end
else if extra\='' then exit 4
if command='LOG' | command='DAG' | command='HISTPATH' |,
   command='HISTCHG' | command='HISTEDGE' |,
   command='HISTDIFF' | command='HISTSTATE' |,
   command='HISTLOG' | command='HISTSTATUS' |,
   command='HISTNEAR' | command='HISTTRANS' |,
   command='HISTREPORT' | command='HISTBOUNDS' |,
   command='HISTCHRON' | command='HISTACTORS' |,
   command='HISTSUBJECTS' | command='HISTBODIES' |,
   command='HISTTOPO' | command='HISTPARENTS' |,
   command='HISTSLOTS' | command='HISTROLES' |,
   command='HISTFIRST' | command='HISTFCHG' |,
   command='HISTFTRANS' | command='HISTFCHRON' |,
   command='HISTFACTORS' | command='HISTFSUBJ' |,
   command='HISTFBODY' | command='HISTFLOG' |,
   command='HISTFREPORT' then do
 if depth='' | length(depth)>2 | verify(depth,'0123456789')\=0 then exit 4
 if command='LOG' & depth+0>16 then exit 4
 if command='DAG' & depth+0>8 then exit 4
 if command='HISTPATH' & depth+0>8 then exit 4
 if command='HISTCHG' & depth+0>8 then exit 4
 if command='HISTEDGE' & depth+0>8 then exit 4
 if command='HISTDIFF' & depth+0>8 then exit 4
 if command='HISTSTATE' & depth+0>8 then exit 4
 if command='HISTLOG' & depth+0>8 then exit 4
 if command='HISTSTATUS' & depth+0>8 then exit 4
 if command='HISTNEAR' & depth+0>8 then exit 4
 if command='HISTTRANS' & depth+0>8 then exit 4
 if command='HISTREPORT' & depth+0>8 then exit 4
 if command='HISTBOUNDS' & depth+0>8 then exit 4
 if command='HISTCHRON' & depth+0>8 then exit 4
 if command='HISTACTORS' & depth+0>8 then exit 4
 if command='HISTSUBJECTS' & depth+0>8 then exit 4
 if command='HISTBODIES' & depth+0>8 then exit 4
 if command='HISTTOPO' & depth+0>8 then exit 4
 if command='HISTPARENTS' & depth+0>8 then exit 4
 if command='HISTSLOTS' & depth+0>8 then exit 4
 if command='HISTROLES' & depth+0>8 then exit 4
 if command='HISTFIRST' & depth+0>8 then exit 4
 if command='HISTFCHG' & depth+0>8 then exit 4
 if command='HISTFTRANS' & depth+0>8 then exit 4
 if command='HISTFCHRON' & depth+0>8 then exit 4
 if command='HISTFACTORS' & depth+0>8 then exit 4
 if command='HISTFSUBJ' & depth+0>8 then exit 4
 if command='HISTFBODY' & depth+0>8 then exit 4
 if command='HISTFLOG' & depth+0>8 then exit 4
 if command='HISTFREPORT' & depth+0>8 then exit 4
 if command='HISTPATH' | command='HISTCHG' |,
    command='HISTEDGE' | command='HISTDIFF' |,
    command='HISTSTATE' | command='HISTLOG' |,
    command='HISTSTATUS' | command='HISTNEAR' |,
    command='HISTTRANS' | command='HISTREPORT' |,
    command='HISTBOUNDS' | command='HISTCHRON' |,
    command='HISTACTORS' | command='HISTSUBJECTS' |,
   command='HISTBODIES' | command='HISTTOPO' |,
   command='HISTPARENTS' | command='HISTSLOTS' |,
   command='HISTROLES' | command='HISTFIRST' |,
   command='HISTFCHG' | command='HISTFTRANS' |,
   command='HISTFCHRON' | command='HISTFACTORS' |,
   command='HISTFSUBJ' | command='HISTFBODY' |,
   command='HISTFLOG' | command='HISTFREPORT' then do
  call pathasciihex extra
  if result='ERROR' then exit 4
  pathhex=result
 end
end
else if command='READ' | command='DIR' then do
 if depth='' then exit 4
 call pathasciihex depth
 if result='ERROR' then exit 4
 pathhex=result
end
else if depth\='' then exit 4
call readrefs
if result\='OK' then exit 8
call resolve spec
if result='ERROR' then exit 8
oid=result
call bindnative
if result\='OK' then exit 8
if command='LOG' then do
 cmd='GITREC LOGFULL GITFIX M15NEW' oid depth
 marker='LOG FULL SNAPSHOTS VERIFIED'
end
else if command='DAG' then do
 cmd='GITREC LOGDAGFULL GITFIX M15NEW' oid depth
 marker='LOGDAG FULL SNAPSHOTS VERIFIED'
end
else if command='HISTDIFF' | command='HISTSTATE' |,
        command='HISTLOG' | command='HISTSTATUS' |,
        command='HISTNEAR' | command='HISTTRANS' |,
        command='HISTREPORT' | command='HISTBOUNDS' |,
        command='HISTCHRON' | command='HISTACTORS' |,
   command='HISTSUBJECTS' | command='HISTBODIES' |,
   command='HISTTOPO' | command='HISTPARENTS' |,
   command='HISTSLOTS' | command='HISTROLES' |,
   command='HISTFIRST' | command='HISTFCHG' |,
   command='HISTFTRANS' | command='HISTFCHRON' |,
   command='HISTFACTORS' | command='HISTFSUBJ' |,
   command='HISTFBODY' | command='HISTFLOG' |,
   command='HISTFREPORT' then do
 cmd='GITREC HISTORYDAGSTATE GITFIX M15NEW' oid depth pathhex
 marker='HISTORYDAGSTATE FULL SNAPSHOTS VERIFIED'
end
else if command='HISTPATH' | command='HISTCHG' |,
        command='HISTEDGE' then do
 cmd='GITREC HISTORYDAGPATH GITFIX M15NEW' oid depth pathhex
 marker='HISTORYDAGPATH FULL SNAPSHOTS VERIFIED'
end
else if command='READ' then do
 cmd='GITREC PATHFULLCAT GITFIX M15NEW' oid pathhex
 marker='COMMIT ROOT FULL CLOSURE VERIFIED'
end
else if command='DIR' then do
 cmd='GITREC PATHFULLDIR GITFIX M15NEW' oid pathhex
 marker='COMMIT ROOT FULL CLOSURE VERIFIED'
end
else do
 cmd='GITREC SHOWFULL GITFIX M15NEW' oid
 marker='SHOW FULL ROOT CLOSURE VERIFIED'
end
out.0=0
'PIPE CMS' cmd '| STEM out.'
if rc\=0 then exit rc
ok=0
do i=1 to out.0
 if pos(marker,out.i)>0 then ok=1
end
if \ok then exit 8
if command='HISTDIFF' | command='HISTSTATE' |,
   command='HISTLOG' | command='HISTSTATUS' |,
   command='HISTNEAR' | command='HISTTRANS' |,
   command='HISTREPORT' | command='HISTBOUNDS' |,
   command='HISTCHRON' | command='HISTACTORS' |,
   command='HISTSUBJECTS' | command='HISTBODIES' |,
   command='HISTTOPO' | command='HISTPARENTS' |,
   command='HISTSLOTS' | command='HISTROLES' |,
   command='HISTFIRST' | command='HISTFCHG' |,
   command='HISTFTRANS' | command='HISTFCHRON' |,
   command='HISTFACTORS' | command='HISTFSUBJ' |,
   command='HISTFBODY' | command='HISTFLOG' |,
   command='HISTFREPORT' then do
 call statecheck
 if result\='OK' then exit 8
 if command='HISTSTATE' then do
  call stateemit
  exit result
 end
 if command='HISTLOG' then do
  call statelog
  exit result
 end
 if command='HISTSTATUS' then do
  call statestatus
  exit result
 end
 if command='HISTNEAR' then do
  call statenear
  exit result
 end
 if command='HISTTRANS' then do
  call statetrans
  exit result
 end
 if command='HISTREPORT' then do
  call statereport
  exit result
 end
 if command='HISTBOUNDS' then do
  call statebounds
  exit result
 end
 if command='HISTCHRON' then do
  call statechron
  exit result
 end
 if command='HISTACTORS' then do
  call stateactors
  exit result
 end
 if command='HISTSUBJECTS' then do
  call statesubjects
  exit result
 end
 if command='HISTBODIES' then do
  call statebodies
  exit result
 end
 if command='HISTTOPO' then do
  call statetopology
  exit result
 end
 if command='HISTPARENTS' then do
  call stateparents
  exit result
 end
 if command='HISTSLOTS' then do
  call stateparentslots
  exit result
 end
 if command='HISTROLES' then do
  call stateedgeroles
  exit result
 end
 if command='HISTFIRST' then do
  call statefirstparent
  exit result
 end
 if command='HISTFCHG' then do
  call statefirstchanges
  exit result
 end
 if command='HISTFTRANS' then do
  call statefirsttransitions
  exit result
 end
 if command='HISTFCHRON' then do
  call statefirstchron
  exit result
 end
 if command='HISTFACTORS' then do
  call statefirstactors
  exit result
 end
 if command='HISTFSUBJ' then do
  call statefirstsubjects
  exit result
 end
 if command='HISTFBODY' then do
  call statefirstbodies
  exit result
 end
 if command='HISTFLOG' then do
  call statefirstlog
  exit result
 end
 if command='HISTFREPORT' then do
  call statefirstreport
  exit result
 end
 call statediff
 exit result
end
if command='HISTCHG' | command='HISTEDGE' then do
 call changecheck
 if result\='OK' then exit 8
 drop depthtext.
 members=0
 do vi=1 to distinct
  call depthlist vi
  if result='ERROR' then exit 8
  depthtext.vi=result
  members=members+freq.vi
  do ci=1 to freq.vi
   if length(vcommit.vi.ci)\=40 then exit 8
   if verify(vcommit.vi.ci,'0123456789ABCDEF')\=0 then exit 8
   if length(vtree.vi.ci)\=40 then exit 8
   if verify(vtree.vi.ci,'0123456789ABCDEF')\=0 then exit 8
   if datatype(vnode.vi.ci,'W')\=1 then exit 8
   if vnode.vi.ci<1 | vnode.vi.ci>64 then exit 8
   if datatype(vdepth.vi.ci,'W')\=1 then exit 8
   if vdepth.vi.ci<0 | vdepth.vi.ci>8 then exit 8
  end
 end
 if members\=nodes then exit 8
 drop edgestatus. edgecv. edgepv.
 drop pairno. pairchild. pairparent. paircount.
 changededges=0
 unchangededges=0
 pairs=0
 do ei=1 to edgecount
  ec=edgechild.ei
  ep=edgeparent.ei
  cv=nodeversion.ec
  pv=nodeversion.ep
  if datatype(cv,'W')\=1 | datatype(pv,'W')\=1 then exit 8
  if cv<1 | pv<1 | cv>distinct | pv>distinct then exit 8
  edgecv.ei=cv
  edgepv.ei=pv
  if cv=pv then do
   edgestatus.ei='UNCHANGED'
   unchangededges=unchangededges+1
  end
  else do
   edgestatus.ei='CHANGED'
   changededges=changededges+1
  end
  tk=cv||'.'||pv
  ti=pairno.tk
  if datatype(ti,'W')\=1 then do
   pairs=pairs+1
   pairno.tk=pairs
   pairchild.pairs=cv
   pairparent.pairs=pv
   paircount.pairs=1
  end
  else paircount.ti=paircount.ti+1
 end
 if changededges+unchangededges\=edgecount then exit 8
 tsum=0
 do ti=1 to pairs
  tsum=tsum+paircount.ti
 end
 if tsum\=edgecount then exit 8
 changedpairs=0
 drop changepair.
 do ti=1 to pairs
  if pairchild.ti\=pairparent.ti then do
   changedpairs=changedpairs+1
   changepair.changedpairs=ti
  end
 end
 if changededges=0 & changedpairs\=0 then exit 8
 if changededges>0 & changedpairs=0 then exit 8
 if distinct=1 & changededges\=0 then exit 8
 if distinct>1 & changededges=0 then exit 8
 if command='HISTEDGE' then do
  if distinct=1 then status='UNCHANGED'
  else status='CHANGED'
  call emitverified
  say 'HISTORYEDGES FULL SNAPSHOTS VERIFIED'
  say 'HISTORYEDGES DATA BEGIN'
  say 'HISTORYEDGES STATUS' status
  say 'HISTORYEDGES VERSIONS' distinct
  do vi=1 to distinct
   say 'HISTORYEDGES VERSION' vi 'OID' version.vi
  end
  say 'HISTORYEDGES NODES' nodes
  say 'HISTORYEDGES EDGES' edgecount
  say 'HISTORYEDGES CHANGED EDGES' changededges
  say 'HISTORYEDGES UNCHANGED EDGES' unchangededges
  say 'HISTORYEDGES TRANSITIONS' pairs
  do ti=1 to pairs
   cv=pairchild.ti
   pv=pairparent.ti
   say 'HISTORYEDGES TRANSITION' ti 'CHILDVERSION' cv,
       'PARENTVERSION' pv 'COUNT' paircount.ti
   say 'HISTORYEDGES TRANSITION' ti 'CHILDOID' version.cv
   say 'HISTORYEDGES TRANSITION' ti 'PARENTOID' version.pv
  end
  do ei=1 to edgecount
   ec=edgechild.ei
   ep=edgeparent.ei
   cv=edgecv.ei
   pv=edgepv.ei
   say 'HISTORYEDGES EDGE' ei 'CHILD' ec 'PARENT' ep
   say 'HISTORYEDGES EDGE' ei 'CHILDVERSION' edgecv.ei,
       'PARENTVERSION' edgepv.ei
   say 'HISTORYEDGES EDGE' ei 'CHILDOID' version.cv
   say 'HISTORYEDGES EDGE' ei 'PARENTOID' version.pv
   say 'HISTORYEDGES EDGE' ei 'CHILDTYPE' vtype.cv,
       'SIZE' vsize.cv
   say 'HISTORYEDGES EDGE' ei 'PARENTTYPE' vtype.pv,
       'SIZE' vsize.pv
   say 'HISTORYEDGES EDGE' ei 'CHILDDEPTH' nodedepth.ec
   say 'HISTORYEDGES EDGE' ei 'PARENTDEPTH' nodedepth.ep
   say 'HISTORYEDGES EDGE' ei 'CHILDCOMMIT' nodecommit.ec
   say 'HISTORYEDGES EDGE' ei 'PARENTCOMMIT' nodecommit.ep
   say 'HISTORYEDGES EDGE' ei 'CHILDTREE' nodetree.ec
   say 'HISTORYEDGES EDGE' ei 'PARENTTREE' nodetree.ep
   say 'HISTORYEDGES EDGE' ei 'STATUS' edgestatus.ei
  end
  say 'HISTORYEDGES DATA END'
  exit 0
 end
 call emitverified
 say 'HISTORYCHANGES FULL SNAPSHOTS VERIFIED'
 say 'HISTORYCHANGES DATA BEGIN'
 do i=1 to out.0
  if left(out.i,20)='HISTORYDAGPATH NODE ' |,
     left(out.i,22)='HISTORYDAGPATH COMMIT ' |,
     left(out.i,25)='HISTORYDAGPATH PATH TYPE ' |,
     left(out.i,23)='HISTORYDAGPATH PATHOID ' then say out.i
 end
 say 'HISTORYCHANGES DISTINCT PATH OIDS' distinct
 if distinct=1 then status='UNCHANGED'
 else status='CHANGED'
 say 'HISTORYCHANGES STATUS' status
 say 'HISTORYCHANGES EDGES' edgecount
 say 'HISTORYCHANGES CHANGED EDGES' changededges
 say 'HISTORYCHANGES UNCHANGED EDGES' unchangededges
 say 'HISTORYCHANGES TRANSITIONS' pairs
 do ti=1 to pairs
  cv=pairchild.ti
  pv=pairparent.ti
  say 'HISTORYCHANGES TRANSITION' ti 'CHILDVERSION' cv,
      'PARENTVERSION' pv 'COUNT' paircount.ti
  say 'HISTORYCHANGES TRANSITION' ti 'CHILDOID' version.cv
  say 'HISTORYCHANGES TRANSITION' ti 'PARENTOID' version.pv
 end
 do ei=1 to edgecount
  ec=edgechild.ei
  ep=edgeparent.ei
  cv=edgecv.ei
  pv=edgepv.ei
  say 'HISTORYCHANGES EDGE' ei 'CHILD' ec 'PARENT' ep
  say 'HISTORYCHANGES EDGE' ei 'CHILDVERSION' edgecv.ei,
      'PARENTVERSION' edgepv.ei
  say 'HISTORYCHANGES EDGE' ei 'CHILDOID' version.cv
  say 'HISTORYCHANGES EDGE' ei 'PARENTOID' version.pv
  say 'HISTORYCHANGES EDGE' ei 'CHILDTYPE' vtype.cv,
      'SIZE' vsize.cv
  say 'HISTORYCHANGES EDGE' ei 'PARENTTYPE' vtype.pv,
      'SIZE' vsize.pv
  say 'HISTORYCHANGES EDGE' ei 'CHILDDEPTH' nodedepth.ec
  say 'HISTORYCHANGES EDGE' ei 'PARENTDEPTH' nodedepth.ep
  say 'HISTORYCHANGES EDGE' ei 'CHILDCOMMIT' nodecommit.ec
  say 'HISTORYCHANGES EDGE' ei 'PARENTCOMMIT' nodecommit.ep
  say 'HISTORYCHANGES EDGE' ei 'CHILDTREE' nodetree.ec
  say 'HISTORYCHANGES EDGE' ei 'PARENTTREE' nodetree.ep
  say 'HISTORYCHANGES EDGE' ei 'STATUS' edgestatus.ei
 end
 do vi=1 to distinct
  say 'HISTORYCHANGES VERSION' vi 'OID' version.vi,
      'COUNT' freq.vi 'MINDEPTH' mindepth.vi,
      'MAXDEPTH' maxdepth.vi
  say 'HISTORYCHANGES VERSION' vi 'DEPTHS' depthtext.vi
  do ci=1 to freq.vi
   say 'HISTORYCHANGES VERSION' vi 'COMMIT' vcommit.vi.ci,
       'DEPTH' vdepth.vi.ci
   say 'HISTORYCHANGES VERSION' vi 'NODE' vnode.vi.ci,
       'DEPTH' vdepth.vi.ci
   say 'HISTORYCHANGES VERSION' vi 'NODE' vnode.vi.ci,
       'COMMIT' vcommit.vi.ci
   say 'HISTORYCHANGES VERSION' vi 'NODE' vnode.vi.ci,
       'TREE' vtree.vi.ci
  end
  say 'HISTORYCHANGES VERSION' vi 'TYPE' vtype.vi 'SIZE' vsize.vi
  say 'HISTORYCHANGES VERSION' vi 'MINDEPTHCOMMIT' mincommit.vi
  say 'HISTORYCHANGES VERSION' vi 'MAXDEPTHCOMMIT' maxcommit.vi
 end
 say 'HISTORYCHANGES NODES' pathoids
 say 'HISTORYCHANGES DATA END'
 exit 0
end
if command='RESOLVE' then do
 call emitverified
 exit 0
end
emit=0
call emitverified
do i=1 to out.0
 if pos(marker,out.i)>0 then emit=1
 if emit then do
  if command='HISTPATH' & word(out.i,1)='HISTORYDAGPATH' &,
     (word(out.i,2)='EDGE' | word(out.i,2)='EDGES') then iterate
  say out.i
 end
end
exit 0


statecheck:
 parsednodes=0
 snodes=-1
 sedges=-1
 sedgecount=0
 sslots=-1
 sslotcount=0
 drop spresent. soid. stype. ssize. scommit. stree. sdepth.
 drop sparents. suniqueparents. soutedges.
 drop sfirstparent. sparentseqid. sfirstnode.
 drop sauthorwhen. sauthtz. scommitwhen. scommittz.
 drop smsgbytes. smsgid.
 drop saidentbytes. saidentprefix. saidenthex. saidentid.
 drop scidentbytes. scidentprefix. scidenthex. scidentid.
 drop ssubbytes. ssubprefix. ssubhex. ssubid.
 drop sedgechild. sedgeparent. sedgekey. sparentseen.
 drop sslotchild. sslotord. sslotparent. sslotkey.
 drop sslotnodecount. sslotdistinct. sslotparentseen.
 drop sseencommit.
 curnode=-1
 curdepth=-1
 curcommit=''
 curtree=''
 curtype=-1
 cursize=-1
 curpresent=-1
 havecommit=1
 havetree=1
 haveparents=1
 havefirstparent=1
 haveparentseq=1
 haveauthor=1
 haveaidentmeta=1
 haveaidenthex=1
 haveaidentid=1
 havecommitter=1
 havecidentmeta=1
 havecidenthex=1
 havecidentid=1
 havemsg=1
 havemsgid=1
 havesubmeta=1
 havesubhex=1
 havesubid=1
 havestate=1
 do ci=1 to out.0
  if words(out.ci)=5 & word(out.ci,1)='HISTORYDAGSTATE' &,
     word(out.ci,2)='NODE' & word(out.ci,4)='DEPTH' then do
   if havestate=0 | havecommit=0 | havetree=0 |,
      haveparents=0 | havefirstparent=0 | haveparentseq=0 |,
      haveauthor=0 |,
      haveaidentmeta=0 | haveaidenthex=0 |,
      haveaidentid=0 | havecommitter=0 |,
      havecidentmeta=0 | havecidenthex=0 | havecidentid=0 |,
      havemsg=0 | havemsgid=0 |,
      havesubmeta=0 | havesubhex=0 |,
      havesubid=0 then,
    return 'ERROR'
   parsednodes=parsednodes+1
   curnode=word(out.ci,3)
   curdepth=word(out.ci,5)
   if datatype(curnode,'W')\=1 | curnode\=parsednodes then,
    return 'ERROR'
   if curnode<1 | curnode>64 then return 'ERROR'
   if datatype(curdepth,'W')\=1 | curdepth<0 | curdepth>8 then,
    return 'ERROR'
   curcommit=''
   curtree=''
   curtype=-1
   cursize=-1
   curpresent=-1
   havecommit=0
   havetree=0
   haveparents=0
   havefirstparent=0
   haveparentseq=0
   haveauthor=0
   haveaidentmeta=0
   haveaidenthex=0
   haveaidentid=0
   havecommitter=0
   havecidentmeta=0
   havecidenthex=0
   havecidentid=0
   havemsg=0
   havemsgid=0
   havesubmeta=0
   havesubhex=0
   havesubid=0
   havestate=0
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='COMMIT' then do
   if curnode<1 | havecommit=1 then return 'ERROR'
   curcommit=translate(word(out.ci,3))
   if length(curcommit)\=40 then return 'ERROR'
   if verify(curcommit,'0123456789ABCDEF')\=0 then return 'ERROR'
   if sseencommit.curcommit=1 then return 'ERROR'
   sseencommit.curcommit=1
   havecommit=1
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='TREE' then do
   if havecommit=0 | havetree=1 then return 'ERROR'
   curtree=translate(word(out.ci,3))
   if length(curtree)\=40 then return 'ERROR'
   if verify(curtree,'0123456789ABCDEF')\=0 then return 'ERROR'
   havetree=1
  end
  else if words(out.ci)=5 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='PARENTS' & word(out.ci,4)='UNIQUE' then do
   if havetree=0 | haveparents=1 then return 'ERROR'
   pc=word(out.ci,3)
   pu=word(out.ci,5)
   if datatype(pc,'W')\=1 | pc<0 then return 'ERROR'
   if datatype(pu,'W')\=1 | pu<0 | pu>pc then return 'ERROR'
   sparents.curnode=pc
   suniqueparents.curnode=pu
   haveparents=1
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='FIRSTPARENT' then do
   if haveparents=0 | havefirstparent=1 then return 'ERROR'
   fp=translate(word(out.ci,3))
   if sparents.curnode=0 then do
    if fp\='NONE' then return 'ERROR'
   end
   else do
    if length(fp)\=40 then return 'ERROR'
    if verify(fp,'0123456789ABCDEF')\=0 then return 'ERROR'
   end
   sfirstparent.curnode=fp
   havefirstparent=1
  end
  else if words(out.ci)=4 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='PARENTSEQ' & word(out.ci,3)='BLOBID' then do
   if havefirstparent=0 | haveparentseq=1 then return 'ERROR'
   ps=translate(word(out.ci,4))
   if length(ps)\=40 then return 'ERROR'
   if verify(ps,'0123456789ABCDEF')\=0 then return 'ERROR'
   sparentseqid.curnode=ps
   haveparentseq=1
  end
  else if words(out.ci)=6 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='AUTHOR' & word(out.ci,3)='TIME' &,
          word(out.ci,5)='TZMIN' then do
   if havetree=0 | haveparents=0 | havefirstparent=0 |,
      haveparentseq=0 | haveauthor=1 then return 'ERROR'
   aw=word(out.ci,4)
   az=word(out.ci,6)
   if datatype(aw,'W')\=1 | aw<0 then return 'ERROR'
   if datatype(az,'W')\=1 | az<(-1439) | az>1439 then,
    return 'ERROR'
   sauthorwhen.curnode=aw
   sauthtz.curnode=az
   haveauthor=1
  end
  else if words(out.ci)=6 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='AIDENT' & word(out.ci,3)='BYTES' &,
          word(out.ci,5)='PREFIXBYTES' then do
   if haveauthor=0 | haveaidentmeta=1 then return 'ERROR'
   ib=word(out.ci,4)
   ip=word(out.ci,6)
   if datatype(ib,'W')\=1 | ib<1 then return 'ERROR'
   if datatype(ip,'W')\=1 | ip<1 | ip>20 | ip>ib then,
    return 'ERROR'
   saidentbytes.curnode=ib
   saidentprefix.curnode=ip
   haveaidentmeta=1
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='AIDENTHEX' then do
   if haveaidentmeta=0 | haveaidenthex=1 then return 'ERROR'
   ih=translate(word(out.ci,3))
   ip=saidentprefix.curnode
   if length(ih)\=ip*2 then return 'ERROR'
   if verify(ih,'0123456789ABCDEF')\=0 then return 'ERROR'
   saidenthex.curnode=ih
   haveaidenthex=1
  end
  else if words(out.ci)=4 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='AIDENT' & word(out.ci,3)='BLOBID' then do
   if haveaidenthex=0 | haveaidentid=1 then return 'ERROR'
   iid=translate(word(out.ci,4))
   if length(iid)\=40 then return 'ERROR'
   if verify(iid,'0123456789ABCDEF')\=0 then return 'ERROR'
   saidentid.curnode=iid
   haveaidentid=1
  end
  else if words(out.ci)=6 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='COMMITTER' & word(out.ci,3)='TIME' &,
          word(out.ci,5)='TZMIN' then do
   if havetree=0 | havecommitter=1 | haveaidentmeta=0 |,
      haveaidenthex=0 | haveaidentid=0 then return 'ERROR'
   cw=word(out.ci,4)
   cz=word(out.ci,6)
   if datatype(cw,'W')\=1 | cw<0 then return 'ERROR'
   if datatype(cz,'W')\=1 | cz<(-1439) | cz>1439 then,
    return 'ERROR'
   scommitwhen.curnode=cw
   scommittz.curnode=cz
   havecommitter=1
  end
  else if words(out.ci)=6 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='CIDENT' & word(out.ci,3)='BYTES' &,
          word(out.ci,5)='PREFIXBYTES' then do
   if havecommitter=0 | havecidentmeta=1 then return 'ERROR'
   ib=word(out.ci,4)
   ip=word(out.ci,6)
   if datatype(ib,'W')\=1 | ib<1 then return 'ERROR'
   if datatype(ip,'W')\=1 | ip<1 | ip>20 | ip>ib then,
    return 'ERROR'
   scidentbytes.curnode=ib
   scidentprefix.curnode=ip
   havecidentmeta=1
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='CIDENTHEX' then do
   if havecidentmeta=0 | havecidenthex=1 then return 'ERROR'
   ih=translate(word(out.ci,3))
   ip=scidentprefix.curnode
   if length(ih)\=ip*2 then return 'ERROR'
   if verify(ih,'0123456789ABCDEF')\=0 then return 'ERROR'
   scidenthex.curnode=ih
   havecidenthex=1
  end
  else if words(out.ci)=4 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='CIDENT' & word(out.ci,3)='BLOBID' then do
   if havecidenthex=0 | havecidentid=1 then return 'ERROR'
   iid=translate(word(out.ci,4))
   if length(iid)\=40 then return 'ERROR'
   if verify(iid,'0123456789ABCDEF')\=0 then return 'ERROR'
   scidentid.curnode=iid
   havecidentid=1
  end
  else if words(out.ci)=4 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='MESSAGE' & word(out.ci,3)='BYTES' then do
   if havetree=0 | havemsg=1 | havecidentmeta=0 |,
      havecidenthex=0 | havecidentid=0 then return 'ERROR'
   mb=word(out.ci,4)
   if datatype(mb,'W')\=1 | mb<0 then return 'ERROR'
   smsgbytes.curnode=mb
   havemsg=1
  end
  else if words(out.ci)=4 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='MESSAGE' & word(out.ci,3)='BLOBID' then do
   if havemsg=0 | havemsgid=1 then return 'ERROR'
   mid=translate(word(out.ci,4))
   if length(mid)\=40 then return 'ERROR'
   if verify(mid,'0123456789ABCDEF')\=0 then return 'ERROR'
   smsgid.curnode=mid
   havemsgid=1
  end
  else if words(out.ci)=6 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='SUBJECT' & word(out.ci,3)='BYTES' &,
          word(out.ci,5)='PREFIXBYTES' then do
   if havemsg=0 | havemsgid=0 | havesubmeta=1 then return 'ERROR'
   sb=word(out.ci,4)
   sp=word(out.ci,6)
   if datatype(sb,'W')\=1 | sb<0 then return 'ERROR'
   if datatype(sp,'W')\=1 | sp<0 | sp>20 | sp>sb then,
    return 'ERROR'
   ssubbytes.curnode=sb
   ssubprefix.curnode=sp
   havesubmeta=1
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='SUBJECTHEX' then do
   if havesubmeta=0 | havesubhex=1 then return 'ERROR'
   sh=translate(word(out.ci,3))
   sp=ssubprefix.curnode
   if sp=0 then do
    if sh\='EMPTY' then return 'ERROR'
   end
   else do
    if length(sh)\=sp*2 then return 'ERROR'
    if verify(sh,'0123456789ABCDEF')\=0 then return 'ERROR'
   end
   ssubhex.curnode=sh
   havesubhex=1
  end
  else if words(out.ci)=4 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='SUBJECT' & word(out.ci,3)='BLOBID' then do
   if havesubhex=0 | havesubid=1 then return 'ERROR'
   sid=translate(word(out.ci,4))
   if length(sid)\=40 then return 'ERROR'
   if verify(sid,'0123456789ABCDEF')\=0 then return 'ERROR'
   ssubid.curnode=sid
   havesubid=1
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='PATH' & word(out.ci,3)='ABSENT' then do
   if havecommit=0 | havetree=0 | haveauthor=0 |,
      haveaidentmeta=0 | haveaidenthex=0 | haveaidentid=0 |,
      havecommitter=0 | havecidentmeta=0 | havecidenthex=0 |,
      havecidentid=0 |,
      havemsg=0 | havemsgid=0 |,
      havesubmeta=0 | havesubhex=0 | havesubid=0 |,
      havestate=1 then,
    return 'ERROR'
   spresent.curnode=0
   scommit.curnode=curcommit
   stree.curnode=curtree
   sdepth.curnode=curdepth
   havestate=1
  end
  else if words(out.ci)=7 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='PATH' & word(out.ci,3)='PRESENT' then do
   if havecommit=0 | havetree=0 | haveauthor=0 |,
      haveaidentmeta=0 | haveaidenthex=0 | haveaidentid=0 |,
      havecommitter=0 | havecidentmeta=0 | havecidenthex=0 |,
      havecidentid=0 |,
      havemsg=0 | havemsgid=0 |,
      havesubmeta=0 | havesubhex=0 | havesubid=0 |,
      havestate=1 then,
    return 'ERROR'
   if word(out.ci,4)\='TYPE' | word(out.ci,6)\='SIZE' then,
    return 'ERROR'
   curtype=word(out.ci,5)
   cursize=word(out.ci,7)
   if datatype(curtype,'W')\=1 | curtype<1 | curtype>3 then,
    return 'ERROR'
   if datatype(cursize,'W')\=1 | cursize<0 then return 'ERROR'
   curpresent=1
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='PATHOID' then do
   if curpresent\=1 | havestate=1 then return 'ERROR'
   poid=translate(word(out.ci,3))
   if length(poid)\=40 then return 'ERROR'
   if verify(poid,'0123456789ABCDEF')\=0 then return 'ERROR'
   spresent.curnode=1
   soid.curnode=poid
   stype.curnode=curtype
   ssize.curnode=cursize
   scommit.curnode=curcommit
   stree.curnode=curtree
   sdepth.curnode=curdepth
   havestate=1
  end
  else if words(out.ci)=6 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='EDGE' then do
   if word(out.ci,3)\='CHILD' | word(out.ci,5)\='PARENT' then,
    return 'ERROR'
   ec=word(out.ci,4)
   ep=word(out.ci,6)
   if datatype(ec,'W')\=1 | datatype(ep,'W')\=1 then,
    return 'ERROR'
   if ec<1 | ep<1 | ec>parsednodes | ep>parsednodes then,
    return 'ERROR'
   if ec=ep | sedgekey.ec.ep=1 then return 'ERROR'
   sedgekey.ec.ep=1
   sedgecount=sedgecount+1
   sedgechild.sedgecount=ec
   sedgeparent.sedgecount=ep
   sparentseen.ep=1
  end
  else if words(out.ci)=8 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='SLOT' then do
   if word(out.ci,3)\='CHILD' | word(out.ci,5)\='ORDINAL' |,
      word(out.ci,7)\='PARENT' then return 'ERROR'
   sc=word(out.ci,4)
   so=word(out.ci,6)
   sp=word(out.ci,8)
   if datatype(sc,'W')\=1 | datatype(so,'W')\=1 |,
      datatype(sp,'W')\=1 then return 'ERROR'
   if sc<1 | sp<1 | sc>parsednodes | sp>parsednodes then,
    return 'ERROR'
   if so<1 | so>sparents.sc then return 'ERROR'
   if sdepth.sc>=depth then return 'ERROR'
   if sc=sp | sedgekey.sc.sp\=1 then return 'ERROR'
   if sslotkey.sc.so=1 then return 'ERROR'
   sslotkey.sc.so=1
   sslotcount=sslotcount+1
   sslotchild.sslotcount=sc
   sslotord.sslotcount=so
   sslotparent.sslotcount=sp
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='SLOTS' then do
   if sslots\=-1 then return 'ERROR'
   sslots=word(out.ci,3)
   if datatype(sslots,'W')\=1 | sslots<0 then return 'ERROR'
   if sslots\=sslotcount then return 'ERROR'
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='EDGES' then do
   if sedges\=-1 then return 'ERROR'
   sedges=word(out.ci,3)
   if datatype(sedges,'W')\=1 | sedges<0 then return 'ERROR'
   if sedges\=sedgecount then return 'ERROR'
  end
  else if words(out.ci)=3 &,
          word(out.ci,1)='HISTORYDAGSTATE' &,
          word(out.ci,2)='NODES' then do
   if snodes\=-1 then return 'ERROR'
   snodes=word(out.ci,3)
   if datatype(snodes,'W')\=1 | snodes<1 then return 'ERROR'
  end
 end
 if havestate=0 | havecommit=0 | havetree=0 |,
    haveparents=0 | havefirstparent=0 | haveparentseq=0 |,
    haveauthor=0 |,
    haveaidentmeta=0 | haveaidenthex=0 |,
    haveaidentid=0 | havecommitter=0 |,
    havecidentmeta=0 | havecidenthex=0 | havecidentid=0 |,
    havemsg=0 | havemsgid=0 |,
    havesubmeta=0 | havesubhex=0 | havesubid=0 then,
    return 'ERROR'
 if snodes\=parsednodes | sedges\=sedgecount then return 'ERROR'
 if sslots\=sslotcount then return 'ERROR'
 if sparentseen.1=1 then return 'ERROR'
 do ni=1 to snodes
  if datatype(sparents.ni,'W')\=1 | sparents.ni<0 then,
   return 'ERROR'
  if datatype(suniqueparents.ni,'W')\=1 then return 'ERROR'
  if suniqueparents.ni<0 | suniqueparents.ni>sparents.ni then,
   return 'ERROR'
  if sparents.ni=0 & suniqueparents.ni\=0 then return 'ERROR'
  if sparents.ni>0 & suniqueparents.ni<1 then return 'ERROR'
  if sparents.ni=0 then do
   if sfirstparent.ni\='NONE' then return 'ERROR'
  end
  else do
   if length(sfirstparent.ni)\=40 then return 'ERROR'
   if verify(sfirstparent.ni,'0123456789ABCDEF')\=0 then,
    return 'ERROR'
  end
  if length(sparentseqid.ni)\=40 then return 'ERROR'
  if verify(sparentseqid.ni,'0123456789ABCDEF')\=0 then,
   return 'ERROR'
  if datatype(spresent.ni,'W')\=1 then return 'ERROR'
  if spresent.ni\=0 & spresent.ni\=1 then return 'ERROR'
  if datatype(sauthorwhen.ni,'W')\=1 then return 'ERROR'
  if datatype(sauthtz.ni,'W')\=1 then return 'ERROR'
  if sauthtz.ni<(-1439) | sauthtz.ni>1439 then return 'ERROR'
  if datatype(scommitwhen.ni,'W')\=1 then return 'ERROR'
  if datatype(scommittz.ni,'W')\=1 then return 'ERROR'
  if scommittz.ni<(-1439) | scommittz.ni>1439 then return 'ERROR'
  if datatype(saidentbytes.ni,'W')\=1 then return 'ERROR'
  if datatype(saidentprefix.ni,'W')\=1 then return 'ERROR'
  if saidentbytes.ni<1 | saidentprefix.ni<1 then return 'ERROR'
  if saidentprefix.ni>20 | saidentprefix.ni>saidentbytes.ni then,
   return 'ERROR'
  if datatype(scidentbytes.ni,'W')\=1 then return 'ERROR'
  if datatype(scidentprefix.ni,'W')\=1 then return 'ERROR'
  if scidentbytes.ni<1 | scidentprefix.ni<1 then return 'ERROR'
  if scidentprefix.ni>20 | scidentprefix.ni>scidentbytes.ni then,
   return 'ERROR'
  if length(saidentid.ni)\=40 then return 'ERROR'
  if verify(saidentid.ni,'0123456789ABCDEF')\=0 then return 'ERROR'
  if length(scidentid.ni)\=40 then return 'ERROR'
  if verify(scidentid.ni,'0123456789ABCDEF')\=0 then return 'ERROR'
  if datatype(smsgbytes.ni,'W')\=1 then return 'ERROR'
  if length(smsgid.ni)\=40 then return 'ERROR'
  if verify(smsgid.ni,'0123456789ABCDEF')\=0 then return 'ERROR'
  if datatype(ssubbytes.ni,'W')\=1 then return 'ERROR'
  if datatype(ssubprefix.ni,'W')\=1 then return 'ERROR'
  if ssubprefix.ni<0 | ssubprefix.ni>20 then return 'ERROR'
  if ssubprefix.ni>ssubbytes.ni then return 'ERROR'
  if length(ssubid.ni)\=40 then return 'ERROR'
  if verify(ssubid.ni,'0123456789ABCDEF')\=0 then return 'ERROR'
  if ni>1 & sparentseen.ni\=1 then return 'ERROR'
 end
 do ni=1 to snodes
  soutedges.ni=0
 end
 do ei=1 to sedgecount
  ec=sedgechild.ei
  soutedges.ec=soutedges.ec+1
 end
 do ni=1 to snodes
  sslotnodecount.ni=0
  sslotdistinct.ni=0
 end
 do si=1 to sslotcount
  sc=sslotchild.si
  sp=sslotparent.si
  sslotnodecount.sc=sslotnodecount.sc+1
  if sslotparentseen.sc.sp\=1 then do
   sslotparentseen.sc.sp=1
   sslotdistinct.sc=sslotdistinct.sc+1
  end
 end
 do ni=1 to snodes
  sfirstnode.ni=0
  if sdepth.ni<depth then do
   if soutedges.ni\=suniqueparents.ni then return 'ERROR'
   if sslotnodecount.ni\=sparents.ni then return 'ERROR'
   if sslotdistinct.ni\=suniqueparents.ni then return 'ERROR'
   if sparents.ni>0 then do
    firstmatches=0
    do ei=1 to sedgecount
     if sedgechild.ei=ni then do
      ep=sedgeparent.ei
      if scommit.ep=sfirstparent.ni then do
       firstmatches=firstmatches+1
       sfirstnode.ni=ep
      end
     end
    end
    if firstmatches\=1 then return 'ERROR'
    if sslotkey.ni.1\=1 then return 'ERROR'
    slotone=0
    do si=1 to sslotcount
     if sslotchild.si=ni & sslotord.si=1 then,
      slotone=sslotparent.si
    end
    if slotone\=sfirstnode.ni then return 'ERROR'
   end
  end
  else do
   if soutedges.ni\=0 then return 'ERROR'
   if sslotnodecount.ni\=0 then return 'ERROR'
  end
 end
 return 'OK'



stateversions:
 spresentcount=0
 sabsecount=0
 do ni=1 to snodes
  if spresent.ni=1 then spresentcount=spresentcount+1
  else sabsecount=sabsecount+1
 end
 if spresentcount+sabsecount\=snodes then return 'ERROR'
 drop sverseen. sveroid. svercount. svermin. svermax.
 drop svertype. sversize. snodever.
 sversions=0
 do ni=1 to snodes
  if spresent.ni=0 then do
   snodever.ni=0
   iterate
  end
  poid=soid.ni
  vi=sverseen.poid
  if datatype(vi,'W')\=1 then do
   sversions=sversions+1
   vi=sversions
   sverseen.poid=vi
   sveroid.vi=poid
   svercount.vi=1
   svermin.vi=sdepth.ni
   svermax.vi=sdepth.ni
   svertype.vi=stype.ni
   sversize.vi=ssize.ni
   snodever.ni=vi
  end
  else do
   if svertype.vi\=stype.ni | sversize.vi\=ssize.ni then,
    return 'ERROR'
   svercount.vi=svercount.vi+1
   if sdepth.ni<svermin.vi then svermin.vi=sdepth.ni
   if sdepth.ni>svermax.vi then svermax.vi=sdepth.ni
   snodever.ni=vi
  end
 end
 vtotal=0
 do vi=1 to sversions
  vtotal=vtotal+svercount.vi
 end
 if vtotal\=spresentcount then return 'ERROR'
 do ni=1 to snodes
  if datatype(snodever.ni,'W')\=1 then return 'ERROR'
  if snodever.ni<0 | snodever.ni>sversions then return 'ERROR'
 end
 if spresentcount=snodes then slifecycle='ALLPRESENT'
 else if sabsecount=snodes then slifecycle='ALLABSENT'
 else slifecycle='MIXED'
 return 'OK'


emitnodechron:
 parse arg kind,ni
 say kind 'NODE' ni 'PARENTS' sparents.ni,
     'UNIQUE' suniqueparents.ni
 say kind 'NODE' ni 'FIRSTPARENT' sfirstparent.ni
 say kind 'NODE' ni 'PARENTSEQ BLOBID' sparentseqid.ni
 say kind 'NODE' ni 'AUTHOR TIME' sauthorwhen.ni,
     'TZMIN' sauthtz.ni
 say kind 'NODE' ni 'AIDENT BYTES' saidentbytes.ni,
     'PREFIXBYTES' saidentprefix.ni
 say kind 'NODE' ni 'AIDENTHEX' saidenthex.ni
 say kind 'NODE' ni 'AIDENT BLOBID' saidentid.ni
 say kind 'NODE' ni 'COMMITTER TIME' scommitwhen.ni,
     'TZMIN' scommittz.ni
 say kind 'NODE' ni 'CIDENT BYTES' scidentbytes.ni,
     'PREFIXBYTES' scidentprefix.ni
 say kind 'NODE' ni 'CIDENTHEX' scidenthex.ni
 say kind 'NODE' ni 'CIDENT BLOBID' scidentid.ni
 lag=scommitwhen.ni-sauthorwhen.ni
 say kind 'NODE' ni 'AUTHOR TO COMMITTER LAG SECONDS' lag
 say kind 'NODE' ni 'MESSAGE BYTES' smsgbytes.ni
 say kind 'NODE' ni 'MESSAGE BLOBID' smsgid.ni
 say kind 'NODE' ni 'SUBJECT BYTES' ssubbytes.ni,
     'PREFIXHEX' ssubhex.ni
 say kind 'NODE' ni 'SUBJECT BLOBID' ssubid.ni
 return

emitpairchron:
 parse arg kind,record,num,ec,ep
 say kind record num 'CHILDAUTHOR TIME' sauthorwhen.ec,
     'TZMIN' sauthtz.ec
 say kind record num 'PARENTAUTHOR TIME' sauthorwhen.ep,
     'TZMIN' sauthtz.ep
 say kind record num 'CAIDENT BYTES' saidentbytes.ec,
     'PREFIXBYTES' saidentprefix.ec
 say kind record num 'CAIDENTHEX' saidenthex.ec
 say kind record num 'CAIDENT BLOBID' saidentid.ec
 say kind record num 'PAIDENT BYTES' saidentbytes.ep,
     'PREFIXBYTES' saidentprefix.ep
 say kind record num 'PAIDENTHEX' saidenthex.ep
 say kind record num 'PAIDENT BLOBID' saidentid.ep
 say kind record num 'CHILDCOMMITTER TIME' scommitwhen.ec,
     'TZMIN' scommittz.ec
 say kind record num 'PARENTCOMMITTER TIME' scommitwhen.ep,
     'TZMIN' scommittz.ep
 say kind record num 'CCIDENT BYTES' scidentbytes.ec,
     'PREFIXBYTES' scidentprefix.ec
 say kind record num 'CCIDENTHEX' scidenthex.ec
 say kind record num 'CCIDENT BLOBID' scidentid.ec
 say kind record num 'PCIDENT BYTES' scidentbytes.ep,
     'PREFIXBYTES' scidentprefix.ep
 say kind record num 'PCIDENTHEX' scidenthex.ep
 say kind record num 'PCIDENT BLOBID' scidentid.ep
 adelta=sauthorwhen.ec-sauthorwhen.ep
 say kind record num 'AUTHOR DELTA SECONDS' adelta
 delta=scommitwhen.ec-scommitwhen.ep
 say kind record num 'COMMITTER DELTA SECONDS' delta
 clag=scommitwhen.ec-sauthorwhen.ec
 plag=scommitwhen.ep-sauthorwhen.ep
 say kind record num 'CHILD AUTHOR TO COMMITTER LAG SECONDS' clag
 say kind record num 'PARENT AUTHOR TO COMMITTER LAG SECONDS' plag
 say kind record num 'CHILDMESSAGE BYTES' smsgbytes.ec
 say kind record num 'CHILDMESSAGE BLOBID' smsgid.ec
 say kind record num 'PARENTMESSAGE BYTES' smsgbytes.ep
 say kind record num 'PARENTMESSAGE BLOBID' smsgid.ep
 say kind record num 'CHILDSUBJECT BYTES' ssubbytes.ec,
     'PREFIXHEX' ssubhex.ec
 say kind record num 'CHILDSUBJECT BLOBID' ssubid.ec
 say kind record num 'PARENTSUBJECT BYTES' ssubbytes.ep,
     'PREFIXHEX' ssubhex.ep
 say kind record num 'PARENTSUBJECT BLOBID' ssubid.ep
 return

stateemit:
 call stateversions
 if result\='OK' then return 8
 call emitverified
 say 'HISTORYSTATE FULL SNAPSHOTS VERIFIED'
 say 'HISTORYSTATE DATA BEGIN'
 say 'HISTORYSTATE STATUS' slifecycle
 say 'HISTORYSTATE PRESENT' spresentcount
 say 'HISTORYSTATE ABSENT' sabsecount
 say 'HISTORYSTATE VERSIONS' sversions
 do vi=1 to sversions
  say 'HISTORYSTATE VERSION' vi 'OID' sveroid.vi,
      'COUNT' svercount.vi 'MINDEPTH' svermin.vi,
      'MAXDEPTH' svermax.vi
  say 'HISTORYSTATE VERSION' vi 'TYPE' svertype.vi,
      'SIZE' sversize.vi
 end
 say 'HISTORYSTATE NODES' snodes
 say 'HISTORYSTATE EDGES' sedgecount
 do ni=1 to snodes
  say 'HISTORYSTATE NODE' ni 'DEPTH' sdepth.ni
  say 'HISTORYSTATE NODE' ni 'COMMIT' scommit.ni
  say 'HISTORYSTATE NODE' ni 'TREE' stree.ni
  call emitnodechron 'HISTORYSTATE',ni
  if spresent.ni=1 then ns='PRESENT'
  else ns='ABSENT'
  say 'HISTORYSTATE NODE' ni 'STATE' ns
  if spresent.ni=1 then do
   say 'HISTORYSTATE NODE' ni 'OID' soid.ni
   say 'HISTORYSTATE NODE' ni 'TYPE' stype.ni 'SIZE' ssize.ni
  end
 end
 do ei=1 to sedgecount
  say 'HISTORYSTATE EDGE' ei 'CHILD' sedgechild.ei,
      'PARENT' sedgeparent.ei
 end
 say 'HISTORYSTATE DATA END'
 return 0




stateclass:
 call stateversions
 if result\='OK' then return 'ERROR'
 drop sstatus.
 sadd=0
 sdelete=0
 smodify=0
 sunchanged=0
 schanged=0
 schangemin=9
 schangemax=-1
 snearcount=0
 do ei=1 to sedgecount
  ec=sedgechild.ei
  ep=sedgeparent.ei
  cp=spresent.ec
  pp=spresent.ep
  if cp=1 & pp=1 then do
   if soid.ec=soid.ep then sstatus.ei='UNCHANGED'
   else sstatus.ei='MODIFIED'
  end
  else if cp=1 & pp=0 then sstatus.ei='ADDED'
  else if cp=0 & pp=1 then sstatus.ei='DELETED'
  else sstatus.ei='UNCHANGED'
  if sstatus.ei='ADDED' then sadd=sadd+1
  else if sstatus.ei='DELETED' then sdelete=sdelete+1
  else if sstatus.ei='MODIFIED' then smodify=smodify+1
  else sunchanged=sunchanged+1
  if sstatus.ei\='UNCHANGED' then do
   schanged=schanged+1
   cd=sdepth.ec
   if cd<schangemin then do
    schangemin=cd
    snearcount=1
   end
   else if cd=schangemin then snearcount=snearcount+1
   if cd>schangemax then schangemax=cd
  end
 end
 if sadd+sdelete+smodify+sunchanged\=sedgecount then,
  return 'ERROR'
 if schanged\=sadd+sdelete+smodify then return 'ERROR'
 if schanged+sunchanged\=sedgecount then return 'ERROR'
 if schanged=0 then do
  schangemin=-1
  schangemax=-1
  snearcount=0
  diffstatus='UNCHANGED'
 end
 else do
  if schangemin<0 | schangemin>8 then return 'ERROR'
  if schangemax<schangemin | schangemax>8 then return 'ERROR'
  if snearcount<1 | snearcount>schanged then return 'ERROR'
  diffstatus='CHANGED'
 end
 return 'OK'

statestatus:
 call stateclass
 if result\='OK' then return 8
 call statepairs
 if result\='OK' then return 8
 call emitverified
 say 'HISTORYSTATUS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYSTATUS DATA BEGIN'
 say 'HISTORYSTATUS STATUS' diffstatus
 say 'HISTORYSTATUS PATH STATUS' slifecycle
 say 'HISTORYSTATUS PRESENT' spresentcount
 say 'HISTORYSTATUS ABSENT' sabsecount
 say 'HISTORYSTATUS VERSIONS' sversions
 say 'HISTORYSTATUS TRANSITIONS' trpairs
 say 'HISTORYSTATUS CHANGED TRANSITIONS' trchanged
 say 'HISTORYSTATUS NODES' snodes
 say 'HISTORYSTATUS EDGES' sedgecount
 say 'HISTORYSTATUS CHANGED EDGES' schanged
 say 'HISTORYSTATUS ADDED EDGES' sadd
 say 'HISTORYSTATUS DELETED EDGES' sdelete
 say 'HISTORYSTATUS MODIFIED EDGES' smodify
 say 'HISTORYSTATUS UNCHANGED EDGES' sunchanged
 if schanged>0 then do
  say 'HISTORYSTATUS NEAREST CHANGE DEPTH' schangemin
  say 'HISTORYSTATUS FARTHEST CHANGE DEPTH' schangemax
  say 'HISTORYSTATUS NEAREST CHANGES' snearcount
 end
 say 'HISTORYSTATUS DATA END'
 return 0

statelog:
 call stateclass
 if result\='OK' then return 8
 call emitverified
 say 'HISTORYLOG FULL SNAPSHOTS VERIFIED'
 say 'HISTORYLOG DATA BEGIN'
 say 'HISTORYLOG NODES' snodes
 say 'HISTORYLOG EDGES' sedgecount
 say 'HISTORYLOG CHANGES' schanged
 if schanged>0 then do
  say 'HISTORYLOG NEAREST CHANGE DEPTH' schangemin
  say 'HISTORYLOG FARTHEST CHANGE DEPTH' schangemax
  say 'HISTORYLOG NEAREST CHANGES' snearcount
 end
 do ei=1 to sedgecount
  if sstatus.ei='UNCHANGED' then iterate
  ec=sedgechild.ei
  ep=sedgeparent.ei
  say 'HISTORYLOG CHANGE' ei 'STATUS' sstatus.ei
  say 'HISTORYLOG CHANGE' ei 'CHILD' ec 'PARENT' ep
  say 'HISTORYLOG CHANGE' ei 'CHILDDEPTH' sdepth.ec,
      'PARENTDEPTH' sdepth.ep
  say 'HISTORYLOG CHANGE' ei 'CHILDCOMMIT' scommit.ec
  say 'HISTORYLOG CHANGE' ei 'PARENTCOMMIT' scommit.ep
  call emitpairchron 'HISTORYLOG','CHANGE',ei,ec,ep
  if spresent.ec=1 then cs='PRESENT'
  else cs='ABSENT'
  if spresent.ep=1 then ps='PRESENT'
  else ps='ABSENT'
  say 'HISTORYLOG CHANGE' ei 'CHILDSTATE' cs,
      'PARENTSTATE' ps
  if spresent.ec=1 then do
   say 'HISTORYLOG CHANGE' ei 'CHILDOID' soid.ec
   say 'HISTORYLOG CHANGE' ei 'CHILDTYPE' stype.ec,
       'SIZE' ssize.ec
  end
  if spresent.ep=1 then do
   say 'HISTORYLOG CHANGE' ei 'PARENTOID' soid.ep
   say 'HISTORYLOG CHANGE' ei 'PARENTTYPE' stype.ep,
       'SIZE' ssize.ep
  end
 end
 say 'HISTORYLOG DATA END'
 return 0

statenear:
 call stateclass
 if result\='OK' then return 8
 call emitverified
 say 'HISTORYNEAREST FULL SNAPSHOTS VERIFIED'
 say 'HISTORYNEAREST DATA BEGIN'
 say 'HISTORYNEAREST STATUS' diffstatus
 say 'HISTORYNEAREST PATH STATUS' slifecycle
 say 'HISTORYNEAREST NODES' snodes
 say 'HISTORYNEAREST EDGES' sedgecount
 say 'HISTORYNEAREST CHANGES' schanged
 if schanged>0 then do
  say 'HISTORYNEAREST DEPTH' schangemin
  say 'HISTORYNEAREST MATCHES' snearcount
  match=0
  do ei=1 to sedgecount
   if sstatus.ei='UNCHANGED' then iterate
   ec=sedgechild.ei
   if sdepth.ec\=schangemin then iterate
   ep=sedgeparent.ei
   match=match+1
   say 'HISTORYNEAREST CHANGE' match 'EDGE' ei,
       'STATUS' sstatus.ei
   say 'HISTORYNEAREST CHANGE' match 'CHILD' ec,
       'PARENT' ep
   say 'HISTORYNEAREST CHANGE' match 'CHILDDEPTH' sdepth.ec,
       'PARENTDEPTH' sdepth.ep
   say 'HISTORYNEAREST CHANGE' match 'CHILDCOMMIT' scommit.ec
   say 'HISTORYNEAREST CHANGE' match 'PARENTCOMMIT' scommit.ep
   call emitpairchron 'HISTORYNEAREST','CHANGE',match,ec,ep
   if spresent.ec=1 then cs='PRESENT'
   else cs='ABSENT'
   if spresent.ep=1 then ps='PRESENT'
   else ps='ABSENT'
   say 'HISTORYNEAREST CHANGE' match 'CHILDSTATE' cs,
       'PARENTSTATE' ps
   if spresent.ec=1 then do
    say 'HISTORYNEAREST CHANGE' match 'CHILDOID' soid.ec
    say 'HISTORYNEAREST CHANGE' match 'CHILDTYPE' stype.ec,
        'SIZE' ssize.ec
   end
   if spresent.ep=1 then do
    say 'HISTORYNEAREST CHANGE' match 'PARENTOID' soid.ep
    say 'HISTORYNEAREST CHANGE' match 'PARENTTYPE' stype.ep,
        'SIZE' ssize.ep
   end
  end
  if match\=snearcount then return 8
 end
 say 'HISTORYNEAREST DATA END'
 return 0


statepairs:
 drop trno. trchild. trparent. trcount. trstatus.
 drop tradmin. tradmax. trcdmin. trcdmax.
 drop trapos. trazero. traneg. trcpos. trczero. trcneg.
 trpairs=0
 trtotal=0
 trchanged=0
 do ei=1 to sedgecount
  ec=sedgechild.ei
  ep=sedgeparent.ei
  cv=snodever.ec
  pv=snodever.ep
  ad=sauthorwhen.ec-sauthorwhen.ep
  cd=scommitwhen.ec-scommitwhen.ep
  tk=cv||'.'||pv
  ti=trno.tk
  if datatype(ti,'W')\=1 then do
   trpairs=trpairs+1
   ti=trpairs
   trno.tk=ti
   trchild.ti=cv
   trparent.ti=pv
   trcount.ti=0
   trapos.ti=0
   trazero.ti=0
   traneg.ti=0
   trcpos.ti=0
   trczero.ti=0
   trcneg.ti=0
   if cv=pv then trstatus.ti='UNCHANGED'
   else if cv>0 & pv=0 then trstatus.ti='ADDED'
   else if cv=0 & pv>0 then trstatus.ti='DELETED'
   else trstatus.ti='MODIFIED'
   if trstatus.ti\='UNCHANGED' then trchanged=trchanged+1
  end
  trcount.ti=trcount.ti+1
  if trcount.ti=1 then do
   tradmin.ti=ad
   tradmax.ti=ad
   trcdmin.ti=cd
   trcdmax.ti=cd
  end
  else do
   if ad<tradmin.ti then tradmin.ti=ad
   if ad>tradmax.ti then tradmax.ti=ad
   if cd<trcdmin.ti then trcdmin.ti=cd
   if cd>trcdmax.ti then trcdmax.ti=cd
  end
  if ad>0 then trapos.ti=trapos.ti+1
  else if ad=0 then trazero.ti=trazero.ti+1
  else traneg.ti=traneg.ti+1
  if cd>0 then trcpos.ti=trcpos.ti+1
  else if cd=0 then trczero.ti=trczero.ti+1
  else trcneg.ti=trcneg.ti+1
 end
 do ti=1 to trpairs
  trtotal=trtotal+trcount.ti
  if trapos.ti+trazero.ti+traneg.ti\=trcount.ti then,
   return 'ERROR'
  if trcpos.ti+trczero.ti+trcneg.ti\=trcount.ti then,
   return 'ERROR'
 end
 if trtotal\=sedgecount then return 'ERROR'
 if schanged=0 & trchanged\=0 then return 'ERROR'
 if schanged>0 & trchanged=0 then return 'ERROR'
 return 'OK'

emittranschron:
 parse arg kind,ti
 say kind 'TRANSITION' ti 'AUTHOR MIN DELTA SECONDS' tradmin.ti
 say kind 'TRANSITION' ti 'AUTHOR MAX DELTA SECONDS' tradmax.ti
 say kind 'TRANSITION' ti 'AUTHOR POSITIVE EDGES' trapos.ti
 say kind 'TRANSITION' ti 'AUTHOR ZERO EDGES' trazero.ti
 say kind 'TRANSITION' ti 'AUTHOR NEGATIVE EDGES' traneg.ti
 say kind 'TRANSITION' ti 'COMMITTER MIN DELTA SECONDS' trcdmin.ti
 say kind 'TRANSITION' ti 'COMMITTER MAX DELTA SECONDS' trcdmax.ti
 say kind 'TRANSITION' ti 'COMMITTER POSITIVE EDGES' trcpos.ti
 say kind 'TRANSITION' ti 'COMMITTER ZERO EDGES' trczero.ti
 say kind 'TRANSITION' ti 'COMMITTER NEGATIVE EDGES' trcneg.ti
 return

statetrans:
 call stateclass
 if result\='OK' then return 8
 call statepairs
 if result\='OK' then return 8
 call emitverified
 say 'HISTORYTRANSITIONS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYTRANSITIONS DATA BEGIN'
 say 'HISTORYTRANSITIONS STATUS' diffstatus
 say 'HISTORYTRANSITIONS PATH STATUS' slifecycle
 say 'HISTORYTRANSITIONS VERSIONS' sversions
 say 'HISTORYTRANSITIONS STATE 0 ABSENT'
 do vi=1 to sversions
  say 'HISTORYTRANSITIONS STATE' vi 'PRESENT OID' sveroid.vi
  say 'HISTORYTRANSITIONS STATE' vi 'TYPE' svertype.vi,
      'SIZE' sversize.vi
 end
 say 'HISTORYTRANSITIONS NODES' snodes
 say 'HISTORYTRANSITIONS EDGES' sedgecount
 say 'HISTORYTRANSITIONS TRANSITIONS' trpairs
 say 'HISTORYTRANSITIONS CHANGED TRANSITIONS' trchanged
 say 'HISTORYTRANSITIONS ADDED EDGES' sadd
 say 'HISTORYTRANSITIONS DELETED EDGES' sdelete
 say 'HISTORYTRANSITIONS MODIFIED EDGES' smodify
 say 'HISTORYTRANSITIONS UNCHANGED EDGES' sunchanged
 do ti=1 to trpairs
  cv=trchild.ti
  pv=trparent.ti
  say 'HISTORYTRANSITIONS TRANSITION' ti 'CHILDSTATE' cv,
      'PARENTSTATE' pv 'COUNT' trcount.ti
  say 'HISTORYTRANSITIONS TRANSITION' ti 'STATUS' trstatus.ti
  if cv>0 then,
   say 'HISTORYTRANSITIONS TRANSITION' ti 'CHILDOID' sveroid.cv
  if pv>0 then,
   say 'HISTORYTRANSITIONS TRANSITION' ti 'PARENTOID' sveroid.pv
  call emittranschron 'HISTORYTRANSITIONS',ti
 end
 say 'HISTORYTRANSITIONS DATA END'
 return 0




statechron:
 call stateclass
 if result\='OK' then return 8
 apos=0
 azero=0
 aneg=0
 cpos=0
 czero=0
 cneg=0
 lpos=0
 lzero=0
 lneg=0
 haveedge=0
 havenode=0
 do ni=1 to snodes
  lag=scommitwhen.ni-sauthorwhen.ni
  if lag>0 then lpos=lpos+1
  else if lag=0 then lzero=lzero+1
  else lneg=lneg+1
  if havenode=0 then do
   lagmin=lag
   lagmax=lag
   havenode=1
  end
  else do
   if lag<lagmin then lagmin=lag
   if lag>lagmax then lagmax=lag
  end
 end
 do ei=1 to sedgecount
  ec=sedgechild.ei
  ep=sedgeparent.ei
  ad=sauthorwhen.ec-sauthorwhen.ep
  cd=scommitwhen.ec-scommitwhen.ep
  if ad>0 then apos=apos+1
  else if ad=0 then azero=azero+1
  else aneg=aneg+1
  if cd>0 then cpos=cpos+1
  else if cd=0 then czero=czero+1
  else cneg=cneg+1
  if haveedge=0 then do
   admin=ad
   admax=ad
   cdmin=cd
   cdmax=cd
   haveedge=1
  end
  else do
   if ad<admin then admin=ad
   if ad>admax then admax=ad
   if cd<cdmin then cdmin=cd
   if cd>cdmax then cdmax=cd
  end
 end
 if apos+azero+aneg\=sedgecount then return 8
 if cpos+czero+cneg\=sedgecount then return 8
 if lpos+lzero+lneg\=snodes then return 8
 call emitverified
 say 'HISTORYCHRONOLOGY FULL SNAPSHOTS VERIFIED'
 say 'HISTORYCHRONOLOGY DATA BEGIN'
 say 'HISTORYCHRONOLOGY NODES' snodes
 say 'HISTORYCHRONOLOGY EDGES' sedgecount
 say 'HISTORYCHRONOLOGY AUTHOR POSITIVE EDGES' apos
 say 'HISTORYCHRONOLOGY AUTHOR ZERO EDGES' azero
 say 'HISTORYCHRONOLOGY AUTHOR NEGATIVE EDGES' aneg
 say 'HISTORYCHRONOLOGY COMMITTER POSITIVE EDGES' cpos
 say 'HISTORYCHRONOLOGY COMMITTER ZERO EDGES' czero
 say 'HISTORYCHRONOLOGY COMMITTER NEGATIVE EDGES' cneg
 if haveedge then do
  say 'HISTORYCHRONOLOGY AUTHOR MIN DELTA SECONDS' admin
  say 'HISTORYCHRONOLOGY AUTHOR MAX DELTA SECONDS' admax
  say 'HISTORYCHRONOLOGY COMMITTER MIN DELTA SECONDS' cdmin
  say 'HISTORYCHRONOLOGY COMMITTER MAX DELTA SECONDS' cdmax
 end
 say 'HISTORYCHRONOLOGY LAG POSITIVE NODES' lpos
 say 'HISTORYCHRONOLOGY LAG ZERO NODES' lzero
 say 'HISTORYCHRONOLOGY LAG NEGATIVE NODES' lneg
 if havenode then do
  say 'HISTORYCHRONOLOGY LAG MIN SECONDS' lagmin
  say 'HISTORYCHRONOLOGY LAG MAX SECONDS' lagmax
 end
 say 'HISTORYCHRONOLOGY DATA END'
 return 0

statebounds:
 call stateclass
 if result\='OK' then return 8
 call emitverified
 say 'HISTORYBOUNDS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYBOUNDS DATA BEGIN'
 say 'HISTORYBOUNDS STATUS' diffstatus
 say 'HISTORYBOUNDS PATH STATUS' slifecycle
 say 'HISTORYBOUNDS NODES' snodes
 say 'HISTORYBOUNDS EDGES' sedgecount
 say 'HISTORYBOUNDS CHANGES' schanged
 if schanged>0 then do
  farcount=0
  boundcount=0
  do ei=1 to sedgecount
   if sstatus.ei='UNCHANGED' then iterate
   ec=sedgechild.ei
   if sdepth.ec=schangemax then farcount=farcount+1
   if sdepth.ec=schangemin | sdepth.ec=schangemax then,
    boundcount=boundcount+1
  end
  if farcount<1 | farcount>schanged then return 8
  if boundcount<1 | boundcount>schanged then return 8
  say 'HISTORYBOUNDS NEAREST DEPTH' schangemin
  say 'HISTORYBOUNDS NEAREST MATCHES' snearcount
  say 'HISTORYBOUNDS FARTHEST DEPTH' schangemax
  say 'HISTORYBOUNDS FARTHEST MATCHES' farcount
  say 'HISTORYBOUNDS BOUNDARY CHANGES' boundcount
  match=0
  do ei=1 to sedgecount
   if sstatus.ei='UNCHANGED' then iterate
   ec=sedgechild.ei
   if sdepth.ec\=schangemin & sdepth.ec\=schangemax then,
    iterate
   ep=sedgeparent.ei
   match=match+1
   if schangemin=schangemax then bound='BOTH'
   else if sdepth.ec=schangemin then bound='NEAREST'
   else bound='FARTHEST'
   say 'HISTORYBOUNDS CHANGE' match 'EDGE' ei 'BOUND' bound
   say 'HISTORYBOUNDS CHANGE' match 'STATUS' sstatus.ei
   say 'HISTORYBOUNDS CHANGE' match 'CHILD' ec 'PARENT' ep
   say 'HISTORYBOUNDS CHANGE' match 'CHILDDEPTH' sdepth.ec,
       'PARENTDEPTH' sdepth.ep
   say 'HISTORYBOUNDS CHANGE' match 'CHILDCOMMIT' scommit.ec
   say 'HISTORYBOUNDS CHANGE' match 'PARENTCOMMIT' scommit.ep
   call emitpairchron 'HISTORYBOUNDS','CHANGE',match,ec,ep
   if spresent.ec=1 then cs='PRESENT'
   else cs='ABSENT'
   if spresent.ep=1 then ps='PRESENT'
   else ps='ABSENT'
   say 'HISTORYBOUNDS CHANGE' match 'CHILDSTATE' cs,
       'PARENTSTATE' ps
   if spresent.ec=1 then do
    say 'HISTORYBOUNDS CHANGE' match 'CHILDOID' soid.ec
    say 'HISTORYBOUNDS CHANGE' match 'CHILDTYPE' stype.ec,
        'SIZE' ssize.ec
   end
   if spresent.ep=1 then do
    say 'HISTORYBOUNDS CHANGE' match 'PARENTOID' soid.ep
    say 'HISTORYBOUNDS CHANGE' match 'PARENTTYPE' stype.ep,
        'SIZE' ssize.ep
   end
  end
  if match\=boundcount then return 8
 end
 say 'HISTORYBOUNDS DATA END'
 return 0

statereport:
 call stateclass
 if result\='OK' then return 8
 call statepairs
 if result\='OK' then return 8
 call emitverified
 say 'HISTORYREPORT FULL SNAPSHOTS VERIFIED'
 say 'HISTORYREPORT DATA BEGIN'
 say 'HISTORYREPORT STATUS' diffstatus
 say 'HISTORYREPORT PATH STATUS' slifecycle
 say 'HISTORYREPORT PRESENT' spresentcount
 say 'HISTORYREPORT ABSENT' sabsecount
 say 'HISTORYREPORT VERSIONS' sversions
 say 'HISTORYREPORT STATE 0 ABSENT'
 do vi=1 to sversions
  say 'HISTORYREPORT STATE' vi 'PRESENT OID' sveroid.vi
  say 'HISTORYREPORT STATE' vi 'TYPE' svertype.vi,
      'SIZE' sversize.vi
  say 'HISTORYREPORT STATE' vi 'COUNT' svercount.vi,
      'MINDEPTH' svermin.vi 'MAXDEPTH' svermax.vi
 end
 say 'HISTORYREPORT NODES' snodes
 say 'HISTORYREPORT EDGES' sedgecount
 say 'HISTORYREPORT TRANSITIONS' trpairs
 say 'HISTORYREPORT CHANGED TRANSITIONS' trchanged
 say 'HISTORYREPORT CHANGED EDGES' schanged
 say 'HISTORYREPORT ADDED EDGES' sadd
 say 'HISTORYREPORT DELETED EDGES' sdelete
 say 'HISTORYREPORT MODIFIED EDGES' smodify
 say 'HISTORYREPORT UNCHANGED EDGES' sunchanged
 if schanged>0 then do
  say 'HISTORYREPORT NEAREST CHANGE DEPTH' schangemin
  say 'HISTORYREPORT FARTHEST CHANGE DEPTH' schangemax
  say 'HISTORYREPORT NEAREST CHANGES' snearcount
 end
 do ti=1 to trpairs
  cv=trchild.ti
  pv=trparent.ti
  say 'HISTORYREPORT TRANSITION' ti 'CHILDSTATE' cv,
      'PARENTSTATE' pv 'COUNT' trcount.ti
  say 'HISTORYREPORT TRANSITION' ti 'STATUS' trstatus.ti
  if cv>0 then,
   say 'HISTORYREPORT TRANSITION' ti 'CHILDOID' sveroid.cv
  if pv>0 then,
   say 'HISTORYREPORT TRANSITION' ti 'PARENTOID' sveroid.pv
  call emittranschron 'HISTORYREPORT',ti
 end
 change=0
 do ei=1 to sedgecount
  if sstatus.ei='UNCHANGED' then iterate
  ec=sedgechild.ei
  ep=sedgeparent.ei
  change=change+1
  say 'HISTORYREPORT CHANGE' change 'EDGE' ei,
      'STATUS' sstatus.ei
  say 'HISTORYREPORT CHANGE' change 'CHILD' ec 'PARENT' ep
  say 'HISTORYREPORT CHANGE' change 'CHILDDEPTH' sdepth.ec,
      'PARENTDEPTH' sdepth.ep
  say 'HISTORYREPORT CHANGE' change 'CHILDCOMMIT' scommit.ec
  say 'HISTORYREPORT CHANGE' change 'PARENTCOMMIT' scommit.ep
  call emitpairchron 'HISTORYREPORT','CHANGE',change,ec,ep
  say 'HISTORYREPORT CHANGE' change 'CHILDTREE' stree.ec
  say 'HISTORYREPORT CHANGE' change 'PARENTTREE' stree.ep
  if spresent.ec=1 then cs='PRESENT'
  else cs='ABSENT'
  if spresent.ep=1 then ps='PRESENT'
  else ps='ABSENT'
  say 'HISTORYREPORT CHANGE' change 'CHILDSTATE' cs,
      'PARENTSTATE' ps
  if spresent.ec=1 then do
   say 'HISTORYREPORT CHANGE' change 'CHILDOID' soid.ec
   say 'HISTORYREPORT CHANGE' change 'CHILDTYPE' stype.ec,
       'SIZE' ssize.ec
  end
  if spresent.ep=1 then do
   say 'HISTORYREPORT CHANGE' change 'PARENTOID' soid.ep
   say 'HISTORYREPORT CHANGE' change 'PARENTTYPE' stype.ep,
       'SIZE' ssize.ep
  end
 end
 if change\=schanged then return 8
 say 'HISTORYREPORT DATA END'
 return 0

statediff:
 call stateclass
 if result\='OK' then return 8
 call statepairs
 if result\='OK' then return 8
 call emitverified
 say 'HISTORYDIFFS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYDIFFS DATA BEGIN'
 say 'HISTORYDIFFS STATUS' diffstatus
 say 'HISTORYDIFFS PATH STATUS' slifecycle
 say 'HISTORYDIFFS PRESENT' spresentcount
 say 'HISTORYDIFFS ABSENT' sabsecount
 say 'HISTORYDIFFS VERSIONS' sversions
 do vi=1 to sversions
  say 'HISTORYDIFFS VERSION' vi 'OID' sveroid.vi,
      'COUNT' svercount.vi 'MINDEPTH' svermin.vi,
      'MAXDEPTH' svermax.vi
  say 'HISTORYDIFFS VERSION' vi 'TYPE' svertype.vi,
      'SIZE' sversize.vi
 end
 say 'HISTORYDIFFS NODES' snodes
 say 'HISTORYDIFFS EDGES' sedgecount
 say 'HISTORYDIFFS TRANSITIONS' trpairs
 say 'HISTORYDIFFS CHANGED TRANSITIONS' trchanged
 do ti=1 to trpairs
  cv=trchild.ti
  pv=trparent.ti
  say 'HISTORYDIFFS TRANSITION' ti 'CHILDSTATE' cv,
      'PARENTSTATE' pv 'COUNT' trcount.ti
  say 'HISTORYDIFFS TRANSITION' ti 'STATUS' trstatus.ti
  if cv>0 then,
   say 'HISTORYDIFFS TRANSITION' ti 'CHILDOID' sveroid.cv
  if pv>0 then,
   say 'HISTORYDIFFS TRANSITION' ti 'PARENTOID' sveroid.pv
  call emittranschron 'HISTORYDIFFS',ti
 end
 say 'HISTORYDIFFS CHANGED EDGES' schanged
 say 'HISTORYDIFFS ADDED EDGES' sadd
 say 'HISTORYDIFFS DELETED EDGES' sdelete
 say 'HISTORYDIFFS MODIFIED EDGES' smodify
 say 'HISTORYDIFFS UNCHANGED EDGES' sunchanged
 if schanged>0 then do
  say 'HISTORYDIFFS NEAREST CHANGE DEPTH' schangemin
  say 'HISTORYDIFFS FARTHEST CHANGE DEPTH' schangemax
  say 'HISTORYDIFFS NEAREST CHANGES' snearcount
 end
 do ei=1 to sedgecount
  if sstatus.ei='UNCHANGED' then iterate
  ec=sedgechild.ei
  ep=sedgeparent.ei
  say 'HISTORYDIFFS EDGE' ei 'CHILD' ec 'PARENT' ep
  if spresent.ec=1 then cs='PRESENT'
  else cs='ABSENT'
  if spresent.ep=1 then ps='PRESENT'
  else ps='ABSENT'
  say 'HISTORYDIFFS EDGE' ei 'CHILDSTATE' cs,
      'PARENTSTATE' ps
  say 'HISTORYDIFFS EDGE' ei 'CHILDDEPTH' sdepth.ec
  say 'HISTORYDIFFS EDGE' ei 'PARENTDEPTH' sdepth.ep
  say 'HISTORYDIFFS EDGE' ei 'CHILDCOMMIT' scommit.ec
  say 'HISTORYDIFFS EDGE' ei 'PARENTCOMMIT' scommit.ep
  call emitpairchron 'HISTORYDIFFS','EDGE',ei,ec,ep
  say 'HISTORYDIFFS EDGE' ei 'CHILDTREE' stree.ec
  say 'HISTORYDIFFS EDGE' ei 'PARENTTREE' stree.ep
  if spresent.ec=1 then do
   say 'HISTORYDIFFS EDGE' ei 'CHILDOID' soid.ec
   say 'HISTORYDIFFS EDGE' ei 'CHILDTYPE' stype.ec,
       'SIZE' ssize.ec
  end
  if spresent.ep=1 then do
   say 'HISTORYDIFFS EDGE' ei 'PARENTOID' soid.ep
   say 'HISTORYDIFFS EDGE' ei 'PARENTTYPE' stype.ep,
       'SIZE' ssize.ep
  end
  say 'HISTORYDIFFS EDGE' ei 'STATUS' sstatus.ei
 end
 say 'HISTORYDIFFS DATA END'
 return 0

changecheck:
 pathoids=0
 parsednodes=0
 distinct=0
 edgecount=0
 nodes=-1
 edges=-1
 drop seen. seencommit. version. freq. mindepth. maxdepth.
 drop mincommit. maxcommit. vtype. vsize. depthseen.
 drop vcommit. vdepth. vnode. vtree. nodeversion.
 drop nodecommit. nodedepth. nodetree.
 drop edgechild. edgeparent. edgekey. parentseen.
 curnode=-1
 curdepth=-1
 curcommit=''
 curtree=''
 curtype=-1
 cursize=-1
 havecommit=1
 havetree=1
 havemeta=1
 havepath=1
 do ci=1 to out.0
  if left(out.ci,20)='HISTORYDAGPATH NODE ' then do
   if havepath=0 | havecommit=0 | havetree=0 | havemeta=0 then,
    return 'ERROR'
   parsednodes=parsednodes+1
   curnode=word(out.ci,3)
   if datatype(curnode,'W')\=1 then return 'ERROR'
   if curnode\=parsednodes | curnode>64 then return 'ERROR'
   havecommit=0
   havetree=0
   havemeta=0
   havepath=0
   curcommit=''
   curtree=''
   curtype=-1
   cursize=-1
   curdepth=word(out.ci,5)
   if datatype(curdepth,'W')\=1 then return 'ERROR'
   if curdepth<0 | curdepth>8 then return 'ERROR'
  end
  if left(out.ci,22)='HISTORYDAGPATH COMMIT ' then do
   if havecommit=1 | curnode<1 then return 'ERROR'
   curcommit=translate(word(out.ci,3))
   if length(curcommit)\=40 then return 'ERROR'
   if verify(curcommit,'0123456789ABCDEF')\=0 then return 'ERROR'
   if seencommit.curcommit=1 then return 'ERROR'
   seencommit.curcommit=1
   havecommit=1
  end
  if left(out.ci,20)='HISTORYDAGPATH TREE ' then do
   if havetree=1 | havecommit=0 then return 'ERROR'
   curtree=translate(word(out.ci,3))
   if length(curtree)\=40 then return 'ERROR'
   if verify(curtree,'0123456789ABCDEF')\=0 then return 'ERROR'
   havetree=1
  end
  if left(out.ci,25)='HISTORYDAGPATH PATH TYPE ' then do
   if havemeta=1 | havecommit=0 | havetree=0 then return 'ERROR'
   if word(out.ci,5)\='SIZE' then return 'ERROR'
   curtype=word(out.ci,4)
   cursize=word(out.ci,6)
   if datatype(curtype,'W')\=1 then return 'ERROR'
   if curtype<1 | curtype>3 then return 'ERROR'
   if datatype(cursize,'W')\=1 | cursize<0 then return 'ERROR'
   havemeta=1
  end
  if left(out.ci,23)='HISTORYDAGPATH PATHOID ' then do
   if havepath=1 then return 'ERROR'
   poid=translate(word(out.ci,3))
   if length(poid)\=40 then return 'ERROR'
   if verify(poid,'0123456789ABCDEF')\=0 then return 'ERROR'
   if curnode<1 | curdepth<0 | havecommit=0 | havetree=0 |,
      havemeta=0 then return 'ERROR'
   havepath=1
   pathoids=pathoids+1
   vi=seen.poid
   if datatype(vi,'W')\=1 then do
    distinct=distinct+1
    seen.poid=distinct
    vi=distinct
    version.distinct=poid
    freq.distinct=1
    mindepth.distinct=curdepth
    maxdepth.distinct=curdepth
    mincommit.distinct=curcommit
    maxcommit.distinct=curcommit
    vtype.distinct=curtype
    vsize.distinct=cursize
    depthseen.distinct.curdepth=1
    vcommit.distinct.1=curcommit
    vdepth.distinct.1=curdepth
    vnode.distinct.1=curnode
    vtree.distinct.1=curtree
   end
   else do
    if vtype.vi\=curtype | vsize.vi\=cursize then return 'ERROR'
    freq.vi=freq.vi+1
    depthseen.vi.curdepth=1
    vcidx=freq.vi
    vcommit.vi.vcidx=curcommit
    vdepth.vi.vcidx=curdepth
    vnode.vi.vcidx=curnode
    vtree.vi.vcidx=curtree
    if curdepth<mindepth.vi then do
     mindepth.vi=curdepth
     mincommit.vi=curcommit
    end
    if curdepth>maxdepth.vi then do
     maxdepth.vi=curdepth
     maxcommit.vi=curcommit
    end
   end
   nodeversion.curnode=vi
   nodecommit.curnode=curcommit
   nodedepth.curnode=curdepth
   nodetree.curnode=curtree
  end
  if words(out.ci)=6 & word(out.ci,1)='HISTORYDAGPATH' &,
     word(out.ci,2)='EDGE' then do
   if word(out.ci,3)\='CHILD' | word(out.ci,5)\='PARENT' then,
    return 'ERROR'
   ec=word(out.ci,4)
   ep=word(out.ci,6)
   if datatype(ec,'W')\=1 | datatype(ep,'W')\=1 then return 'ERROR'
   if ec<1 | ep<1 | ec>parsednodes | ep>parsednodes then return 'ERROR'
   if ec=ep then return 'ERROR'
   if edgekey.ec.ep=1 then return 'ERROR'
   edgekey.ec.ep=1
   edgecount=edgecount+1
   edgechild.edgecount=ec
   edgeparent.edgecount=ep
   parentseen.ep=1
  end
  if words(out.ci)=3 & word(out.ci,1)='HISTORYDAGPATH' &,
     word(out.ci,2)='EDGES' then do
   if edges\=-1 then return 'ERROR'
   edges=word(out.ci,3)
   if datatype(edges,'W')\=1 | edges<0 then return 'ERROR'
   if edges\=edgecount then return 'ERROR'
  end
  if left(out.ci,21)='HISTORYDAGPATH NODES ' then do
   if nodes\=-1 then return 'ERROR'
   nodes=word(out.ci,3)
   if datatype(nodes,'W')\=1 | nodes<1 then return 'ERROR'
  end
 end
 if havepath=0 | havecommit=0 | havetree=0 | havemeta=0 then,
  return 'ERROR'
 if edges<0 | edges\=edgecount then return 'ERROR'
 if nodes<1 | pathoids\=nodes then return 'ERROR'
 if parsednodes\=nodes then return 'ERROR'
 if parentseen.1=1 then return 'ERROR'
 do ni=2 to nodes
  if parentseen.ni\=1 then return 'ERROR'
 end
 return 'OK'

depthlist:
 parse arg dv
 dl=''
 do dd=0 to 8
  if depthseen.dv.dd=1 then do
   if dl='' then dl=dd
   else dl=dl||','||dd
  end
 end
 if dl='' then return 'ERROR'
 return dl

readrefs:
 drop rr. refname. refoid.
 headref=''
 refcount=0
 'EXECIO * DISKR GITREF2 REPO A 1 (STEM RR. FINIS'
 if rc\=0 then do
  say 'GITVREF: GITREF2 REPO A not found'
  return 'ERROR'
 end
 if rr.0<3 | rr.1\='REF2 1' then do
  say 'GITVREF: invalid REF2 header'
  return 'ERROR'
 end
 do i=2 to rr.0
  if word(rr.i,1)='HEAD' then do
   if words(rr.i)\=2 | headref\='' then return 'ERROR'
   headref=word(rr.i,2)
  end
  else if word(rr.i,1)='REF' then do
   if words(rr.i)\=3 then return 'ERROR'
   name=word(rr.i,2)
   oid=translate(word(rr.i,3))
   if left(name,11)\='refs/heads/' then return 'ERROR'
   if length(oid)\=40 then return 'ERROR'
   if verify(oid,'0123456789ABCDEF')\=0 then return 'ERROR'
   do j=1 to refcount
    if refname.j=name then return 'ERROR'
   end
   refcount=refcount+1
   refname.refcount=name
   refoid.refcount=oid
  end
  else return 'ERROR'
 end
 if left(headref,11)\='refs/heads/' then return 'ERROR'
 return 'OK'

resolve:
 parse arg wanted
 rawwanted=wanted
 if translate(wanted)='HEAD' then wanted=headref
 else if left(wanted,11)\='refs/heads/' then,
  wanted='refs/heads/'||wanted
 do i=1 to refcount
  if refname.i=wanted then do
   reskind='REF'
   return refoid.i
  end
 end
 direct=translate(rawwanted)
 if length(direct)=40 & verify(direct,'0123456789ABCDEF')=0 then do
  call directinput command
  if result=1 then do
   reskind='COMMIT'
   return direct
  end
 end
 say 'GITVREF: ref not found' wanted
 return 'ERROR'

directinput:
 parse arg c
 if c='SHOW' | c='LOG' | c='DAG' | c='READ' | c='DIR' then,
  return 1
 if left(c,4)='HIST' then return 1
 return 0

emitverified:
 if reskind='COMMIT' then say 'VERIFIED COMMIT' oid
 else say 'VERIFIED REF' spec oid
 return

buildfirstparent:
 drop fpseen. fpnode.
 fpcount=1
 fpnode.1=1
 fpseen.1=1
 cur=1
 truncated=0
 do forever
  if sdepth.cur>=depth then do
   if sparents.cur>0 then truncated=1
   leave
  end
  if sparents.cur=0 then leave
  next=sfirstnode.cur
  if datatype(next,'W')\=1 | next<1 | next>snodes then,
   return 'ERROR'
  if fpseen.next=1 then return 'ERROR'
  edgeok=0
  do ei=1 to sedgecount
   if sedgechild.ei=cur & sedgeparent.ei=next then do
    edgeok=1
    leave
   end
  end
  if edgeok=0 then return 'ERROR'
  fpcount=fpcount+1
  fpnode.fpcount=next
  fpseen.next=1
  cur=next
 end
 chainedges=fpcount-1
 offnodes=snodes-fpcount
 offedges=sedgecount-chainedges
 if offnodes<0 | offedges<0 then return 'ERROR'
 return 'OK'

statefirstparent:
 call buildfirstparent
 if result\='OK' then return 8
 call emitverified
 say 'HISTORYFIRSTPARENT FULL SNAPSHOTS VERIFIED'
 say 'HISTORYFIRSTPARENT DATA BEGIN'
 say 'HISTORYFIRSTPARENT NODES' snodes
 say 'HISTORYFIRSTPARENT EDGES' sedgecount
 say 'HISTORYFIRSTPARENT CHAIN NODES' fpcount
 say 'HISTORYFIRSTPARENT CHAIN EDGES' chainedges
 say 'HISTORYFIRSTPARENT OFFCHAIN NODES' offnodes
 say 'HISTORYFIRSTPARENT OFFCHAIN EDGES' offedges
 say 'HISTORYFIRSTPARENT TRUNCATED' truncated
 do fi=1 to fpcount
  ni=fpnode.fi
  say 'HISTORYFIRSTPARENT STEP' fi 'NODE' ni,
      'DEPTH' sdepth.ni
  say 'HISTORYFIRSTPARENT STEP' fi 'COMMIT' scommit.ni
 end
 say 'HISTORYFIRSTPARENT DATA END'
 return 0



statefirstlog:
 call buildfirstparent
 if result\='OK' then return 8
 call emitverified
 say 'HISTORYFIRSTLOG FULL SNAPSHOTS VERIFIED'
 say 'HISTORYFIRSTLOG DATA BEGIN'
 say 'HISTORYFIRSTLOG NODES' snodes
 say 'HISTORYFIRSTLOG EDGES' sedgecount
 say 'HISTORYFIRSTLOG CHAIN NODES' fpcount
 say 'HISTORYFIRSTLOG CHAIN EDGES' chainedges
 say 'HISTORYFIRSTLOG OFFCHAIN NODES' offnodes
 say 'HISTORYFIRSTLOG OFFCHAIN EDGES' offedges
 say 'HISTORYFIRSTLOG TRUNCATED' truncated
 do fi=1 to fpcount
  ni=fpnode.fi
  say 'HISTORYFIRSTLOG STEP' fi 'NODE' ni 'DEPTH' sdepth.ni
  say 'HISTORYFIRSTLOG STEP' fi 'COMMIT' scommit.ni
  say 'HISTORYFIRSTLOG STEP' fi 'TREE' stree.ni
  call emitnodechron 'HISTORYFIRSTLOG',ni
  if spresent.ni=1 then ns='PRESENT'
  else ns='ABSENT'
  say 'HISTORYFIRSTLOG NODE' ni 'STATE' ns
  if spresent.ni=1 then do
   say 'HISTORYFIRSTLOG NODE' ni 'OID' soid.ni
   say 'HISTORYFIRSTLOG NODE' ni 'TYPE' stype.ni,
       'SIZE' ssize.ni
  end
 end
 say 'HISTORYFIRSTLOG DATA END'
 return 0


statefirstreport:
 call buildfirstparent
 if result\='OK' then return 8
 drop frstatus.
 fradd=0
 frdelete=0
 frmodify=0
 frunchanged=0
 frauthsame=0
 frauthchanged=0
 frcommsame=0
 frcommchanged=0
 frsubsame=0
 frsubchanged=0
 frbodysame=0
 frbodychanged=0
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  cp=spresent.ec
  pp=spresent.ep
  if cp=1 & pp=1 then do
   if soid.ec=soid.ep then frstatus.fi='UNCHANGED'
   else frstatus.fi='MODIFIED'
  end
  else if cp=1 & pp=0 then frstatus.fi='ADDED'
  else if cp=0 & pp=1 then frstatus.fi='DELETED'
  else frstatus.fi='UNCHANGED'
  if frstatus.fi='ADDED' then fradd=fradd+1
  else if frstatus.fi='DELETED' then frdelete=frdelete+1
  else if frstatus.fi='MODIFIED' then frmodify=frmodify+1
  else frunchanged=frunchanged+1
  if saidentid.ec=saidentid.ep then frauthsame=frauthsame+1
  else frauthchanged=frauthchanged+1
  if scidentid.ec=scidentid.ep then frcommsame=frcommsame+1
  else frcommchanged=frcommchanged+1
  if ssubid.ec=ssubid.ep then frsubsame=frsubsame+1
  else frsubchanged=frsubchanged+1
  if smsgid.ec=smsgid.ep then frbodysame=frbodysame+1
  else frbodychanged=frbodychanged+1
 end
 if fradd+frdelete+frmodify+frunchanged\=chainedges then return 8
 if frauthsame+frauthchanged\=chainedges then return 8
 if frcommsame+frcommchanged\=chainedges then return 8
 if frsubsame+frsubchanged\=chainedges then return 8
 if frbodysame+frbodychanged\=chainedges then return 8
 call emitverified
 say 'HISTORYFIRSTREPORT FULL SNAPSHOTS VERIFIED'
 say 'HISTORYFIRSTREPORT DATA BEGIN'
 say 'HISTORYFIRSTREPORT NODES' snodes
 say 'HISTORYFIRSTREPORT EDGES' sedgecount
 say 'HISTORYFIRSTREPORT CHAIN NODES' fpcount
 say 'HISTORYFIRSTREPORT CHAIN EDGES' chainedges
 say 'HISTORYFIRSTREPORT OFFCHAIN NODES' offnodes
 say 'HISTORYFIRSTREPORT OFFCHAIN EDGES' offedges
 say 'HISTORYFIRSTREPORT TRUNCATED' truncated
 say 'HISTORYFIRSTREPORT ADDED EDGES' fradd
 say 'HISTORYFIRSTREPORT DELETED EDGES' frdelete
 say 'HISTORYFIRSTREPORT MODIFIED EDGES' frmodify
 say 'HISTORYFIRSTREPORT UNCHANGED EDGES' frunchanged
 say 'HISTORYFIRSTREPORT AUTHOR SAME EDGES' frauthsame
 say 'HISTORYFIRSTREPORT AUTHOR CHANGED EDGES' frauthchanged
 say 'HISTORYFIRSTREPORT COMMITTER SAME EDGES' frcommsame
 say 'HISTORYFIRSTREPORT COMMITTER CHANGED EDGES' frcommchanged
 say 'HISTORYFIRSTREPORT SUBJECT SAME EDGES' frsubsame
 say 'HISTORYFIRSTREPORT SUBJECT CHANGED EDGES' frsubchanged
 say 'HISTORYFIRSTREPORT MESSAGE SAME EDGES' frbodysame
 say 'HISTORYFIRSTREPORT MESSAGE CHANGED EDGES' frbodychanged
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  say 'HISTORYFIRSTREPORT EDGE' fi 'CHILD' ec 'PARENT' ep
  say 'HISTORYFIRSTREPORT EDGE' fi 'STATUS' frstatus.fi
  say 'HISTORYFIRSTREPORT EDGE' fi 'CHILDDEPTH' sdepth.ec,
      'PARENTDEPTH' sdepth.ep
  say 'HISTORYFIRSTREPORT EDGE' fi 'CHILDCOMMIT' scommit.ec
  say 'HISTORYFIRSTREPORT EDGE' fi 'PARENTCOMMIT' scommit.ep
  say 'HISTORYFIRSTREPORT EDGE' fi 'CHILDTREE' stree.ec
  say 'HISTORYFIRSTREPORT EDGE' fi 'PARENTTREE' stree.ep
  if spresent.ec=1 then cs='PRESENT'
  else cs='ABSENT'
  if spresent.ep=1 then ps='PRESENT'
  else ps='ABSENT'
  say 'HISTORYFIRSTREPORT EDGE' fi 'CHILDSTATE' cs,
      'PARENTSTATE' ps
  if spresent.ec=1 then do
   say 'HISTORYFIRSTREPORT EDGE' fi 'CHILDOID' soid.ec
   say 'HISTORYFIRSTREPORT EDGE' fi 'CHILDTYPE' stype.ec,
       'SIZE' ssize.ec
  end
  if spresent.ep=1 then do
   say 'HISTORYFIRSTREPORT EDGE' fi 'PARENTOID' soid.ep
   say 'HISTORYFIRSTREPORT EDGE' fi 'PARENTTYPE' stype.ep,
       'SIZE' ssize.ep
  end
  if saidentid.ec=saidentid.ep then ast='SAME'
  else ast='CHANGED'
  if scidentid.ec=scidentid.ep then cst='SAME'
  else cst='CHANGED'
  if ssubid.ec=ssubid.ep then sst='SAME'
  else sst='CHANGED'
  if smsgid.ec=smsgid.ep then mst='SAME'
  else mst='CHANGED'
  say 'HISTORYFIRSTREPORT EDGE' fi 'AUTHOR STATUS' ast
  say 'HISTORYFIRSTREPORT EDGE' fi 'COMMITTER STATUS' cst
  say 'HISTORYFIRSTREPORT EDGE' fi 'SUBJECT STATUS' sst
  say 'HISTORYFIRSTREPORT EDGE' fi 'MESSAGE STATUS' mst
  call emitpairchron 'HISTORYFIRSTREPORT','EDGE',fi,ec,ep
 end
 say 'HISTORYFIRSTREPORT DATA END'
 return 0

statefirstsubjects:
 call buildfirstparent
 if result\='OK' then return 8
 drop fsnum. fschild. fsparent. fscount. fsstatus.
 fshandoffs=0
 fstotal=0
 fssame=0
 fschanged=0
 fschangedpairs=0
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  cs=ssubid.ec
  ps=ssubid.ep
  sk=cs||'.'||ps
  hi=fsnum.sk
  if datatype(hi,'W')\=1 then do
   fshandoffs=fshandoffs+1
   hi=fshandoffs
   fsnum.sk=hi
   fschild.hi=cs
   fsparent.hi=ps
   fscount.hi=0
   if cs=ps then fsstatus.hi='SAME'
   else do
    fsstatus.hi='CHANGED'
    fschangedpairs=fschangedpairs+1
   end
  end
  fscount.hi=fscount.hi+1
  if fsstatus.hi='SAME' then fssame=fssame+1
  else fschanged=fschanged+1
 end
 do hi=1 to fshandoffs
  fstotal=fstotal+fscount.hi
 end
 if fstotal\=chainedges then return 8
 if fssame+fschanged\=chainedges then return 8
 if chainedges>0 & fshandoffs<1 then return 8
 call emitverified
 say 'HISTORYFIRSTSUBJECTS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYFIRSTSUBJECTS DATA BEGIN'
 say 'HISTORYFIRSTSUBJECTS NODES' snodes
 say 'HISTORYFIRSTSUBJECTS EDGES' sedgecount
 say 'HISTORYFIRSTSUBJECTS CHAIN NODES' fpcount
 say 'HISTORYFIRSTSUBJECTS CHAIN EDGES' chainedges
 say 'HISTORYFIRSTSUBJECTS OFFCHAIN NODES' offnodes
 say 'HISTORYFIRSTSUBJECTS OFFCHAIN EDGES' offedges
 say 'HISTORYFIRSTSUBJECTS TRUNCATED' truncated
 say 'HISTORYFIRSTSUBJECTS SAME EDGES' fssame
 say 'HISTORYFIRSTSUBJECTS CHANGED EDGES' fschanged
 say 'HISTORYFIRSTSUBJECTS HANDOFFS' fshandoffs
 say 'HISTORYFIRSTSUBJECTS CHANGED HANDOFFS' fschangedpairs
 do hi=1 to fshandoffs
  say 'HISTORYFIRSTSUBJECTS HANDOFF' hi,
      'CHILD BLOBID' fschild.hi
  say 'HISTORYFIRSTSUBJECTS HANDOFF' hi,
      'PARENT BLOBID' fsparent.hi
  say 'HISTORYFIRSTSUBJECTS HANDOFF' hi,
      'COUNT' fscount.hi 'STATUS' fsstatus.hi
 end
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  say 'HISTORYFIRSTSUBJECTS EDGE' fi 'CHILD' ec 'PARENT' ep
  if ssubid.ec=ssubid.ep then ss='SAME'
  else ss='CHANGED'
  say 'HISTORYFIRSTSUBJECTS EDGE' fi 'STATUS' ss
  say 'HISTORYFIRSTSUBJECTS EDGE' fi 'CHILD BLOBID' ssubid.ec
  say 'HISTORYFIRSTSUBJECTS EDGE' fi 'PARENT BLOBID' ssubid.ep
  say 'HISTORYFIRSTSUBJECTS EDGE' fi 'CHILD BYTES' ssubbytes.ec,
      'PREFIXHEX' ssubhex.ec
  say 'HISTORYFIRSTSUBJECTS EDGE' fi 'PARENT BYTES' ssubbytes.ep,
      'PREFIXHEX' ssubhex.ep
 end
 say 'HISTORYFIRSTSUBJECTS DATA END'
 return 0



statefirstbodies:
 call buildfirstparent
 if result\='OK' then return 8
 drop fbnum. fbchild. fbparent. fbcount. fbstatus.
 fbhandoffs=0
 fbtotal=0
 fbsame=0
 fbchanged=0
 fbchangedpairs=0
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  cm=smsgid.ec
  pm=smsgid.ep
  mk=cm||'.'||pm
  hi=fbnum.mk
  if datatype(hi,'W')\=1 then do
   fbhandoffs=fbhandoffs+1
   hi=fbhandoffs
   fbnum.mk=hi
   fbchild.hi=cm
   fbparent.hi=pm
   fbcount.hi=0
   if cm=pm then fbstatus.hi='SAME'
   else do
    fbstatus.hi='CHANGED'
    fbchangedpairs=fbchangedpairs+1
   end
  end
  fbcount.hi=fbcount.hi+1
  if fbstatus.hi='SAME' then fbsame=fbsame+1
  else fbchanged=fbchanged+1
 end
 do hi=1 to fbhandoffs
  fbtotal=fbtotal+fbcount.hi
 end
 if fbtotal\=chainedges then return 8
 if fbsame+fbchanged\=chainedges then return 8
 if chainedges>0 & fbhandoffs<1 then return 8
 call emitverified
 say 'HISTORYFIRSTBODIES FULL SNAPSHOTS VERIFIED'
 say 'HISTORYFIRSTBODIES DATA BEGIN'
 say 'HISTORYFIRSTBODIES NODES' snodes
 say 'HISTORYFIRSTBODIES EDGES' sedgecount
 say 'HISTORYFIRSTBODIES CHAIN NODES' fpcount
 say 'HISTORYFIRSTBODIES CHAIN EDGES' chainedges
 say 'HISTORYFIRSTBODIES OFFCHAIN NODES' offnodes
 say 'HISTORYFIRSTBODIES OFFCHAIN EDGES' offedges
 say 'HISTORYFIRSTBODIES TRUNCATED' truncated
 say 'HISTORYFIRSTBODIES SAME EDGES' fbsame
 say 'HISTORYFIRSTBODIES CHANGED EDGES' fbchanged
 say 'HISTORYFIRSTBODIES HANDOFFS' fbhandoffs
 say 'HISTORYFIRSTBODIES CHANGED HANDOFFS' fbchangedpairs
 do hi=1 to fbhandoffs
  say 'HISTORYFIRSTBODIES HANDOFF' hi,
      'CHILD BLOBID' fbchild.hi
  say 'HISTORYFIRSTBODIES HANDOFF' hi,
      'PARENT BLOBID' fbparent.hi
  say 'HISTORYFIRSTBODIES HANDOFF' hi,
      'COUNT' fbcount.hi 'STATUS' fbstatus.hi
 end
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  say 'HISTORYFIRSTBODIES EDGE' fi 'CHILD' ec 'PARENT' ep
  if smsgid.ec=smsgid.ep then ms='SAME'
  else ms='CHANGED'
  say 'HISTORYFIRSTBODIES EDGE' fi 'STATUS' ms
  say 'HISTORYFIRSTBODIES EDGE' fi 'CHILD BLOBID' smsgid.ec
  say 'HISTORYFIRSTBODIES EDGE' fi 'PARENT BLOBID' smsgid.ep
  say 'HISTORYFIRSTBODIES EDGE' fi 'CHILD BYTES' smsgbytes.ec
  say 'HISTORYFIRSTBODIES EDGE' fi 'PARENT BYTES' smsgbytes.ep
  say 'HISTORYFIRSTBODIES EDGE' fi,
      'CHILD SUBJECT BLOBID' ssubid.ec
  say 'HISTORYFIRSTBODIES EDGE' fi,
      'PARENT SUBJECT BLOBID' ssubid.ep
 end
 say 'HISTORYFIRSTBODIES DATA END'
 return 0


statefirstactors:
 call buildfirstparent
 if result\='OK' then return 8
 drop fanum. fachild. faparent. facount. fastatus.
 drop fcnum. fcchild. fcparent. fccount. fcstatus.
 fahandoffs=0
 fchandoffs=0
 fatotal=0
 fctotal=0
 fasame=0
 fachanged=0
 fcsame=0
 fcchanged=0
 fachangedpairs=0
 fcchangedpairs=0
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  ca=saidentid.ec
  pa=saidentid.ep
  ck=ca||'.'||pa
  hi=fanum.ck
  if datatype(hi,'W')\=1 then do
   fahandoffs=fahandoffs+1
   hi=fahandoffs
   fanum.ck=hi
   fachild.hi=ca
   faparent.hi=pa
   facount.hi=0
   if ca=pa then fastatus.hi='SAME'
   else do
    fastatus.hi='CHANGED'
    fachangedpairs=fachangedpairs+1
   end
  end
  facount.hi=facount.hi+1
  if fastatus.hi='SAME' then fasame=fasame+1
  else fachanged=fachanged+1

  cc=scidentid.ec
  pc=scidentid.ep
  ck=cc||'.'||pc
  hi=fcnum.ck
  if datatype(hi,'W')\=1 then do
   fchandoffs=fchandoffs+1
   hi=fchandoffs
   fcnum.ck=hi
   fcchild.hi=cc
   fcparent.hi=pc
   fccount.hi=0
   if cc=pc then fcstatus.hi='SAME'
   else do
    fcstatus.hi='CHANGED'
    fcchangedpairs=fcchangedpairs+1
   end
  end
  fccount.hi=fccount.hi+1
  if fcstatus.hi='SAME' then fcsame=fcsame+1
  else fcchanged=fcchanged+1
 end
 do hi=1 to fahandoffs
  fatotal=fatotal+facount.hi
 end
 do hi=1 to fchandoffs
  fctotal=fctotal+fccount.hi
 end
 if fatotal\=chainedges | fctotal\=chainedges then return 8
 if fasame+fachanged\=chainedges then return 8
 if fcsame+fcchanged\=chainedges then return 8
 if chainedges>0 & (fahandoffs<1 | fchandoffs<1) then return 8
 call emitverified
 say 'HISTORYFIRSTACTORS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYFIRSTACTORS DATA BEGIN'
 say 'HISTORYFIRSTACTORS NODES' snodes
 say 'HISTORYFIRSTACTORS EDGES' sedgecount
 say 'HISTORYFIRSTACTORS CHAIN NODES' fpcount
 say 'HISTORYFIRSTACTORS CHAIN EDGES' chainedges
 say 'HISTORYFIRSTACTORS OFFCHAIN NODES' offnodes
 say 'HISTORYFIRSTACTORS OFFCHAIN EDGES' offedges
 say 'HISTORYFIRSTACTORS TRUNCATED' truncated
 say 'HISTORYFIRSTACTORS AUTHOR SAME EDGES' fasame
 say 'HISTORYFIRSTACTORS AUTHOR CHANGED EDGES' fachanged
 say 'HISTORYFIRSTACTORS COMMITTER SAME EDGES' fcsame
 say 'HISTORYFIRSTACTORS COMMITTER CHANGED EDGES' fcchanged
 say 'HISTORYFIRSTACTORS AUTHOR HANDOFFS' fahandoffs
 say 'HISTORYFIRSTACTORS AUTHOR CHANGED HANDOFFS' fachangedpairs
 do hi=1 to fahandoffs
  say 'HISTORYFIRSTACTORS AUTHOR HANDOFF' hi,
      'CHILD BLOBID' fachild.hi
  say 'HISTORYFIRSTACTORS AUTHOR HANDOFF' hi,
      'PARENT BLOBID' faparent.hi
  say 'HISTORYFIRSTACTORS AUTHOR HANDOFF' hi,
      'COUNT' facount.hi 'STATUS' fastatus.hi
 end
 say 'HISTORYFIRSTACTORS COMMITTER HANDOFFS' fchandoffs
 say 'HISTORYFIRSTACTORS COMMITTER CHANGED HANDOFFS' fcchangedpairs
 do hi=1 to fchandoffs
  say 'HISTORYFIRSTACTORS COMMITTER HANDOFF' hi,
      'CHILD BLOBID' fcchild.hi
  say 'HISTORYFIRSTACTORS COMMITTER HANDOFF' hi,
      'PARENT BLOBID' fcparent.hi
  say 'HISTORYFIRSTACTORS COMMITTER HANDOFF' hi,
      'COUNT' fccount.hi 'STATUS' fcstatus.hi
 end
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  say 'HISTORYFIRSTACTORS EDGE' fi 'CHILD' ec 'PARENT' ep
  if saidentid.ec=saidentid.ep then ast='SAME'
  else ast='CHANGED'
  if scidentid.ec=scidentid.ep then cst='SAME'
  else cst='CHANGED'
  say 'HISTORYFIRSTACTORS EDGE' fi 'AUTHOR STATUS' ast
  say 'HISTORYFIRSTACTORS EDGE' fi 'AUTHOR CHILD BLOBID' saidentid.ec
  say 'HISTORYFIRSTACTORS EDGE' fi 'AUTHOR PARENT BLOBID' saidentid.ep
  say 'HISTORYFIRSTACTORS EDGE' fi 'COMMITTER STATUS' cst
  say 'HISTORYFIRSTACTORS EDGE' fi,
      'COMMITTER CHILD BLOBID' scidentid.ec
  say 'HISTORYFIRSTACTORS EDGE' fi,
      'COMMITTER PARENT BLOBID' scidentid.ep
 end
 say 'HISTORYFIRSTACTORS DATA END'
 return 0


statefirstchron:
 call buildfirstparent
 if result\='OK' then return 8
 fapos=0
 fazero=0
 faneg=0
 fcpos=0
 fczero=0
 fcneg=0
 flpos=0
 flzero=0
 flneg=0
 haveedge=0
 havenode=0
 do fi=1 to fpcount
  ni=fpnode.fi
  lag=scommitwhen.ni-sauthorwhen.ni
  if lag>0 then flpos=flpos+1
  else if lag=0 then flzero=flzero+1
  else flneg=flneg+1
  if havenode=0 then do
   flagmin=lag
   flagmax=lag
   havenode=1
  end
  else do
   if lag<flagmin then flagmin=lag
   if lag>flagmax then flagmax=lag
  end
 end
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  ad=sauthorwhen.ec-sauthorwhen.ep
  cd=scommitwhen.ec-scommitwhen.ep
  if ad>0 then fapos=fapos+1
  else if ad=0 then fazero=fazero+1
  else faneg=faneg+1
  if cd>0 then fcpos=fcpos+1
  else if cd=0 then fczero=fczero+1
  else fcneg=fcneg+1
  if haveedge=0 then do
   fadmin=ad
   fadmax=ad
   fcdmin=cd
   fcdmax=cd
   haveedge=1
  end
  else do
   if ad<fadmin then fadmin=ad
   if ad>fadmax then fadmax=ad
   if cd<fcdmin then fcdmin=cd
   if cd>fcdmax then fcdmax=cd
  end
 end
 if fapos+fazero+faneg\=chainedges then return 8
 if fcpos+fczero+fcneg\=chainedges then return 8
 if flpos+flzero+flneg\=fpcount then return 8
 call emitverified
 say 'HISTORYFIRSTCHRONOLOGY FULL SNAPSHOTS VERIFIED'
 say 'HISTORYFIRSTCHRONOLOGY DATA BEGIN'
 say 'HISTORYFIRSTCHRONOLOGY NODES' snodes
 say 'HISTORYFIRSTCHRONOLOGY EDGES' sedgecount
 say 'HISTORYFIRSTCHRONOLOGY CHAIN NODES' fpcount
 say 'HISTORYFIRSTCHRONOLOGY CHAIN EDGES' chainedges
 say 'HISTORYFIRSTCHRONOLOGY OFFCHAIN NODES' offnodes
 say 'HISTORYFIRSTCHRONOLOGY OFFCHAIN EDGES' offedges
 say 'HISTORYFIRSTCHRONOLOGY TRUNCATED' truncated
 say 'HISTORYFIRSTCHRONOLOGY AUTHOR POSITIVE EDGES' fapos
 say 'HISTORYFIRSTCHRONOLOGY AUTHOR ZERO EDGES' fazero
 say 'HISTORYFIRSTCHRONOLOGY AUTHOR NEGATIVE EDGES' faneg
 say 'HISTORYFIRSTCHRONOLOGY COMMITTER POSITIVE EDGES' fcpos
 say 'HISTORYFIRSTCHRONOLOGY COMMITTER ZERO EDGES' fczero
 say 'HISTORYFIRSTCHRONOLOGY COMMITTER NEGATIVE EDGES' fcneg
 if haveedge then do
  say 'HISTORYFIRSTCHRONOLOGY AUTHOR MIN DELTA SECONDS' fadmin
  say 'HISTORYFIRSTCHRONOLOGY AUTHOR MAX DELTA SECONDS' fadmax
  say 'HISTORYFIRSTCHRONOLOGY COMMITTER MIN DELTA SECONDS' fcdmin
  say 'HISTORYFIRSTCHRONOLOGY COMMITTER MAX DELTA SECONDS' fcdmax
 end
 say 'HISTORYFIRSTCHRONOLOGY LAG POSITIVE NODES' flpos
 say 'HISTORYFIRSTCHRONOLOGY LAG ZERO NODES' flzero
 say 'HISTORYFIRSTCHRONOLOGY LAG NEGATIVE NODES' flneg
 if havenode then do
  say 'HISTORYFIRSTCHRONOLOGY LAG MIN SECONDS' flagmin
  say 'HISTORYFIRSTCHRONOLOGY LAG MAX SECONDS' flagmax
 end
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  ad=sauthorwhen.ec-sauthorwhen.ep
  cd=scommitwhen.ec-scommitwhen.ep
  say 'HISTORYFIRSTCHRONOLOGY EDGE' fi 'CHILD' ec 'PARENT' ep
  say 'HISTORYFIRSTCHRONOLOGY EDGE' fi 'AUTHOR DELTA SECONDS' ad
  say 'HISTORYFIRSTCHRONOLOGY EDGE' fi,
      'COMMITTER DELTA SECONDS' cd
 end
 do fi=1 to fpcount
  ni=fpnode.fi
  lag=scommitwhen.ni-sauthorwhen.ni
  say 'HISTORYFIRSTCHRONOLOGY NODE' ni 'LAG SECONDS' lag
 end
 say 'HISTORYFIRSTCHRONOLOGY DATA END'
 return 0


statefirsttransitions:
 call stateversions
 if result\='OK' then return 8
 call buildfirstparent
 if result\='OK' then return 8
 drop ftno. ftchild. ftparent. ftcount. ftstatus.
 ftpairs=0
 fttotal=0
 ftchanged=0
 ftchangededges=0
 ftadd=0
 ftdelete=0
 ftmodify=0
 ftunchanged=0
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  cv=snodever.ec
  pv=snodever.ep
  if datatype(cv,'W')\=1 | datatype(pv,'W')\=1 then return 8
  if cv<0 | cv>sversions | pv<0 | pv>sversions then return 8
  tk=cv||'.'||pv
  ti=ftno.tk
  if datatype(ti,'W')\=1 then do
   ftpairs=ftpairs+1
   ti=ftpairs
   ftno.tk=ti
   ftchild.ti=cv
   ftparent.ti=pv
   ftcount.ti=0
   if cv=pv then ftstatus.ti='UNCHANGED'
   else if cv>0 & pv=0 then ftstatus.ti='ADDED'
   else if cv=0 & pv>0 then ftstatus.ti='DELETED'
   else ftstatus.ti='MODIFIED'
   if ftstatus.ti\='UNCHANGED' then ftchanged=ftchanged+1
  end
  ftcount.ti=ftcount.ti+1
  if ftstatus.ti='ADDED' then ftadd=ftadd+1
  else if ftstatus.ti='DELETED' then ftdelete=ftdelete+1
  else if ftstatus.ti='MODIFIED' then ftmodify=ftmodify+1
  else ftunchanged=ftunchanged+1
  if ftstatus.ti\='UNCHANGED' then ftchangededges=ftchangededges+1
 end
 do ti=1 to ftpairs
  fttotal=fttotal+ftcount.ti
 end
 if fttotal\=chainedges then return 8
 if ftadd+ftdelete+ftmodify+ftunchanged\=chainedges then return 8
 if ftchangededges\=ftadd+ftdelete+ftmodify then return 8
 if chainedges>0 & ftpairs<1 then return 8
 call emitverified
 say 'HISTORYFIRSTTRANSITIONS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYFIRSTTRANSITIONS DATA BEGIN'
 say 'HISTORYFIRSTTRANSITIONS NODES' snodes
 say 'HISTORYFIRSTTRANSITIONS EDGES' sedgecount
 say 'HISTORYFIRSTTRANSITIONS CHAIN NODES' fpcount
 say 'HISTORYFIRSTTRANSITIONS CHAIN EDGES' chainedges
 say 'HISTORYFIRSTTRANSITIONS OFFCHAIN NODES' offnodes
 say 'HISTORYFIRSTTRANSITIONS OFFCHAIN EDGES' offedges
 say 'HISTORYFIRSTTRANSITIONS TRUNCATED' truncated
 say 'HISTORYFIRSTTRANSITIONS VERSIONS' sversions
 say 'HISTORYFIRSTTRANSITIONS STATE 0 ABSENT'
 do vi=1 to sversions
  say 'HISTORYFIRSTTRANSITIONS STATE' vi 'PRESENT OID' sveroid.vi
  say 'HISTORYFIRSTTRANSITIONS STATE' vi 'TYPE' svertype.vi,
      'SIZE' sversize.vi
 end
 say 'HISTORYFIRSTTRANSITIONS TRANSITIONS' ftpairs
 say 'HISTORYFIRSTTRANSITIONS CHANGED TRANSITIONS' ftchanged
 say 'HISTORYFIRSTTRANSITIONS CHANGED EDGES' ftchangededges
 say 'HISTORYFIRSTTRANSITIONS ADDED EDGES' ftadd
 say 'HISTORYFIRSTTRANSITIONS DELETED EDGES' ftdelete
 say 'HISTORYFIRSTTRANSITIONS MODIFIED EDGES' ftmodify
 say 'HISTORYFIRSTTRANSITIONS UNCHANGED EDGES' ftunchanged
 do ti=1 to ftpairs
  cv=ftchild.ti
  pv=ftparent.ti
  say 'HISTORYFIRSTTRANSITIONS TRANSITION' ti 'CHILDSTATE' cv,
      'PARENTSTATE' pv 'COUNT' ftcount.ti
  say 'HISTORYFIRSTTRANSITIONS TRANSITION' ti 'STATUS' ftstatus.ti
  if cv>0 then,
   say 'HISTORYFIRSTTRANSITIONS TRANSITION' ti,
       'CHILDOID' sveroid.cv
  if pv>0 then,
   say 'HISTORYFIRSTTRANSITIONS TRANSITION' ti,
       'PARENTOID' sveroid.pv
 end
 say 'HISTORYFIRSTTRANSITIONS DATA END'
 return 0


statefirstchanges:
 call buildfirstparent
 if result\='OK' then return 8
 drop fstatus.
 fadd=0
 fdelete=0
 fmodify=0
 funchanged=0
 fchanged=0
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  cp=spresent.ec
  pp=spresent.ep
  if cp=1 & pp=1 then do
   if soid.ec=soid.ep then fstatus.fi='UNCHANGED'
   else fstatus.fi='MODIFIED'
  end
  else if cp=1 & pp=0 then fstatus.fi='ADDED'
  else if cp=0 & pp=1 then fstatus.fi='DELETED'
  else fstatus.fi='UNCHANGED'
  if fstatus.fi='ADDED' then fadd=fadd+1
  else if fstatus.fi='DELETED' then fdelete=fdelete+1
  else if fstatus.fi='MODIFIED' then fmodify=fmodify+1
  else funchanged=funchanged+1
  if fstatus.fi\='UNCHANGED' then fchanged=fchanged+1
 end
 if fadd+fdelete+fmodify+funchanged\=chainedges then return 8
 if fchanged\=fadd+fdelete+fmodify then return 8
 call emitverified
 say 'HISTORYFIRSTCHANGES FULL SNAPSHOTS VERIFIED'
 say 'HISTORYFIRSTCHANGES DATA BEGIN'
 say 'HISTORYFIRSTCHANGES NODES' snodes
 say 'HISTORYFIRSTCHANGES EDGES' sedgecount
 say 'HISTORYFIRSTCHANGES CHAIN NODES' fpcount
 say 'HISTORYFIRSTCHANGES CHAIN EDGES' chainedges
 say 'HISTORYFIRSTCHANGES OFFCHAIN NODES' offnodes
 say 'HISTORYFIRSTCHANGES OFFCHAIN EDGES' offedges
 say 'HISTORYFIRSTCHANGES TRUNCATED' truncated
 say 'HISTORYFIRSTCHANGES CHANGES' fchanged
 say 'HISTORYFIRSTCHANGES ADDED' fadd
 say 'HISTORYFIRSTCHANGES DELETED' fdelete
 say 'HISTORYFIRSTCHANGES MODIFIED' fmodify
 say 'HISTORYFIRSTCHANGES UNCHANGED' funchanged
 do fi=1 to chainedges
  ec=fpnode.fi
  fj=fi+1
  ep=fpnode.fj
  say 'HISTORYFIRSTCHANGES EDGE' fi 'CHILD' ec 'PARENT' ep
  say 'HISTORYFIRSTCHANGES EDGE' fi 'STATUS' fstatus.fi
  say 'HISTORYFIRSTCHANGES EDGE' fi 'CHILDDEPTH' sdepth.ec,
      'PARENTDEPTH' sdepth.ep
  say 'HISTORYFIRSTCHANGES EDGE' fi 'CHILDCOMMIT' scommit.ec
  say 'HISTORYFIRSTCHANGES EDGE' fi 'PARENTCOMMIT' scommit.ep
  if spresent.ec=1 then cs='PRESENT'
  else cs='ABSENT'
  if spresent.ep=1 then ps='PRESENT'
  else ps='ABSENT'
  say 'HISTORYFIRSTCHANGES EDGE' fi 'CHILDSTATE' cs,
      'PARENTSTATE' ps
  if spresent.ec=1 then,
   say 'HISTORYFIRSTCHANGES EDGE' fi 'CHILDOID' soid.ec
  if spresent.ep=1 then,
   say 'HISTORYFIRSTCHANGES EDGE' fi 'PARENTOID' soid.ep
 end
 say 'HISTORYFIRSTCHANGES DATA END'
 return 0


stateedgeroles:
 drop eroleslots. erolemin. erolemax. erolefirst.
 firstedges=0
 mergeedges=0
 multiedges=0
 duplicate=0
 expectedfirst=0
 do ni=1 to snodes
  if sdepth.ni<depth & sparents.ni>0 then,
   expectedfirst=expectedfirst+1
 end
 do ei=1 to sedgecount
  eroleslots.ei=0
  erolemin.ei=65
  erolemax.ei=0
  erolefirst.ei=0
 end
 do si=1 to sslotcount
  found=0
  do ei=1 to sedgecount
   if sedgechild.ei=sslotchild.si &,
      sedgeparent.ei=sslotparent.si then do
    found=ei
    leave
   end
  end
  if found=0 then return 8
  ord=sslotord.si
  eroleslots.found=eroleslots.found+1
  if ord<erolemin.found then erolemin.found=ord
  if ord>erolemax.found then erolemax.found=ord
  if ord=1 then erolefirst.found=1
 end
 do ei=1 to sedgecount
  if eroleslots.ei<1 then return 8
  duplicate=duplicate+eroleslots.ei-1
  if eroleslots.ei>1 then multiedges=multiedges+1
  if erolefirst.ei=1 then do
   if erolemin.ei\=1 then return 8
   firstedges=firstedges+1
  end
  else do
   if erolemin.ei<2 then return 8
   mergeedges=mergeedges+1
  end
 end
 if firstedges\=expectedfirst then return 8
 if firstedges+mergeedges\=sedgecount then return 8
 if duplicate\=sslotcount-sedgecount then return 8
 call emitverified
 say 'HISTORYEDGEROLES FULL SNAPSHOTS VERIFIED'
 say 'HISTORYEDGEROLES DATA BEGIN'
 say 'HISTORYEDGEROLES NODES' snodes
 say 'HISTORYEDGEROLES EDGES' sedgecount
 say 'HISTORYEDGEROLES SLOTS' sslotcount
 say 'HISTORYEDGEROLES FIRST EDGES' firstedges
 say 'HISTORYEDGEROLES MERGE EDGES' mergeedges
 say 'HISTORYEDGEROLES MULTISLOT EDGES' multiedges
 say 'HISTORYEDGEROLES DUPLICATE SLOTS' duplicate
 do ei=1 to sedgecount
  say 'HISTORYEDGEROLES EDGE' ei 'CHILD' sedgechild.ei,
      'PARENT' sedgeparent.ei
  if erolefirst.ei=1 then role='FIRST'
  else role='MERGE'
  say 'HISTORYEDGEROLES EDGE' ei 'ROLE' role
  say 'HISTORYEDGEROLES EDGE' ei 'SLOTS' eroleslots.ei,
      'MINORDINAL' erolemin.ei 'MAXORDINAL' erolemax.ei
 end
 say 'HISTORYEDGEROLES DATA END'
 return 0


stateparentslots:
 duplicate=sslotcount-sedgecount
 if duplicate<0 then return 8
 boundaryomit=0
 do ni=1 to snodes
  if sdepth.ni=depth then boundaryomit=boundaryomit+sparents.ni
 end
 call emitverified
 say 'HISTORYPARENTSLOTS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYPARENTSLOTS DATA BEGIN'
 say 'HISTORYPARENTSLOTS NODES' snodes
 say 'HISTORYPARENTSLOTS EDGES' sedgecount
 say 'HISTORYPARENTSLOTS SLOTS' sslotcount
 say 'HISTORYPARENTSLOTS DUPLICATE SLOTS' duplicate
 say 'HISTORYPARENTSLOTS BOUNDARY SLOTS OMITTED' boundaryomit
 do ni=1 to snodes
  say 'HISTORYPARENTSLOTS NODE' ni 'COMMIT' scommit.ni
 end
 do si=1 to sslotcount
  say 'HISTORYPARENTSLOTS SLOT' si 'CHILD' sslotchild.si,
      'ORDINAL' sslotord.si 'PARENT' sslotparent.si
 end
 say 'HISTORYPARENTSLOTS DATA END'
 return 0


stateparents:
 roots=0
 firstfollowed=0
 boundaryparents=0
 do ni=1 to snodes
  if sparents.ni=0 then roots=roots+1
  if sfirstnode.ni>0 then firstfollowed=firstfollowed+1
  if sdepth.ni=depth & sparents.ni>0 then,
   boundaryparents=boundaryparents+1
 end
 call emitverified
 say 'HISTORYPARENTS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYPARENTS DATA BEGIN'
 say 'HISTORYPARENTS NODES' snodes
 say 'HISTORYPARENTS EDGES' sedgecount
 say 'HISTORYPARENTS ROOTS' roots
 say 'HISTORYPARENTS FIRST FOLLOWED' firstfollowed
 say 'HISTORYPARENTS BOUNDARY WITH PARENTS' boundaryparents
 do ni=1 to snodes
  say 'HISTORYPARENTS NODE' ni 'COMMIT' scommit.ni
  say 'HISTORYPARENTS NODE' ni 'DEPTH' sdepth.ni,
      'PARENTS' sparents.ni 'UNIQUE' suniqueparents.ni
  say 'HISTORYPARENTS NODE' ni 'FIRSTPARENT' sfirstparent.ni
  say 'HISTORYPARENTS NODE' ni 'PARENTSEQ BLOBID' sparentseqid.ni
  say 'HISTORYPARENTS NODE' ni 'FIRSTFOLLOWED' sfirstnode.ni
 end
 say 'HISTORYPARENTS DATA END'
 return 0


statetopology:
 roots=0
 linear=0
 merges=0
 dupparents=0
 maxparents=0
 do ni=1 to snodes
  pc=sparents.ni
  if pc=0 then roots=roots+1
  else if pc=1 then linear=linear+1
  else merges=merges+1
  if pc\=suniqueparents.ni then dupparents=dupparents+1
  if pc>maxparents then maxparents=pc
 end
 if roots+linear+merges\=snodes then return 8
 call emitverified
 say 'HISTORYTOPOLOGY FULL SNAPSHOTS VERIFIED'
 say 'HISTORYTOPOLOGY DATA BEGIN'
 say 'HISTORYTOPOLOGY NODES' snodes
 say 'HISTORYTOPOLOGY EDGES' sedgecount
 say 'HISTORYTOPOLOGY ROOTS' roots
 say 'HISTORYTOPOLOGY LINEAR' linear
 say 'HISTORYTOPOLOGY MERGES' merges
 say 'HISTORYTOPOLOGY DUPPARENTS' dupparents
 say 'HISTORYTOPOLOGY MAX PARENTS' maxparents
 do ni=1 to snodes
  say 'HISTORYTOPOLOGY NODE' ni 'COMMIT' scommit.ni
  say 'HISTORYTOPOLOGY NODE' ni 'DEPTH' sdepth.ni,
      'PARENTS' sparents.ni 'UNIQUE' suniqueparents.ni
  say 'HISTORYTOPOLOGY NODE' ni 'FOLLOWED' soutedges.ni
  if sparents.ni=0 then tclass='ROOT'
  else if sparents.ni=1 then tclass='LINEAR'
  else tclass='MERGE'
  say 'HISTORYTOPOLOGY NODE' ni 'CLASS' tclass
 end
 say 'HISTORYTOPOLOGY DATA END'
 return 0


statebodies:
 drop bseen. bid. bbytes. bsubid. bsubbytes. bsubhex.
 drop bcount. bmin. bmax.
 bodies=0
 do ni=1 to snodes
  key=smsgid.ni
  bi=bseen.key
  if datatype(bi,'W')\=1 then do
   bodies=bodies+1
   bi=bodies
   bseen.key=bi
   bid.bi=key
   bbytes.bi=smsgbytes.ni
   bsubid.bi=ssubid.ni
   bsubbytes.bi=ssubbytes.ni
   bsubhex.bi=ssubhex.ni
   bcount.bi=1
   bmin.bi=sdepth.ni
   bmax.bi=sdepth.ni
  end
  else do
   if bbytes.bi\=smsgbytes.ni | bsubid.bi\=ssubid.ni |,
      bsubbytes.bi\=ssubbytes.ni | bsubhex.bi\=ssubhex.ni then,
    return 8
   bcount.bi=bcount.bi+1
   if sdepth.ni<bmin.bi then bmin.bi=sdepth.ni
   if sdepth.ni>bmax.bi then bmax.bi=sdepth.ni
  end
 end
 btotal=0
 do bi=1 to bodies
  btotal=btotal+bcount.bi
 end
 if btotal\=snodes then return 8
 call emitverified
 say 'HISTORYBODIES FULL SNAPSHOTS VERIFIED'
 say 'HISTORYBODIES DATA BEGIN'
 say 'HISTORYBODIES NODES' snodes
 say 'HISTORYBODIES BODIES' bodies
 do bi=1 to bodies
  say 'HISTORYBODIES BODY' bi 'BLOBID' bid.bi
  say 'HISTORYBODIES BODY' bi 'BYTES' bbytes.bi
  say 'HISTORYBODIES BODY' bi 'SUBJECT BLOBID' bsubid.bi
  say 'HISTORYBODIES BODY' bi 'SUBJECT BYTES' bsubbytes.bi,
      'PREFIXHEX' bsubhex.bi
  say 'HISTORYBODIES BODY' bi 'COUNT' bcount.bi,
      'MINDEPTH' bmin.bi 'MAXDEPTH' bmax.bi
 end
 say 'HISTORYBODIES DATA END'
 return 0


statesubjects:
 drop qseen. qid. qbytes. qprefix. qhex. qcount. qmin. qmax.
 subjects=0
 do ni=1 to snodes
  key=ssubid.ni
  qi=qseen.key
  if datatype(qi,'W')\=1 then do
   subjects=subjects+1
   qi=subjects
   qseen.key=qi
   qid.qi=key
   qbytes.qi=ssubbytes.ni
   qprefix.qi=ssubprefix.ni
   qhex.qi=ssubhex.ni
   qcount.qi=1
   qmin.qi=sdepth.ni
   qmax.qi=sdepth.ni
  end
  else do
   if qbytes.qi\=ssubbytes.ni | qprefix.qi\=ssubprefix.ni |,
      qhex.qi\=ssubhex.ni then return 8
   qcount.qi=qcount.qi+1
   if sdepth.ni<qmin.qi then qmin.qi=sdepth.ni
   if sdepth.ni>qmax.qi then qmax.qi=sdepth.ni
  end
 end
 qtotal=0
 do qi=1 to subjects
  qtotal=qtotal+qcount.qi
 end
 if qtotal\=snodes then return 8
 call emitverified
 say 'HISTORYSUBJECTS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYSUBJECTS DATA BEGIN'
 say 'HISTORYSUBJECTS NODES' snodes
 say 'HISTORYSUBJECTS SUBJECTS' subjects
 do qi=1 to subjects
  say 'HISTORYSUBJECTS SUBJECT' qi 'BLOBID' qid.qi
  say 'HISTORYSUBJECTS SUBJECT' qi 'BYTES' qbytes.qi,
      'PREFIXBYTES' qprefix.qi
  say 'HISTORYSUBJECTS SUBJECT' qi 'PREFIXHEX' qhex.qi
  say 'HISTORYSUBJECTS SUBJECT' qi 'COUNT' qcount.qi,
      'MINDEPTH' qmin.qi 'MAXDEPTH' qmax.qi
 end
 say 'HISTORYSUBJECTS DATA END'
 return 0


stateactors:
 drop aseen. aaid. aabytes. aaprefix. aahex. aacount. aamin. aamax.
 drop cseen. ccid. ccbytes. ccprefix. cchex. cccount. ccmin. ccmax.
 authors=0
 committers=0
 do ni=1 to snodes
  key=saidentid.ni
  ai=aseen.key
  if datatype(ai,'W')\=1 then do
   authors=authors+1
   ai=authors
   aseen.key=ai
   aaid.ai=key
   aabytes.ai=saidentbytes.ni
   aaprefix.ai=saidentprefix.ni
   aahex.ai=saidenthex.ni
   aacount.ai=1
   aamin.ai=sdepth.ni
   aamax.ai=sdepth.ni
  end
  else do
   if aabytes.ai\=saidentbytes.ni |,
      aaprefix.ai\=saidentprefix.ni | aahex.ai\=saidenthex.ni then,
    return 8
   aacount.ai=aacount.ai+1
   if sdepth.ni<aamin.ai then aamin.ai=sdepth.ni
   if sdepth.ni>aamax.ai then aamax.ai=sdepth.ni
  end
  key=scidentid.ni
  ci=cseen.key
  if datatype(ci,'W')\=1 then do
   committers=committers+1
   ci=committers
   cseen.key=ci
   ccid.ci=key
   ccbytes.ci=scidentbytes.ni
   ccprefix.ci=scidentprefix.ni
   cchex.ci=scidenthex.ni
   cccount.ci=1
   ccmin.ci=sdepth.ni
   ccmax.ci=sdepth.ni
  end
  else do
   if ccbytes.ci\=scidentbytes.ni |,
      ccprefix.ci\=scidentprefix.ni | cchex.ci\=scidenthex.ni then,
    return 8
   cccount.ci=cccount.ci+1
   if sdepth.ni<ccmin.ci then ccmin.ci=sdepth.ni
   if sdepth.ni>ccmax.ci then ccmax.ci=sdepth.ni
  end
 end
 atotal=0
 do ai=1 to authors
  atotal=atotal+aacount.ai
 end
 ctotal=0
 do ci=1 to committers
  ctotal=ctotal+cccount.ci
 end
 if atotal\=snodes | ctotal\=snodes then return 8
 call emitverified
 say 'HISTORYACTORS FULL SNAPSHOTS VERIFIED'
 say 'HISTORYACTORS DATA BEGIN'
 say 'HISTORYACTORS NODES' snodes
 say 'HISTORYACTORS AUTHORS' authors
 do ai=1 to authors
  say 'HISTORYACTORS AUTHOR' ai 'BLOBID' aaid.ai
  say 'HISTORYACTORS AUTHOR' ai 'BYTES' aabytes.ai,
      'PREFIXBYTES' aaprefix.ai
  say 'HISTORYACTORS AUTHOR' ai 'PREFIXHEX' aahex.ai
  say 'HISTORYACTORS AUTHOR' ai 'COUNT' aacount.ai,
      'MINDEPTH' aamin.ai 'MAXDEPTH' aamax.ai
 end
 say 'HISTORYACTORS COMMITTERS' committers
 do ci=1 to committers
  say 'HISTORYACTORS COMMITTER' ci 'BLOBID' ccid.ci
  say 'HISTORYACTORS COMMITTER' ci 'BYTES' ccbytes.ci,
      'PREFIXBYTES' ccprefix.ci
  say 'HISTORYACTORS COMMITTER' ci 'PREFIXHEX' cchex.ci
  say 'HISTORYACTORS COMMITTER' ci 'COUNT' cccount.ci,
      'MINDEPTH' ccmin.ci 'MAXDEPTH' ccmax.ci
 end
 say 'HISTORYACTORS DATA END'
 return 0


pathasciihex:
 parse arg text
 if text='' | length(text)>255 then return 'ERROR'
 if pos('//',text)>0 | left(text,1)='/' | right(text,1)='/' then,
  return 'ERROR'
 e2ahex='000102031A091A7F1A1A1A0B0C0D0E0F' ||,
         '101112131A1A081A18191A1A1C1D1E1F' ||,
         '1A1A1C1A1A0A171B1A1A1A1A1A050607' ||,
         '1A1A161A1A1E1A041A1A1A1A14151A1A' ||,
         '20A6E180EB909FE2AB8B9B2E3C282B7C' ||,
         '26A9AA9CDBA599E3A89E21242A293B5E' ||,
         '2D2FDFDC9ADDDE989DACBA2C255F3E3F' ||,
         'D78894B0B1B2FCD6FB603A2340273D22' ||,
         'F861626364656667686996A4F3AFAEC5' ||,
         '8C6A6B6C6D6E6F7071729787CE93F1FE' ||,
         'C87E737475767778797AEFC0DA5BF2F9' ||,
         'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4' ||,
         '7B414243444546474849CBCABEE8ECED' ||,
         '7D4A4B4C4D4E4F505152A1ADF5F4A38F' ||,
         '5CE7535455565758595AA0858EE9E4D1' ||,
         '30313233343536373839B3F7F0FAA7FF'
 e2a=x2c(e2ahex)
 bytes=xrange('00'x,'FF'x)
 out=c2x(translate(text,e2a,bytes))
 if pos('00',out)>0 then return 'ERROR'
 return out

bindnative:
 'FILEDEF SEL0 DISK M15SL0 PTR A'
 if rc\=0 then return 'ERROR'
 'FILEDEF SEL1 DISK M15SL1 PTR A'
 if rc\=0 then return 'ERROR'
 do i=1 to 4
  typ=word('STAGE INDEX SEEK GEN',i)
  dd=word('C0STG C0IDX C0SEEK C0GEN',i)
  'FILEDEF' dd 'DISK GITFIX' typ 'A'
  if rc\=0 then return 'ERROR'
  dd=word('C1STG C1IDX C1SEEK C1GEN',i)
  'FILEDEF' dd 'DISK M15NEW' typ 'A'
  if rc\=0 then return 'ERROR'
 end
 return 'OK'
