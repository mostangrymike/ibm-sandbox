/* M12 proxy-path native REXX/SOCKETS probe. */
parse upper arg host port
if host='' then host='EXAMPLE.COM'
if port='' then port=80
say 'M12P TEST 1: initialize REXX/SOCKETS'
r=Socket('Initialize','M12PRXY')
say r
parse var r rc rest
if rc\=0 then exit 8
say 'M12P TEST 2: resolve IPv4 host' host
if verify(host,'0123456789.')=0 then ip=host
else do
 r=Socket('GetHostByName',host)
 say r
 parse var r rc addrs
 if rc\=0 then call fail
 ip=word(addrs,1)
 if ip='' then call fail
end
say 'IPV4 ADDRESS' ip
say 'M12P TEST 3: create raw-byte TCP socket'
r=Socket('Socket')
say r
parse var r rc s
if rc\=0 then call fail
say 'M12P TEST 4: verify ASCII translation is OFF'
r=Socket('GetSockOpt',s,'SOL_SOCKET','SO_ASCII')
say r
parse var r rc opt
if rc\=0 then call closefail
if translate(opt)\='OFF' then call closefail
say 'M12P TEST 5: connect' ip port
r=Socket('Connect',s,'AF_INET' port ip)
say r
parse var r rc rest
if rc\=0 then call closefail
req='474554202F20485454502F312E300D0A'
req=req||'486F73743A206769746875622E636F6D0D0A'
req=req||'436F6E6E656374696F6E3A20636C6F73650D0A0D0A'
raw=x2c(req)
say 'M12P TEST 6: send exact ASCII wire bytes'
r=Socket('Send',s,raw)
say r
parse var r rc sent
if rc\=0 then call closefail
if sent\=length(raw) then call closefail
say 'M12P TEST 7: bounded raw-byte receive'
total=0
prefix=''
do forever
 r=Socket('Recv',s,256)
 parse var r rc got data
 if rc\=0 then call closefail
 if got=0 then leave
 if got>256 then call closefail
 if length(data)\=got then call closefail
 if length(prefix)<16 then prefix=prefix||data
 total=total+got
 if total>1048576 then call closefail
end
say 'RECEIVED BYTES' total
say 'WIRE PREFIX' c2x(left(prefix,16))
if c2x(left(prefix,5))\='485454502F' then call closefail
r=Socket('Close',s)
say r
call term
if total=0 then exit 8
say 'M12 PROXY PATH TEST PASSED'
exit 0
closefail:
 call Socket 'Close',s
fail:
 call term
 exit 8
term:
 r=Socket('Terminate')
 return
