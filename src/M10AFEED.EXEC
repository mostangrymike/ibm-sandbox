/* M10A feed known real PACK bytes through Git side-band framing. */
address command
pack='5041434B0000000200000002'
pack=pack||'337801010300FCFF616263024D0127'
pack=pack||'337801010300FCFF78797A02D7016C'
pack=pack||'5F1C02695D4BC807AE4A5DD622AD1D28E7659429'
say 'M10A TEST 1: initialize incremental transport sink'
'EXEC GIT10PK INIT'
if rc\=0 then exit rc
say 'M10A TEST 2: feed side-band packet fragments'
p1=substr(pack,1,70)
p2=substr(pack,71)
n1=(length(p1)%2)+5
n2=(length(p2)%2)+5
h1=right(d2x(n1),4,'0')||'01'||p1
h2=right(d2x(n2),4,'0')||'01'||p2
'EXEC GIT10PK FEED' h1
if rc\=0 then exit rc
'EXEC GIT10PK FEED' h2
if rc\=0 then exit rc
'EXEC GIT10PK FINAL'
if rc\=0 then exit rc
say 'M10A TEST 3: verify and walk transported PACK'
'EXEC GITPSHA VERIFY'
if rc\=0 then exit rc
'EXEC GITP9PWK WALK'
if rc\=0 then exit rc
say 'M10A INCREMENTAL SIDE-BAND PACK FEED TEST PASSED'
exit 0
