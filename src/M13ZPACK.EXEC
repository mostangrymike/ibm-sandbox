/* M13Z: native PACK walker with an OFS_DELTA object. */
/* Base blob abc at offset 12; delta appends d -> abcd. */
/* Second entry starts at offset 24; OFS distance is 12. */
address command
'EXEC GITPBUF INIT'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 5041434B000000020000000233789C4B4C4A0600024D0127'
if rc \= 0 then exit rc
/* OFS_DELTA size 6, distance 12, zlib stored block. */
/* Delta: base 3, result 4, copy 3, insert d. */
'EXEC GITPBUF APPEND 660C7801010600F9FF03049003016402DB0100'
if rc \= 0 then exit rc
/* Placeholder trailer; this isolated walker does not check SHA-1. */
'EXEC GITPBUF APPEND 0000000000000000000000000000000000000000'
if rc \= 0 then exit rc
'EXEC GITPBUF FINAL'
if rc \= 0 then exit rc
'EXEC GITPNWLK WALK QUIET NATIVE'
if rc \= 0 then do
 say 'M13Z: native OFS delta PACK walk failed'
 exit rc
end
'EXEC GITOBUF READSTACK 0 4'
if rc \= 0 | queued() < 1 then exit 8
parse pull h
if h \= '61626364' then do
 say 'M13Z: reconstructed delta content mismatch' h
 exit 8
end
say 'M13Z NATIVE OFS DELTA PACK WALK PASSED'
exit 0
