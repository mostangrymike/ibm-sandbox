/* M9J streaming zlib regression. */
address command
say 'M9J ZLIB TEST 1: fixed Huffman stream'
z = '789C4B4C4A0600024D0127'
call run z,'616263'
if result \= 0 then exit result
say 'M9J ZLIB TEST 2: dynamic Huffman stream'
d = '1589C11100300C825671358CB5FB6FD0F40507F460E740BD16746164CC76F8EC0C'
d = d || 'EACEC8CD03'
z = '789C' || d || 'D7EC123A'
want = '616665616262646561616662656162646120676161632062616261616262616161'
want = want || '6261616663636120666162646420626664'
call run z,want
if result \= 0 then exit result
say 'M9J ZLIB TEST 3: stored then fixed mixed stream'
z = '789C000300FCFF6162634B4C4A0600080C024D'
call run z,'616263616263'
if result \= 0 then exit result
say 'M9J ZLIB TEST 4: reject bad Adler-32'
z = '789C4B4C4A0600024D0126'
call load z
if result \= 0 then exit result
'EXEC GITPZBUF TOOBUF 0'
if rc = 0 then exit 8
say 'EXPECTED FAILURE RC=' rc
say 'M9J STREAMING ZLIB TESTS PASSED'
exit 0
load:
   parse arg data
   'EXEC GITPBUF INIT'
   if rc \= 0 then return rc
   do while data \= ''
      part = left(data,128)
      data = substr(data,length(part)+1)
      'EXEC GITPBUF APPEND' part
      if rc \= 0 then return rc
   end
   'EXEC GITPBUF FINAL'
   return rc
run:
   parse arg data,want
   call load data
   if result \= 0 then return result
   'EXEC GITPZBUF TOOBUF 0'
   if rc \= 0 then return rc
   if queued() < 2 then return 8
   parse pull used
   parse pull bytes
   'EXEC GITOBUF READSTACK 0' bytes
   if rc \= 0 then return rc
   parse pull got
   say 'DATA' got
   say 'ZLIB BYTES' used
   if got \= want then return 8
   return 0
