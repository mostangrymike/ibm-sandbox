/* M9J streaming zlib wrapper into GITOBUF. */
parse arg command offset extra
command = translate(command)
if command \= 'TOOBUF' | extra \= '' | datatype(offset,'W') \= 1 then do
   say 'Usage: GITPZBUF TOOBUF zlib-offset'
   exit 4
end
address command
'EXEC GITPBUF READSTACK' offset 2
if rc \= 0 | queued() < 1 then exit 8
parse pull head
if length(head) \= 4 then exit 8
cmf = x2d(substr(head,1,2))
flg = x2d(substr(head,3,2))
if cmf // 16 \= 8 | cmf % 16 > 7 then do
   say 'GITPZBUF: invalid zlib method/window'
   exit 8
end
if (cmf * 256 + flg) // 31 \= 0 then do
   say 'GITPZBUF: invalid zlib FCHECK'
   exit 8
end
if (flg % 32) // 2 then do
   say 'GITPZBUF: preset dictionary not supported'
   exit 8
end
defpos = offset + 2
'EXEC GITPSTRM TOOBUF' defpos
if rc \= 0 then exit rc
if queued() < 2 then exit 8
parse pull defused
parse pull outlen
trailer = defpos + defused
'EXEC GITPBUF READSTACK' trailer 4
if rc \= 0 | queued() < 1 then exit 8
parse pull expected
s1 = 1
s2 = 0
pos = 0
do while pos < outlen
   count = outlen - pos
   if count > 64 then count = 64
   'EXEC GITOBUF READSTACK' pos count
   if rc \= 0 | queued() < 1 then exit 8
   parse pull data
   do p = 1 to length(data) by 2
      b = x2d(substr(data,p,2))
      s1 = (s1 + b) // 65521
      s2 = (s2 + s1) // 65521
   end
   pos = pos + count
end
actual = d2x(s2,4) || d2x(s1,4)
if actual \= expected then do
   say 'GITPZBUF: Adler-32 mismatch'
   exit 8
end
queue 2 + defused + 4
queue outlen
exit 0
