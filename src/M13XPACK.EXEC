/* M13X: stage a minimal one-blob PACK and test native walker. */
/* PACK v2, one BLOB of 3 bytes, zlib('abc'), 20-byte trailer. */
/* Walker currently does not validate the trailing PACK checksum. */
address command
'EXEC GITPBUF INIT'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 5041434B000000020000000133789C4B4C4A0600024D0127'
if rc \= 0 then exit rc
'EXEC GITPBUF APPEND 0000000000000000000000000000000000000000'
if rc \= 0 then exit rc
'EXEC GITPBUF FINAL'
if rc \= 0 then exit rc
'EXEC GITPNWLK WALK QUIET NATIVE'
if rc \= 0 then do
 say 'M13X: native PACK walker failed'
 exit rc
end
'EXEC GITOBUF READSTACK 0 3'
if rc \= 0 | queued() < 1 then exit 8
parse pull h
if h \= '616263' then do
 say 'M13X: wrong blob content' h
 exit 8
end
say 'M13X NATIVE SINGLE-BLOB PACK WALK PASSED'
exit 0
