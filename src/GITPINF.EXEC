/* M7H isolated Git pack-entry zlib integration. */
parse arg command entry extra
command = translate(command)
entry = translate(entry)
if command \= 'INFLATE' | extra \= '' | entry = '' |,
   length(entry) // 2 \= 0 |,
   verify(entry,'0123456789ABCDEF') \= 0 then do
   say 'Usage: GITPINF INFLATE pack-entry-hex'
   exit 4
end
pos = 1
b = byte(entry,pos)
if b = 'ERROR' then exit 8
pos = pos + 2
type = (b % 16) // 8
size = b // 16
shift = 4
more = b >= 128
do while more
   b = byte(entry,pos)
   if b = 'ERROR' then exit 8
   pos = pos + 2
   size = size + (b // 128) * (2 ** shift)
   shift = shift + 7
   more = b >= 128
   if shift > 60 then do
      say 'GITPINF: object size header too large'
      exit 8
   end
end
if type = 0 | type = 5 then do
   say 'GITPINF: invalid packed object type' type
   exit 8
end
if type = 6 | type = 7 then do
   say 'GITPINF: delta pack entries deferred to M6 integration'
   exit 8
end
if length(entry) - pos + 1 < 12 then do
   say 'GITPINF: zlib stream too short'
   exit 8
end
cmf = x2d(substr(entry,pos,2))
flg = x2d(substr(entry,pos+2,2))
cm = cmf // 16
cinfo = cmf % 16
if cm \= 8 then do
   say 'GITPINF: unsupported compression method' cm
   exit 8
end
if cinfo > 7 then do
   say 'GITPINF: invalid DEFLATE window size'
   exit 8
end
if (cmf * 256 + flg) // 31 \= 0 then do
   say 'GITPINF: invalid FCHECK'
   exit 8
end
fdict = (flg % 32) // 2
if fdict then do
   say 'GITPINF: preset dictionary not valid for Git pack entry'
   exit 8
end
zpos = pos + 4
trailer = length(entry) - 7
if zpos > trailer then do
   say 'GITPINF: missing DEFLATE payload'
   exit 8
end
deflate = substr(entry,zpos,trailer-zpos)
adler = substr(entry,trailer,8)
'EXEC GITINFL INFLATESTACK' deflate
if rc \= 0 then exit rc
if queued() < 1 then do
   say 'GITPINF: inflater returned no data'
   exit 8
end
pull out
out = translate(out)
if length(out) // 2 \= 0 |,
   verify(out,'0123456789ABCDEF') \= 0 then do
   say 'GITPINF: inflater returned invalid hex'
   exit 8
end
if length(out) % 2 \= size then do
   say 'GITPINF: packed object size mismatch'
   say 'EXPECTED' size
   say 'ACTUAL' length(out) % 2
   exit 8
end
s1 = 1
s2 = 0
do p = 1 to length(out) by 2
   v = x2d(substr(out,p,2))
   s1 = (s1 + v) // 65521
   s2 = (s2 + s1) // 65521
end
actual = d2x(s2,4) || d2x(s1,4)
if actual \= adler then do
   say 'GITPINF: Adler-32 mismatch'
   say 'EXPECTED' adler
   say 'ACTUAL' actual
   exit 8
end
say 'TYPE' type typename(type)
say 'SIZE' size
say 'DATA' out
say 'ADLER32' actual
exit 0

byte: procedure
   parse arg data, pos
   if pos + 1 > length(data) then do
      say 'GITPINF: truncated object header'
      return 'ERROR'
   end
   return x2d(substr(data,pos,2))

typename: procedure
   parse arg t
   if t = 1 then return 'COMMIT'
   if t = 2 then return 'TREE'
   if t = 3 then return 'BLOB'
   if t = 4 then return 'TAG'
   return 'INVALID'
