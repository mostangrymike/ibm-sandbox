/* M7H isolated Git pack-entry zlib integration. */
parse arg command entry extra
command = translate(command)
entry = translate(entry)
if command \= 'INFLATE' | extra \= '' | entry = '' |,
   length(entry) // 2 \= 0 |,
   verify(entry,'0123456789ABCDEF') \= 0 then do
   say 'Usage: GITPINF INFLATE pack-entry-hex'
   exit 4
end
pos = 1
b = byte(entry,pos)
if b = 'ERROR' then exit 8
pos = pos + 2
type = (b % 16) // 8
size = b // 16
shift = 4
more = b >= 128
do while more
   b = byte(entry,pos)
   if b = 'ERROR' then exit 8
   pos = pos + 2
   size = size + (b // 128) * (2 ** shift)
   shift = shift + 7
   more = b >= 128
   if shift > 60 then do
      say 'GITPINF: object size header too large'
      exit 8
   end
end
if type = 0 | type = 5 then do
   say 'GITPINF: invalid packed object type' type
   exit 8
end
if type = 6 | type = 7 then do
   say 'GITPINF: delta pack entries deferred to M6 integration'
   exit 8
end
if length(entry) - pos + 1 < 12 then do
   say 'GITPINF: zlib stream too short'
   exit 8
end
cmf = x2d(substr(entry,pos,2))
flg = x2d(substr(entry,pos+2,2))
cm = cmf // 16
cinfo = cmf % 16
if cm \= 8 then do
   say 'GITPINF: unsupported compression method' cm
   exit 8
end
if cinfo > 7 then do
   say 'GITPINF: invalid DEFLATE window size'
   exit 8
end
if (cmf * 256 + flg) // 31 \= 0 then do
   say 'GITPINF: invalid FCHECK'
   exit 8
end
fdict = (flg % 32) // 2
if fdict then do
   say 'GITPINF: preset dictionary not supported for Git pack entry'
   exit 8
end
zpos = pos + 4
trailer = length(entry) - 7
if zpos > trailer then do
   say 'GITPINF: missing DEFLATE payload'
   exit 8
end
deflate = substr(entry,zpos,trailer-zpos)
adler = substr(entry,trailer,8)
/* Inline the target-proven general inflater interface via CMS stack capture. */
'EXECIO 0 CP (STRING GITINFL INFLATE' deflate
if rc \= 0 then do
   say 'GITPINF: unable to stage inflater command'
   exit 8
end
/* Direct EXEC invocation is used; test vectors keep output to one line. */
'EXEC GITINFL INFLATE' deflate
if rc \= 0 then exit rc
/* M7H prototype needs the reconstructed bytes for size/checksum checks. */
/* Reinflate locally through the shared GITINFL algorithm is deferred. */
say 'GITPINF: integration requires capturable inflater output'
exit 12

byte: procedure
   parse arg data, pos
   if pos + 1 > length(data) then do
      say 'GITPINF: truncated object header'
      return 'ERROR'
   end
   return x2d(substr(data,pos,2))
