/* Combined compact real-CMS target gate through M157. */
address cms
parse arg extra
if extra\='' then do
 say 'Usage: M157GATE'
 exit 4
end

spec='486ADAA5B02080720F4B329C6F68550B13C6AA87'
path='src/GITPBWALK.EXEC'

drop out.
out.0=0
'PIPE CMS EXEC M155CHK' spec 1 path '| STEM out.'
grc=rc
if grc\=0 then do
 say 'M157GATE M155 FAIL RC' grc
 exit grc
end
ok=0
do i=1 to out.0
 if out.i='M155 COMPACT TARGET GATE PASS' then ok=1
end
if \ok then exit 8
say 'M157GATE M155 PASS'

drop out.
out.0=0
'PIPE CMS EXEC M156CHK | STEM out.'
grc=rc
if grc\=0 then do
 say 'M157GATE M156 FAIL RC' grc
 exit grc
end
ok=0
do i=1 to out.0
 if out.i='M156 COMPACT TARGET GATE PASS' then ok=1
end
if \ok then exit 8
say 'M157GATE M156 PASS'

drop out.
out.0=0
'PIPE CMS EXEC M157CHK | STEM out.'
grc=rc
if grc\=0 then do
 say 'M157GATE M157 FAIL RC' grc
 exit grc
end
ok=0
do i=1 to out.0
 if out.i='M157 COMPACT TARGET GATE PASS' then ok=1
end
if \ok then exit 8
say 'M157GATE M157 PASS'
say 'M157GATE COMBINED TARGET GATE PASS'
exit 0
