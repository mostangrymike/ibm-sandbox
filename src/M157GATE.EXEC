/* Combined compact real-CMS target gate through M157. */
address cms
parse arg extra
if extra\='' then do
 say 'Usage: M157GATE'
 exit 4
end

'M155CHK'
grc=rc
if grc\=0 then do
 say 'M157GATE M155 FAIL RC' grc
 exit grc
end
say 'M157GATE M155 PASS'

'M156CHK'
grc=rc
if grc\=0 then do
 say 'M157GATE M156 FAIL RC' grc
 exit grc
end
say 'M157GATE M156 PASS'

'M157CHK'
grc=rc
if grc\=0 then do
 say 'M157GATE M157 FAIL RC' grc
 exit grc
end
say 'M157GATE M157 PASS'
say 'M157GATE COMBINED TARGET GATE PASS'
exit 0
