GITCORE  CSECT
         USING GITCORE,12
         LR    12,15
         LR    11,0
         USING EPLIST,11
         L     2,EPLARGBG
         L     3,EPLARGND
         SR    3,2
         C     3,=F'7'
         BNE   BADARG
         CLC   0(7,2),=C'SHA1ABC'
         BE    SHA1ABC
         CLC   0(7,2),=C'SHA1EMP'
         BE    SHA1EMP
         CLC   0(7,2),=C'SHA1TWO'
         BE    SHA1TWO
         CLC   0(7,2),=C'VERSION'
         BNE   BADARG
         LINEWRT DATA=(VERSION,VERLEN)
         SR    15,15
         BR    14
*
* M1B: SHA1BLK consumes one block using HASH0-HASH4 as chaining state.
* Tests cover empty input, abc, and a standard two-block SHA-1 vector.
*
SHA1ABC  ST    14,CALLRET
         MVC   HASH0(20),H0INIT
         LA    2,ABCBLOCK
         BAL   14,SHA1BLK
         C     4,ABCEXP0
         BNE   SHA1BAD
         C     5,ABCEXP1
         BNE   SHA1BAD
         C     6,ABCEXP2
         BNE   SHA1BAD
         C     7,ABCEXP3
         BNE   SHA1BAD
         C     8,ABCEXP4
         BNE   SHA1BAD
         LINEWRT DATA=(ABCDIG,ABCDLEN)
         B     SHA1OK
SHA1EMP  ST    14,CALLRET
         MVC   HASH0(20),H0INIT
         LA    2,EMPBLOCK
         BAL   14,SHA1BLK
         C     4,EMPEXP0
         BNE   SHA1BAD
         C     5,EMPEXP1
         BNE   SHA1BAD
         C     6,EMPEXP2
         BNE   SHA1BAD
         C     7,EMPEXP3
         BNE   SHA1BAD
         C     8,EMPEXP4
         BNE   SHA1BAD
         LINEWRT DATA=(EMPDIG,EMPDLEN)
         B     SHA1OK
SHA1TWO  ST    14,CALLRET
         MVC   HASH0(20),H0INIT
         LA    2,TWOBLK1
         BAL   14,SHA1BLK
         LA    2,TWOBLK2
         BAL   14,SHA1BLK
         C     4,TWOEXP0
         BNE   SHA1BAD
         C     5,TWOEXP1
         BNE   SHA1BAD
         C     6,TWOEXP2
         BNE   SHA1BAD
         C     7,TWOEXP3
         BNE   SHA1BAD
         C     8,TWOEXP4
         BNE   SHA1BAD
         LINEWRT DATA=(TWODIG,TWODLEN)
SHA1OK   SR    15,15
         L     14,CALLRET
         BR    14
SHA1BAD  LINEWRT DATA=(FAILMSG,FAILLEN)
         LA    15,4
         L     14,CALLRET
         BR    14
BADARG   LINEWRT DATA=(USAGE,USAGELEN)
         LA    15,4
         BR    14
*
* SHA1BLK - SHA-1 compression of one 64-byte block.
* R2 -> block. HASH0-HASH4 hold input and output chaining state.
* Returns the new state in R4-R8 and HASH0-HASH4.
*
SHA1BLK  STM   3,14,SAVEREGS
         LA    3,WARRAY
         LA    4,16
         LR    5,2
LOADW    L     6,0(5)
         ST    6,0(3)
         LA    5,4(5)
         LA    3,4(3)
         BCT   4,LOADW
         LA    4,64
         LA    3,WARRAY+64
EXPAND   LR    5,3
         S     5,=F'12'
         L     6,0(5)
         LR    5,3
         S     5,=F'32'
         X     6,0(5)
         LR    5,3
         S     5,=F'56'
         X     6,0(5)
         LR    5,3
         S     5,=F'64'
         X     6,0(5)
         LR    7,6
         SLL   6,1
         SRL   7,31
         OR    6,7
         ST    6,0(3)
         LA    3,4(3)
         BCT   4,EXPAND
*
         L     4,HASH0
         L     5,HASH1
         L     6,HASH2
         L     7,HASH3
         L     8,HASH4
         LA    9,WARRAY
         SR    10,10
ROUND    LR    3,5
         C     10,=F'20'
         BL    R0
         C     10,=F'40'
         BL    R20
         C     10,=F'60'
         BL    R40
R60      XR    3,6
         XR    3,7
         L     11,K3
         B     FCALC
R40      NR    3,6
         LR    11,5
         OR    11,6
         NR    11,7
         OR    3,11
         L     11,K2
         B     FCALC
R20      XR    3,6
         XR    3,7
         L     11,K1
         B     FCALC
R0       NR    3,6
         LR    11,5
         X     11,=X'FFFFFFFF'
         NR    11,7
         OR    3,11
         L     11,K0
FCALC    LR    14,4
         SLL   14,5
         LR    2,4
         SRL   2,27
         OR    14,2
         AR    14,3
         AR    14,8
         AR    14,11
         A     14,0(9)
         LR    8,7
         LR    7,6
         LR    3,5
         SRL   3,2
         LR    2,5
         SLL   2,30
         OR    3,2
         LR    6,3
         LR    5,4
         LR    4,14
         LA    9,4(9)
         LA    10,1(10)
         C     10,=F'80'
         BL    ROUND
         A     4,HASH0
         A     5,HASH1
         A     6,HASH2
         A     7,HASH3
         A     8,HASH4
         ST    4,HASH0
         ST    5,HASH1
         ST    6,HASH2
         ST    7,HASH3
         ST    8,HASH4
* Restore R9-R14; R4-R8 deliberately return the state.
         LM    9,14,SAVEREGS+24
         SR    15,15
         BR    14
*
VERSION  DC    C'GITCORE 0.4 CMS/ZVM'
VERLEN   EQU   *-VERSION
USAGE    DC    C'Usage: VERSION SHA1ABC SHA1EMP SHA1TWO'
USAGELEN EQU   *-USAGE
ABCDIG   DC    C'A9993E364706816ABA3E25717850C26C9CD0D89D'
ABCDLEN  EQU   *-ABCDIG
EMPDIG   DC    C'DA39A3EE5E6B4B0D3255BFEF95601890AFD80709'
EMPDLEN  EQU   *-EMPDIG
TWODIG   DC    C'84983E441C3BD26EBAAE4AA1F95129E5E54670F1'
TWODLEN  EQU   *-TWODIG
FAILMSG  DC    C'SHA1 SELF-TEST FAILED'
FAILLEN  EQU   *-FAILMSG
         DS    0F
H0INIT   DC    X'67452301'
H1INIT   DC    X'EFCDAB89'
H2INIT   DC    X'98BADCFE'
H3INIT   DC    X'10325476'
H4INIT   DC    X'C3D2E1F0'
K0       DC    X'5A827999'
K1       DC    X'6ED9EBA1'
K2       DC    X'8F1BBCDC'
K3       DC    X'CA62C1D6'
ABCEXP0  DC    X'A9993E36'
ABCEXP1  DC    X'4706816A'
ABCEXP2  DC    X'BA3E2571'
ABCEXP3  DC    X'7850C26C'
ABCEXP4  DC    X'9CD0D89D'
EMPEXP0  DC    X'DA39A3EE'
EMPEXP1  DC    X'5E6B4B0D'
EMPEXP2  DC    X'3255BFEF'
EMPEXP3  DC    X'95601890'
EMPEXP4  DC    X'AFD80709'
TWOEXP0  DC    X'84983E44'
TWOEXP1  DC    X'1C3BD26E'
TWOEXP2  DC    X'BAAE4AA1'
TWOEXP3  DC    X'F95129E5'
TWOEXP4  DC    X'E54670F1'
         DS    0F
ABCBLOCK DC    X'61626380000000000000000000000000'
         DC    X'00000000000000000000000000000000'
         DC    X'00000000000000000000000000000000'
         DC    X'00000000000000000000000000000018'
EMPBLOCK DC    X'80000000000000000000000000000000'
         DC    X'00000000000000000000000000000000'
         DC    X'00000000000000000000000000000000'
         DC    X'00000000000000000000000000000000'
TWOBLK1  DC    X'61626364626364656364656664656667'
         DC    X'65666768666768696768696A68696A6B'
         DC    X'696A6B6C6A6B6C6D6B6C6D6E6C6D6E6F'
         DC    X'6D6E6F706E6F70718000000000000000'
TWOBLK2  DC    X'00000000000000000000000000000000'
         DC    X'00000000000000000000000000000000'
         DC    X'00000000000000000000000000000000'
         DC    X'000000000000000000000000000001C0'
CALLRET  DS    F
HASH0    DS    F
HASH1    DS    F
HASH2    DS    F
HASH3    DS    F
HASH4    DS    F
SAVEREGS DS    12F
WARRAY   DS    80F
         EPLIST
         END   GITCORE
