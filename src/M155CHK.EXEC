/* M155: compact sealed-fixture acceptance gate for M153/M154. */
address cms
parse arg spec depth path extra
if spec='' | depth='' | path='' | extra\='' then do
 say 'Usage: M155CHK ref depth path'
 exit 4
end
if length(depth)>2 | verify(depth,'0123456789')\=0 then exit 4
if depth+0>8 then exit 4

drop chr.
chr.0=0
cmd='GIT HISTORYFIRSTPRESENCECHRONOLOGY-REF-FULL' spec depth path
'PIPE CMS' cmd '| STEM chr.'
crc=rc
if crc\=0 then do
 say 'M155 CHRONOLOGY FAIL RC' crc
 exit crc
end
cm=0
runs=0
az=0
cz=0
cend=0
do i=1 to chr.0
 line=strip(chr.i)
 if line='HISTORYFIRSTPRESENCECHRONOLOGY FULL SNAPSHOTS VERIFIED' then cm=1
 if pos('HISTORYFIRSTPRESENCECHRONOLOGY PRESENCE RUNS',line)=1 then do
  if word(line,words(line))='2' then runs=1
 end
 if pos('HISTORYFIRSTPRESENCECHRONOLOGY AUTHOR ZERO RUNS',line)=1 then do
  if word(line,words(line))='2' then az=1
 end
 if pos('HISTORYFIRSTPRESENCECHRONOLOGY COMMITTER ZERO RUNS',line)=1 then do
  if word(line,words(line))='2' then cz=1
 end
 if line='HISTORYFIRSTPRESENCECHRONOLOGY DATA END' then cend=1
end
if cm+runs+az+cz+cend\=5 then do
 say 'M155 CHRONOLOGY FAIL SUMMARY' cm runs az cz cend
 exit 8
end
say 'M155 CHRONOLOGY PASS RUNS 2 ZERO 2/2'

drop evt.
evt.0=0
cmd='GIT HISTORYFIRSTPRESENCEEVENTS-REF-FULL' spec depth path
'PIPE CMS' cmd '| STEM evt.'
erc=rc
if erc\=0 then do
 say 'M155 EVENTS FAIL RC' erc
 exit erc
end
em=0
events=0
fromrun=0
deleted=0
eend=0
do i=1 to evt.0
 line=strip(evt.i)
 if line='HISTORYFIRSTPRESENCEEVENTS FULL SNAPSHOTS VERIFIED' then em=1
 if pos('HISTORYFIRSTPRESENCEEVENTS EVENTS',line)=1 then do
  if word(line,words(line))='1' then events=1
 end
 if pos('HISTORYFIRSTPRESENCEEVENTS EVENT 1 FROM RUN',line)=1 then do
  if right(line,14)='RUN 1 TO RUN 2' then fromrun=1
 end
 if pos('HISTORYFIRSTPRESENCEEVENTS EVENT 1 EDGE 1 STATUS',line)=1 then do
  if word(line,words(line))='DELETED' then deleted=1
 end
 if line='HISTORYFIRSTPRESENCEEVENTS DATA END' then eend=1
end
if em+events+fromrun+deleted+eend\=5 then do
 say 'M155 EVENTS FAIL SUMMARY' em events fromrun deleted eend
 exit 8
end
say 'M155 EVENTS PASS 1 DELETED'
say 'M155 COMPACT TARGET GATE PASS'
exit 0
