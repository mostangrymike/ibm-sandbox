/* M155: compact sealed-fixture acceptance gate for M153/M154. */
address cms
parse arg spec depth path extra
if spec='' | depth='' | path='' | extra\='' then do
 say 'Usage: M155CHK ref depth path'
 exit 4
end
if length(depth)>2 | verify(depth,'0123456789')\=0 then exit 4
if depth+0>8 then exit 4

drop chr.
chr.0=0
cmd='GIT HISTORYFIRSTPRESENCECHRONOLOGY-REF-FULL' spec depth path
'PIPE CMS' cmd '| STEM chr.'
crc=rc
if crc\=0 then do
 say 'M155 CHRONOLOGY FAIL RC' crc
 exit crc
end
cm=0
cend=0
do i=1 to chr.0
 line=strip(chr.i)
 if line='HISTORYFIRSTPRESENCECHRONOLOGY FULL SNAPSHOTS VERIFIED' then cm=1
 if line='HISTORYFIRSTPRESENCECHRONOLOGY DATA END' then cend=1
end
if cm+cend\=2 then do
 say 'M155 CHRONOLOGY FAIL MARKERS' cm cend
 exit 8
end
say 'M155 CHRONOLOGY PASS'

drop evt.
evt.0=0
cmd='GIT HISTORYFIRSTPRESENCEEVENTS-REF-FULL' spec depth path
'PIPE CMS' cmd '| STEM evt.'
erc=rc
if erc\=0 then do
 say 'M155 EVENTS FAIL RC' erc
 exit erc
end
em=0
done=0
do i=1 to evt.0
 line=strip(evt.i)
 if line='HISTORYFIRSTPRESENCEEVENTS FULL SNAPSHOTS VERIFIED' then em=1
 if line='HISTORYFIRSTPRESENCEEVENTS DATA END' then done=1
end
if em+done\=2 then do
 say 'M155 EVENTS FAIL MARKERS' em done
 exit 8
end
say 'M155 EVENTS PASS'
say 'M155 COMPACT TARGET GATE PASS'
exit 0
