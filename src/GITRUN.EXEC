/* M24: read-only post-incident native Git CMS regression batch. */
/* No erase, copy, index write, manifest write or pointer write. */
address cms
say 'GITRUN M24 READ ONLY NATIVE GIT REGRESSION'
say 'VERIFY ALL PROTECTED ORIGINAL FILES'
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 'STATE GITFIX' typ 'A'
 if rc \= 0 then exit 12
 'STATE M15NEW' typ 'A'
 if rc \= 0 then exit 12
end
do i=0 to 1
 name='GITSEL'||i
 'STATE' name 'PTR A'
 if rc \= 0 then exit 12
 name='M15SL'||i
 'STATE' name 'PTR A'
 if rc \= 0 then exit 12
end
'STATE GITPBUF PACK A'
if rc \= 0 then exit 12
'STATE GITCIDX MODULE A'
if rc \= 0 then exit 12
'STATE GITREC MODULE A'
if rc \= 0 then exit 12
'STATE M15BAD GEN A'
if rc \= 28 then do
 say 'STOP: M15BAD GEN EXISTS; DO NOT REBIND IT'
 exit 12
end
say 'INDEPENDENT POST-INCIDENT SEALED GENERATION AUDITS'
do i=1 to 2
 name=word('GITFIX M15NEW',i)
 'FILEDEF STGIN DISK' name 'STAGE A'
 if rc \= 0 then exit rc
 'FILEDEF IDXIN DISK' name 'INDEX A'
 if rc \= 0 then exit rc
 'FILEDEF FIDXIN DISK' name 'SEEK A'
 if rc \= 0 then exit rc
 'FILEDEF GENIN DISK' name 'GEN A'
 if rc \= 0 then exit rc
 say 'GENCHECK' name
 'GITCIDX GENCHECK'
 test=rc
 say 'GENCHECK RC' test
 if test \= 0 then exit 12
end
say 'BIND TWO EXISTING SELECTORS AND GENERATIONS'
'FILEDEF SEL0 DISK M15SL0 PTR A'
if rc \= 0 then exit rc
'FILEDEF SEL1 DISK M15SL1 PTR A'
if rc \= 0 then exit rc
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 dd=word('C0STG C0IDX C0SEEK C0GEN',i)
 'FILEDEF' dd 'DISK GITFIX' typ 'A'
 if rc \= 0 then exit rc
 dd=word('C1STG C1IDX C1SEEK C1GEN',i)
 'FILEDEF' dd 'DISK M15NEW' typ 'A'
 if rc \= 0 then exit rc
end
say 'CASE 1: SELECT FULLY VERIFIED GENERATION'
'GITREC SELECT GITFIX M15NEW'
test=rc
say 'SELECT RC' test
if test \= 0 then exit 12
commit='00D8D63229305230C8D37F884CE87F9E1A89468C'
tree='204E1D6968FB81C35BF830D63A611AC64C072945'
readme='524541444D452E6D64'
nested='646F63732F5354415455532E6D64'
say 'CASE 2: LINK FIRST COMMIT TO VERIFIED ROOT TREE'
'GITREC LSROOT GITFIX M15NEW' commit
test=rc
say 'LSROOT RC' test
if test \= 0 then exit 12
say 'CASE 3: RESOLVE README BLOB FROM FIRST COMMIT'
'GITREC PATH GITFIX M15NEW' commit readme
test=rc
say 'README PATH RC' test
if test \= 0 then exit 12
say 'CASE 4: RESOLVE NESTED DOCS STATUS BLOB'
'GITREC PATH GITFIX M15NEW' commit nested
test=rc
say 'NESTED PATH RC' test
if test \= 0 then exit 12
say 'CASE 5: NON COMMIT LSROOT MUST FAIL CLOSED'
'GITREC LSROOT GITFIX M15NEW' tree
test=rc
say 'NON COMMIT RC' test
if test \= 8 then exit 12
say 'CASE 6: MISSING FILE PATH MUST RETURN RC4'
'GITREC PATH GITFIX M15NEW' commit '4E4F5045'
test=rc
say 'MISSING PATH RC' test
if test \= 4 then exit 12
say 'CASE 7: NON TREE INTERMEDIATE MUST RETURN RC8'
'GITREC PATH GITFIX M15NEW' commit '524541444D452E6D642F737562'
test=rc
say 'NON TREE PATH RC' test
if test \= 8 then exit 12
say 'CASE 8: NEWER GEN MISSING; FALL BACK TO OLD'
'FILEDEF C1GEN DISK M15BAD GEN A'
if rc \= 0 then exit rc
'GITREC LSROOT GITFIX M15NEW' commit
test=rc
say 'FALLBACK ROOT RC' test
if test \= 0 then exit 12
say 'CASE 9: BOTH GEN MISSING MUST FAIL CLOSED'
'FILEDEF C0GEN DISK M15BAD GEN A'
if rc \= 0 then exit rc
'GITREC PATH GITFIX M15NEW' commit readme
test=rc
say 'BOTH MISSING PATH RC' test
if test \= 8 then exit 12
say 'CASE 10: RESTORE BOTH VERIFIED INPUTS'
'FILEDEF C0GEN DISK GITFIX GEN A'
if rc \= 0 then exit rc
'FILEDEF C1GEN DISK M15NEW GEN A'
if rc \= 0 then exit rc
'GITREC PATH GITFIX M15NEW' commit nested
test=rc
say 'RESTORED NESTED PATH RC' test
if test \= 0 then exit 12
say 'FINAL VERIFY PROTECTED GENERATIONS AND SELECTORS'
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 'STATE GITFIX' typ 'A'
 if rc \= 0 then exit 12
 'STATE M15NEW' typ 'A'
 if rc \= 0 then exit 12
end
do i=0 to 1
 name='GITSEL'||i
 'STATE' name 'PTR A'
 if rc \= 0 then exit 12
 name='M15SL'||i
 'STATE' name 'PTR A'
 if rc \= 0 then exit 12
end
'STATE GITPBUF PACK A'
if rc \= 0 then exit 12
say 'GITRUN M24 ALL READ ONLY NATIVE GIT TESTS PASSED'
exit 0
