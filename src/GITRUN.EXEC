/* M26Q2: compact, read-only native Git CMS target regression. */
/* PIPE CMS captures diagnostics in memory; no output CMS files. */
address cms
say 'GITRUN M26Q2 COMPACT REPORT'
say 'ALL COUNTS REFER TO VERIFIED ORIGINAL 1808 OBJECTS'
fast='FAST AUDIT VERIFIED 1808 UNIQUE 1808'
pair='PAIR VERIFIED UNIQUE 1808'
gen='GENERATION VERIFIED 1808 UNIQUE 1808'
sel='SELECTED 52 M15NEW'
two='TREE ENTRIES 2'
build='D4BE895844FECE160E31411ABB2ECDD6ACAECC17'
status='46135A22C7394D8090619C6C70453C58A24F5239'
call protected
if result \= 0 then exit 12
'PIPE CMS STATE M15BAD GEN A | STEM out.'
if rc \= 28 then do
 say 'FAIL ABSENT M15BAD GEN EXPECTED RC28 GOT' rc
 exit 12
end
say 'PASS PROTECTED FILES AND ABSENT TEST MANIFEST'
do i=1 to 2
 name=word('GITFIX M15NEW',i)
 'FILEDEF STGIN DISK' name 'STAGE A'
 if rc \= 0 then exit 12
 'FILEDEF IDXIN DISK' name 'INDEX A'
 if rc \= 0 then exit 12
 'FILEDEF FIDXIN DISK' name 'SEEK A'
 if rc \= 0 then exit 12
 'FILEDEF GENIN DISK' name 'GEN A'
 if rc \= 0 then exit 12
 call gate name 'FULL AUDIT','GITCIDX GENCHECK',0,fast,pair,gen
 if result \= 0 then exit 12
end
'FILEDEF SEL0 DISK M15SL0 PTR A'
if rc \= 0 then exit 12
'FILEDEF SEL1 DISK M15SL1 PTR A'
if rc \= 0 then exit 12
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 dd=word('C0STG C0IDX C0SEEK C0GEN',i)
 'FILEDEF' dd 'DISK GITFIX' typ 'A'
 if rc \= 0 then exit 12
 dd=word('C1STG C1IDX C1SEEK C1GEN',i)
 'FILEDEF' dd 'DISK M15NEW' typ 'A'
 if rc \= 0 then exit 12
end
call gate 'SELECT SEQ52','GITREC SELECT GITFIX M15NEW',0,sel,gen
if result \= 0 then exit 12
commit='00D8D63229305230C8D37F884CE87F9E1A89468C'
docs='646F6373'
cmd='GITREC LSDIR GITFIX M15NEW' commit docs
call gate 'DOCS HAS TWO VERIFIED ENTRIES',cmd,0,sel,two,build,status
if result \= 0 then exit 12
cmd='GITREC LSDIR GITFIX M15NEW' commit '524541444D452E6D64'
call gate 'BLOB IS NOT DIRECTORY',cmd,8,'LSDIR REQUIRES A TREE'
if result \= 0 then exit 12
cmd='GITREC LSDIR GITFIX M15NEW' commit '4E4F5045'
call gate 'MISSING DIRECTORY',cmd,4,'PATH NOT FOUND'
if result \= 0 then exit 12
cmd='GITREC LSDIR GITFIX M15NEW' commit '524541444D452E6D642F78'
call gate 'NON TREE INTERMEDIATE',cmd,8,'PATH COMPONENT NOT A TREE'
if result \= 0 then exit 12
'FILEDEF C1GEN DISK M15BAD GEN A'
if rc \= 0 then exit 12
cmd='GITREC LSDIR GITFIX M15NEW' commit docs
call gate 'RECOVERED SEQ51',cmd,0,'RECOVERED 51 GITFIX',two
if result \= 0 then exit 12
'FILEDEF C0GEN DISK M15BAD GEN A'
if rc \= 0 then exit 12
call gate 'BOTH INVALID FAIL CLOSED',cmd,8,'NO FULLY VERIFIED GENERATION'
if result \= 0 then exit 12
'FILEDEF C0GEN DISK GITFIX GEN A'
if rc \= 0 then exit 12
'FILEDEF C1GEN DISK M15NEW GEN A'
if rc \= 0 then exit 12
call gate 'RESTORED SEQ52',cmd,0,sel,two
if result \= 0 then exit 12
call protected
if result \= 0 then exit 12
say 'PASS FINAL PROTECTED FILES'
say 'GITRUN M26Q2 ALL READ ONLY NATIVE GIT TESTS PASSED'
exit 0
/* All stage output is held in an in-memory REXX STEM. No dumps. */
gate:
 parse arg label,cmd,expected,needle1,needle2,needle3,needle4
 out.0=0
 'PIPE CMS' cmd '| STEM out.'
 got=rc
 hits1=(needle1='')
 hits2=(needle2='')
 hits3=(needle3='')
 hits4=(needle4='')
 do n=1 to out.0
  line=out.n
  if needle1 \= '' then
   if pos(needle1,line)>0 then hits1=1
  if needle2 \= '' then
   if pos(needle2,line)>0 then hits2=1
  if needle3 \= '' then
   if pos(needle3,line)>0 then hits3=1
  if needle4 \= '' then
   if pos(needle4,line)>0 then hits4=1
 end
 if got \= expected|\hits1|\hits2|\hits3|\hits4 then do
  say 'FAIL' label 'RC' got 'EXPECTED' expected
  say 'MARKERS' hits1 hits2 hits3 hits4
  first=max(1,out.0-3)
  do n=first to out.0
   say 'DIAG' out.n
  end
  if out.0>4 then say 'DIAG' out.0 'LINES CAPTURED'
  return 12
 end
 say 'PASS' label 'RC' got
 return 0
/* Only read-only CMS STATE commands. The historical M15BAD is separate. */
protected:
 do p=1 to 4
  typ=word('STAGE INDEX SEEK GEN',p)
  'STATE GITFIX' typ 'A'
  if rc \= 0 then return 12
  'STATE M15NEW' typ 'A'
  if rc \= 0 then return 12
 end
 do p=0 to 1
  name='GITSEL'||p
  'STATE' name 'PTR A'
  if rc \= 0 then return 12
  name='M15SL'||p
  'STATE' name 'PTR A'
  if rc \= 0 then return 12
 end
 'STATE GITPBUF PACK A'
 if rc \= 0 then return 12
 'STATE GITCIDX MODULE A'
 if rc \= 0 then return 12
 'STATE GITREC MODULE A'
 if rc \= 0 then return 12
 return 0
