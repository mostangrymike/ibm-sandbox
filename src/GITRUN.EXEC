/* Reusable CMS runner: M15 full read-only failure matrix. */
/* Only FILEDEF input mappings vary. No file is modified. */
address cms
say 'GITRUN M15 COMPREHENSIVE RECOVERY MATRIX'
say 'GITRUN CONFIRM BOTH COMPLETE REAL GENERATIONS'
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 'STATE GITFIX' typ 'A'
 if rc \= 0 then exit 8
 'STATE M15NEW' typ 'A'
 if rc \= 0 then exit 8
 'STATE M15BAD' typ 'A'
 if rc \= 28 then do
  say 'GITRUN STOP: missing fixture exists' typ
  exit 8
 end
end
'STATE M15SL0 PTR A'
if rc \= 0 then exit 8
'STATE M15SL1 PTR A'
if rc \= 0 then exit 8
'FILEDEF SEL0 DISK M15SL0 PTR A'
if rc \= 0 then exit rc
'FILEDEF SEL1 DISK M15SL1 PTR A'
if rc \= 0 then exit rc
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 dd=word('C0STG C0IDX C0SEEK C0GEN',i)
 'FILEDEF' dd 'DISK GITFIX' typ 'A'
 if rc \= 0 then exit rc
 dd=word('C1STG C1IDX C1SEEK C1GEN',i)
 'FILEDEF' dd 'DISK M15NEW' typ 'A'
 if rc \= 0 then exit rc
end
say 'GITRUN CASE 1-4: WITHHOLD EACH NEWER COMPONENT'
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 dd=word('C1STG C1IDX C1SEEK C1GEN',i)
 'FILEDEF' dd 'DISK M15BAD' typ 'A'
 if rc \= 0 then exit rc
 say 'GITRUN EXPECT RECOVERED 51 GITFIX FOR' typ
 'GITREC SELECT GITFIX M15NEW'
 test=rc
 say 'GITRUN NEWER MISSING' typ 'RC' test
 if test \= 0 then exit 12
 'FILEDEF' dd 'DISK M15NEW' typ 'A'
 if rc \= 0 then exit rc
end
say 'GITRUN CASE 5: WITHHOLD OLDER MANIFEST'
'FILEDEF C0GEN DISK M15BAD GEN A'
if rc \= 0 then exit rc
say 'GITRUN EXPECT SELECTED 52 M15NEW'
'GITREC SELECT GITFIX M15NEW'
test=rc
say 'GITRUN OLDER MISSING RC' test
if test \= 0 then exit 12
say 'GITRUN CASE 6: WITHHOLD BOTH MANIFESTS'
'FILEDEF C1GEN DISK M15BAD GEN A'
if rc \= 0 then exit rc
say 'GITRUN EXPECT NO FULLY VERIFIED GENERATION'
'GITREC SELECT GITFIX M15NEW'
test=rc
say 'GITRUN BOTH MISSING RC' test
if test \= 8 then exit 12
'FILEDEF C0GEN DISK GITFIX GEN A'
if rc \= 0 then exit rc
'FILEDEF C1GEN DISK M15NEW GEN A'
if rc \= 0 then exit rc
say 'GITRUN CASE 7: MALFORMED NEWER SELECTOR'
'FILEDEF SEL1 DISK M15NEW GEN A'
if rc \= 0 then exit rc
say 'GITRUN EXPECT SELECTED 51 GITFIX'
'GITREC SELECT GITFIX M15NEW'
test=rc
say 'GITRUN MALFORMED NEWER RC' test
if test \= 0 then exit 12
'FILEDEF SEL1 DISK M15SL1 PTR A'
if rc \= 0 then exit rc
say 'GITRUN CASE 8: MALFORMED OLDER SELECTOR'
'FILEDEF SEL0 DISK GITFIX GEN A'
if rc \= 0 then exit rc
say 'GITRUN EXPECT SELECTED 52 M15NEW'
'GITREC SELECT GITFIX M15NEW'
test=rc
say 'GITRUN MALFORMED OLDER RC' test
if test \= 0 then exit 12
say 'GITRUN CASE 9: BOTH SELECTORS MALFORMED'
'FILEDEF SEL1 DISK M15NEW GEN A'
if rc \= 0 then exit rc
say 'GITRUN EXPECT NO FULLY VERIFIED GENERATION'
'GITREC SELECT GITFIX M15NEW'
test=rc
say 'GITRUN BOTH MALFORMED RC' test
if test \= 8 then exit 12
say 'GITRUN CASE 10: RESTORE ALL FILEDEF INPUTS'
'FILEDEF SEL0 DISK M15SL0 PTR A'
if rc \= 0 then exit rc
'FILEDEF SEL1 DISK M15SL1 PTR A'
if rc \= 0 then exit rc
say 'GITRUN EXPECT SELECTED 52 M15NEW'
'GITREC SELECT GITFIX M15NEW'
test=rc
say 'GITRUN FINAL RESTORATION RC' test
if test \= 0 then exit 12
say 'GITRUN COMPLETE: 10 READ-ONLY RECOVERY CASES'
exit 0
