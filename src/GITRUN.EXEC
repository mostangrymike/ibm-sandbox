/* M17 emergency safety gate after CMS TRKDE 4 disabled wait. */
/* READ ONLY: NO ERASE, COPYFILE, GENWRITE OR POINTER WRITES. */
address cms
say 'GITRUN SAFETY HOLD: M17 CMS DISK ERROR'
say 'TRKDE CODE 4 DURING M12ATLS ASSEMBLE ERASE'
say 'STOP ALL A-DISK CLEANUP UNTIL DASD IMAGE BACKED UP'
say 'PRESERVE GITFIX M15NEW GITSEL0/1 M15SL0/1 AND PACK'
say 'NO FILE SYSTEM WRITES WILL BE ATTEMPTED'
exit 12
