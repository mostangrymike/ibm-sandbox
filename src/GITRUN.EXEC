/* GITRUN: reusable CMS batch; M14 read-only durability audit. */
/* Safe on ordinary later CMS logon or authorized system reboot. */
address cms
say 'GITRUN M14 READ-ONLY DUAL-SLOT DURABILITY'
'STATE GITSEL0 PTR A'
if rc \= 0 then do
 say 'GITRUN STOP: old selector missing RC' rc
 exit 8
end
'STATE GITSEL1 PTR A'
if rc \= 0 then do
 say 'GITRUN STOP: newer selector missing RC' rc
 exit 8
end
'FILEDEF SEL0 DISK GITSEL0 PTR A'
if rc \= 0 then exit rc
'FILEDEF SEL1 DISK GITSEL1 PTR A'
if rc \= 0 then exit rc
'FILEDEF C0STG DISK GITFIX STAGE A'
if rc \= 0 then exit rc
'FILEDEF C0IDX DISK GITFIX INDEX A'
if rc \= 0 then exit rc
'FILEDEF C0SEEK DISK GITFIX SEEK A'
if rc \= 0 then exit rc
'FILEDEF C0GEN DISK GITFIX GEN A'
if rc \= 0 then exit rc
say 'GITRUN EXPECT RECOVERED 41 GITFIX AND RC 0'
'GITREC SELECT GITFIX GITBAD'
selectrc=rc
say 'GITRUN RECOVERY RC' selectrc
exit selectrc
