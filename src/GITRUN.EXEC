/* M15 read-only fallback: re-use existing two disposable slots. */
address cms
say 'GITRUN M15 TWO-CANDIDATE FALLBACK'
'STATE M15SL0 PTR A'
if rc \= 0 then exit 8
'STATE M15SL1 PTR A'
if rc \= 0 then exit 8
'STATE M15NEW GEN A'
if rc \= 0 then exit 8
'STATE GITFIX GEN A'
if rc \= 0 then exit 8
'STATE M15BAD GEN A'
if rc \= 28 then exit 8
'FILEDEF SEL0 DISK M15SL0 PTR A'
if rc \= 0 then exit rc
'FILEDEF SEL1 DISK M15SL1 PTR A'
if rc \= 0 then exit rc
'FILEDEF C0STG DISK GITFIX STAGE A'
if rc \= 0 then exit rc
'FILEDEF C0IDX DISK GITFIX INDEX A'
if rc \= 0 then exit rc
'FILEDEF C0SEEK DISK GITFIX SEEK A'
if rc \= 0 then exit rc
'FILEDEF C0GEN DISK GITFIX GEN A'
if rc \= 0 then exit rc
'FILEDEF C1STG DISK M15NEW STAGE A'
if rc \= 0 then exit rc
'FILEDEF C1IDX DISK M15NEW INDEX A'
if rc \= 0 then exit rc
'FILEDEF C1SEEK DISK M15NEW SEEK A'
if rc \= 0 then exit rc
'FILEDEF C1GEN DISK M15BAD GEN A'
if rc \= 0 then exit rc
say 'GITRUN EXPECT RECOVERED 51 GITFIX RC 0'
'GITREC SELECT GITFIX M15NEW'
if rc \= 0 then exit rc
'FILEDEF C1GEN DISK M15NEW GEN A'
if rc \= 0 then exit rc
say 'GITRUN EXPECT SELECTED 52 M15NEW RC 0'
'GITREC SELECT GITFIX M15NEW'
result=rc
say 'GITRUN RESTORED RC' result
exit result
