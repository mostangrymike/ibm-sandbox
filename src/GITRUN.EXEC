/* M17: guarded cleanup of abandoned native TLS test files. */
address cms
say 'GITRUN M17 NATIVE TLS CLEANUP'
say 'VERIFY SEALED GENERATIONS AND SELECTOR FILES'
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 'STATE GITFIX' typ 'A'
 if rc \= 0 then exit 12
 'STATE M15NEW' typ 'A'
 if rc \= 0 then exit 12
end
do i=0 to 1
 name='GITSEL'||i
 'STATE' name 'PTR A'
 if rc \= 0 then exit 12
 name='M15SL'||i
 'STATE' name 'PTR A'
 if rc \= 0 then exit 12
end
'STATE GITPBUF PACK A'
if rc \= 0 then exit 12
say 'AUDIT ORIGINAL AND SECOND GENERATIONS'
do i=1 to 2
 name=word('GITFIX M15NEW',i)
 'FILEDEF STGIN DISK' name 'STAGE A'
 if rc \= 0 then exit rc
 'FILEDEF IDXIN DISK' name 'INDEX A'
 if rc \= 0 then exit rc
 'FILEDEF FIDXIN DISK' name 'SEEK A'
 if rc \= 0 then exit rc
 'FILEDEF GENIN DISK' name 'GEN A'
 if rc \= 0 then exit rc
 'GITCIDX GENCHECK'
 if rc \= 0 then exit 12
end
say 'VERIFY NORMAL TWO-SLOT SELECTION'
'FILEDEF SEL0 DISK M15SL0 PTR A'
if rc \= 0 then exit rc
'FILEDEF SEL1 DISK M15SL1 PTR A'
if rc \= 0 then exit rc
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 dd=word('C0STG C0IDX C0SEEK C0GEN',i)
 'FILEDEF' dd 'DISK GITFIX' typ 'A'
 if rc \= 0 then exit rc
 dd=word('C1STG C1IDX C1SEEK C1GEN',i)
 'FILEDEF' dd 'DISK M15NEW' typ 'A'
 if rc \= 0 then exit rc
end
'GITREC SELECT GITFIX M15NEW'
if rc \= 0 then exit 12
say 'CLEAN UP ABANDONED NATIVE TLS TESTS'
names='M12ATLS M12TLS2 M12TLS3 M12TLS4'
types='ASSEMBLE LISTING MODULE TEXT'
do i=1 to words(names)
 name=word(names,i)
 do j=1 to words(types)
  typ=word(types,j)
  call clean name,typ
  if result \= 0 then exit 12
 end
end
do i=1 to 3
 name=word('TLSQTEST SSLTEST SSLTEST2',i)
 call clean name,'C'
 if result \= 0 then exit 12
end
say 'VERIFY PROTECTED FILES AFTER CLEANUP'
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 'STATE GITFIX' typ 'A'
 if rc \= 0 then exit 12
 'STATE M15NEW' typ 'A'
 if rc \= 0 then exit 12
end
'STATE GITPBUF PACK A'
if rc \= 0 then exit 12
do i=0 to 1
 name='GITSEL'||i
 'STATE' name 'PTR A'
 if rc \= 0 then exit 12
 name='M15SL'||i
 'STATE' name 'PTR A'
 if rc \= 0 then exit 12
end
say 'GITRUN M17 CLEANUP COMPLETE'
exit 0
clean: procedure
 parse upper arg name,typ
 address cms
 'STATE' name typ 'A'
 if rc=28 then return 0
 if rc \= 0 then return 12
 'ERASE' name typ 'A'
 if rc \= 0 then return 12
 'STATE' name typ 'A'
 if rc \= 28 then return 12
 say 'RETIRED' name typ
 return 0
