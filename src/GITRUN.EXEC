/* GITRUN: reusable CMS runner; M15 isolated candidate build. */
/* Only M15NEW is written. GITFIX and GITSEL* are protected. */
address cms
say 'GITRUN M15 ISOLATED GENERATION BUILD'
say 'GITRUN CHECK ORIGINAL GENERATION FILES'
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 'STATE GITFIX' typ 'A'
 if rc \= 0 then do
  say 'GITRUN STOP: missing GITFIX' typ 'RC' rc
  exit 8
 end
end
say 'GITRUN CHECK ALL NEW GENERATION FILES UNUSED'
do i=1 to 4
 typ=word('STAGE INDEX SEEK GEN',i)
 'STATE M15NEW' typ 'A'
 if rc \= 28 then do
  say 'GITRUN STOP: M15NEW' typ 'already used RC' rc
  exit 8
 end
end
say 'GITRUN CHECK BOTH DISPOSABLE POINTER NAMES UNUSED'
do i=0 to 1
 name='M15SL'||i
 'STATE' name 'PTR A'
 if rc \= 28 then do
  say 'GITRUN STOP: slot' name 'already used RC' rc
  exit 8
 end
end
say 'GITRUN AVAILABLE TARGET DISK SPACE'
'QUERY DISK A'
if rc \= 0 then exit rc
say 'GITRUN COPY VERIFIED SOURCE TO NEW STAGE/INDEX'
'COPYFILE GITFIX STAGE A M15NEW STAGE A'
if rc \= 0 then exit rc
'COPYFILE GITFIX INDEX A M15NEW INDEX A'
if rc \= 0 then exit rc
'STATE M15NEW STAGE A'
if rc \= 0 then exit 8
'STATE M15NEW INDEX A'
if rc \= 0 then exit 8
say 'GITRUN BUILD FRESH SEEK COOKIES IN COPIED STAGE'
'FILEDEF STGIN DISK M15NEW STAGE A'
if rc \= 0 then exit rc
'FILEDEF IDXIN DISK M15NEW INDEX A'
if rc \= 0 then exit rc
'FILEDEF FIDXOUT DISK M15NEW SEEK A (RECFM V LRECL 80'
if rc \= 0 then exit rc
'GITCIDX SBUILD'
if rc \= 0 then do
 say 'GITRUN STOP: M15NEW SEEK BUILD FAILED RC' rc
 exit 8
end
'FILEDEF FIDXIN DISK M15NEW SEEK A'
if rc \= 0 then exit rc
say 'GITRUN SEAL NEW CANDIDATE LAST'
'FILEDEF GENOUT DISK M15NEW GEN A (RECFM V LRECL 80'
if rc \= 0 then exit rc
'GITCIDX GENWRITE'
if rc \= 0 then do
 say 'GITRUN STOP: M15NEW SEAL FAILED RC' rc
 exit 8
end
'FILEDEF GENIN DISK M15NEW GEN A'
if rc \= 0 then exit rc
say 'GITRUN REOPEN AND FULLY VERIFY NEW CANDIDATE'
'GITCIDX GENCHECK'
auditrc=rc
say 'GITRUN M15 NEW GENERATION CHECK RC' auditrc
if auditrc \= 0 then exit auditrc
say 'GITRUN M15NEW VERIFIED; NO SELECTOR WAS WRITTEN'
exit 0
