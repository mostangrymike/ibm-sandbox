/* M9E bounded GITPBUF zlib inflater. */
parse arg command,offset,extra
command = translate(command)
if command \= 'INFLATESTACK' | extra \= '' |,
   datatype(offset,'W') \= 1 | offset < 0 then do
   say 'Usage: GITPINFL INFLATESTACK zlib-offset'
   exit 4
end
address command
'EXEC GITPBUF READSTACK' offset 2
if rc \= 0 | queued() < 1 then exit 8
parse pull head
if length(head) \= 4 then exit 8
cmf = x2d(substr(head,1,2))
flg = x2d(substr(head,3,2))
if cmf // 16 \= 8 | cmf % 16 > 7 then do
   say 'GITPINFL: invalid zlib method/window'
   exit 8
end
if (cmf * 256 + flg) // 31 \= 0 then do
   say 'GITPINFL: invalid zlib FCHECK'
   exit 8
end
if (flg % 32) // 2 then do
   say 'GITPINFL: preset dictionary not supported'
   exit 8
end
defpos = offset + 2
'EXEC GITPDEF INFLATESTACK' defpos
if rc \= 0 then exit rc
if queued() < 2 then do
   say 'GITPINFL: DEFLATE result missing'
   exit 8
end
parse pull out
parse pull defused
if datatype(defused,'W') \= 1 | defused < 1 then exit 8
trailer = defpos + defused
'EXEC GITPBUF READSTACK' trailer 4
if rc \= 0 | queued() < 1 then exit 8
parse pull expected
call adler out
if result \= expected then do
   say 'GITPINFL: Adler-32 mismatch'
   exit 8
end
queue out
queue 2 + defused + 4
exit 0

adler: procedure
   parse arg data
   s1 = 1
   s2 = 0
   do p = 1 to length(data) by 2
      b = x2d(substr(data,p,2))
      s1 = (s1 + b) // 65521
      s2 = (s2 + s1) // 65521
   end
   return d2x(s2,4) || d2x(s1,4)
