/* Native Git for CMS/z/VM */

/* Preserve arguments exactly; normalize only the command verb. */
parse arg command rest
command = translate(command)

if command = '' then do
   say 'Usage: GIT command [arguments]'
   exit 4
end
if command = 'VERSION' then do
   'GITCORE VERSION'
   exit rc
end
if command = 'INIT' then do
   parse var rest extra
   if extra \= '' then do
      say 'Usage: GIT INIT'
      exit 4
   end
   meta.0 = 4
   meta.1 = 'CMS-GIT-REPOSITORY 1'
   meta.2 = 'OBJECT-FORMAT SHA1'
   meta.3 = 'TEXT-RECORD-SEPARATOR LF'
   meta.4 = 'HEAD refs/heads/main'
   'EXECIO' meta.0 'DISKW GITMETA REPO A 1 (STEM META. FINIS'
   if rc \= 0 then exit rc
   say 'Initialized native CMS Git repository on filemode A'
   exit 0
end

if command = 'VERIFY-OBJECT' | command = 'CAT-OBJECT' then do
   parse var rest oid extra
   oid = translate(oid)
   if oid = '' | extra \= '' | length(oid) \= 40 then do
      say 'Usage: GIT' command 'object-id'
      exit 4
   end
   call readobject oid
   if result \= 'OK' then exit 8
   call hashstored objtype, datahex
   actualoid = result
   if actualoid = 'HASHERROR' then exit 8
   if actualoid \= storedoid then do
      say 'GIT: corrupt object' oid '- content hash mismatch'
      exit 8
   end
   if command = 'VERIFY-OBJECT' then do
      say oid 'OK'
      exit 0
   end
   say 'OID' storedoid
   say 'TYPE' objtype
   say 'DATA' datahex
   exit 0
end

/* M4 tree writer: one or more mode/name/OID triples. */
if command = 'WRITE-TREE' then do
   wc = words(rest)
   if wc < 3 | wc // 3 \= 0 then do
      say 'Usage: GIT WRITE-TREE mode name oid [mode name oid ...]'
      exit 4
   end
   count = wc % 3
   do i = 1 to count
      p = (i-1)*3
      mode.i = word(rest,p+1)
      name.i = word(rest,p+2)
      oid.i = translate(word(rest,p+3))
      if mode.i \= '100644' & mode.i \= '100755' &,
         mode.i \= '120000' & mode.i \= '40000' then do
         say 'GIT: unsupported tree mode' mode.i
         exit 4
      end
      if name.i = '' | pos('/',name.i) > 0 |,
         name.i = '.' | name.i = '..' then do
         say 'GIT: invalid tree entry name' name.i
         exit 4
      end
      if length(oid.i) \= 40 |,
         verify(oid.i,'0123456789ABCDEF') \= 0 then do
         say 'GIT: invalid tree entry object-id' oid.i
         exit 4
      end
      call readobject oid.i
      if result \= 'OK' then exit 8
      if mode.i = '40000' & objtype \= 'TREE' then do
         say 'GIT: tree mode requires TREE object' oid.i
         exit 8
      end
      if mode.i \= '40000' & objtype \= 'BLOB' then do
         say 'GIT: file mode requires BLOB object' oid.i
         exit 8
      end
      call toasciihex name.i
      namehex.i = result
      sortkey.i = x2c(namehex.i)
      if mode.i = '40000' then sortkey.i = sortkey.i || x2c('2F')
   end
   do pass = 1 to count-1
      do i = 1 to count-pass
         j = i + 1
         if sortkey.i >> sortkey.j then do
            t=mode.i; mode.i=mode.j; mode.j=t
            t=name.i; name.i=name.j; name.j=t
            t=oid.i; oid.i=oid.j; oid.j=t
            t=namehex.i; namehex.i=namehex.j; namehex.j=t
            t=sortkey.i; sortkey.i=sortkey.j; sortkey.j=t
         end
      end
   end
   datahex = ''
   do i = 1 to count
      call toasciihex mode.i || ' '
      datahex = datahex || result || namehex.i || '00' || oid.i
   end
   call hashstored 'TREE', datahex
   treeoid = result
   if treeoid = 'HASHERROR' then exit 8
   call storeobject treeoid, 'TREE', datahex
   if result \= 'OK' then exit 8
   say treeoid
   exit 0
end

/*
 * COMMIT-TREE keeps the original one-argument deterministic form and adds
 * explicit proof-level options.  Values containing blanks use underscore as
 * the CMS command-line separator escape; underscores are converted to blanks.
 *
 * GIT COMMIT-TREE tree [-P parent ...] [-A identity] [-C identity]
 *      [-T seconds] [-Z timezone] [-M message]
 */
if command = 'COMMIT-TREE' then do
   treeoid = translate(word(rest,1))
   if treeoid = '' | length(treeoid) \= 40 |,
      verify(treeoid,'0123456789ABCDEF') \= 0 then do
      say 'Usage: GIT COMMIT-TREE tree [-P parent] [-A identity] ...'
      exit 4
   end
   call readobject treeoid
   if result \= 'OK' then exit 8
   if objtype \= 'TREE' then do
      say 'GIT: object is not requested tree' treeoid
      exit 8
   end

   author = 'CMS Git <cms@example.invalid>'
   committer = author
   stamp = '0'
   zone = '+0000'
   message = 'Initial commit'
   parent.0 = 0

   i = 2
   do while i <= words(rest)
      opt = translate(word(rest,i))
      if i = words(rest) then do
         say 'GIT: missing value for COMMIT-TREE option' word(rest,i)
         exit 4
      end
      val = word(rest,i+1)
      if opt = '-P' then do
         poid = translate(val)
         if length(poid) \= 40 | verify(poid,'0123456789ABCDEF') \= 0 then do
            say 'GIT: invalid parent object-id' val
            exit 4
         end
         call readobject poid
         if result \= 'OK' then exit 8
         if objtype \= 'COMMIT' then do
            say 'GIT: parent is not a COMMIT object' poid
            exit 8
         end
         parent.0 = parent.0 + 1
         n = parent.0
         parent.n = poid
      end
      else if opt = '-A' then author = translate(val,' ','_')
      else if opt = '-C' then committer = translate(val,' ','_')
      else if opt = '-T' then stamp = val
      else if opt = '-Z' then zone = val
      else if opt = '-M' then message = translate(val,' ','_')
      else do
         say 'GIT: unknown COMMIT-TREE option' word(rest,i)
         exit 4
      end
      i = i + 2
   end

   if verify(stamp,'0123456789') \= 0 | stamp = '' then do
      say 'GIT: invalid commit timestamp' stamp
      exit 4
   end
   if length(zone) \= 5 |,
      (substr(zone,1,1) \= '+' & substr(zone,1,1) \= '-') |,
      verify(substr(zone,2),'0123456789') \= 0 then do
      say 'GIT: invalid commit timezone' zone
      exit 4
   end
   zhour = substr(zone,2,2) + 0
   zmin = substr(zone,4,2) + 0
   if zhour > 23 | zmin > 59 then do
      say 'GIT: invalid commit timezone' zone
      exit 4
   end
   if author = '' | committer = '' then do
      say 'GIT: author and committer identities must not be empty'
      exit 4
   end

   lower = translate(treeoid,'abcdef','ABCDEF')
   call toasciihex 'tree ' || lower
   datahex = result || '0A'
   do i = 1 to parent.0
      lowerp = translate(parent.i,'abcdef','ABCDEF')
      call toasciihex 'parent ' || lowerp
      datahex = datahex || result || '0A'
   end
   call toasciihex 'author ' || author || ' ' || stamp || ' ' || zone
   datahex = datahex || result || '0A'
   call toasciihex 'committer ' || committer || ' ' || stamp || ' ' || zone
   datahex = datahex || result || '0A0A'
   call toasciihex message
   datahex = datahex || result || '0A'
   call hashstored 'COMMIT', datahex
   commitoid = result
   if commitoid = 'HASHERROR' then exit 8
   call storeobject commitoid, 'COMMIT', datahex
   if result \= 'OK' then exit 8
   say commitoid
   exit 0
end

if command = 'HASH-OBJECT' | command = 'WRITE-OBJECT' then do
   parse var rest fn ft fm extra
   if fn = '' | ft = '' | extra \= '' then do
      say 'Usage: GIT' command 'filename filetype [filemode]'
      exit 4
   end
   /* CMS file identifiers are case-insensitive; normalize them only here. */
   fn = translate(fn)
   ft = translate(ft)
   fm = translate(fm)
   if fm = '' then fm = '*'
   drop line.
   'EXECIO * DISKR' fn ft fm '1 (STEM LINE. FINIS STRIP'
   if rc \= 0 then do
      say 'GIT: cannot read' fn ft fm
      exit rc
   end
   hex = ''
   do i = 1 to line.0
      call toasciihex line.i
      if i > 1 then hex = hex || '0A'
      hex = hex || result
   end
   call hashstored 'BLOB', hex
   oid = result
   if oid = 'HASHERROR' then exit 8
   if command = 'HASH-OBJECT' then do
      say oid
      exit 0
   end
   call storeobject oid, 'BLOB', hex
   if result \= 'OK' then exit 8
   say oid
   exit 0
end

say 'GIT: unknown command' command
exit 4

storeobject: procedure
   parse upper arg oid, type, datahex
   objfn = substr(oid,1,8)
   'STATE' objfn 'GITOBJ A'
   if rc = 0 then do
      drop old.
      'EXECIO * DISKR' objfn 'GITOBJ A 1 (STEM OLD. FINIS'
      if rc \= 0 then do
         say 'GIT: cannot inspect existing object' objfn
         return 'ERROR'
      end
      if old.0 < 1 | word(old.1,1) \= 'OID' |,
         word(old.1,2) \= oid then do
         say 'GIT: object filename collision' objfn
         return 'ERROR'
      end
   end
   drop out.
   out.1 = 'OID' oid
   out.2 = 'TYPE' type
   out.3 = 'SIZE' length(datahex) % 2
   n = 3
   pos = 1
   do while pos <= length(datahex)
      take = min(128,length(datahex)-pos+1)
      n = n + 1
      out.n = 'DATA' substr(datahex,pos,take)
      pos = pos + take
   end
   out.0 = n
   'EXECIO' out.0 'DISKW' objfn 'GITOBJ A 1 (STEM OUT. FINIS'
   if rc \= 0 then do
      say 'GIT: cannot store object' oid
      return 'ERROR'
   end
   return 'OK'

readobject: procedure expose storedoid objtype datahex
   parse upper arg oid
   objfn = substr(oid,1,8)
   drop obj.
   'EXECIO * DISKR' objfn 'GITOBJ A 1 (STEM OBJ. FINIS'
   if rc \= 0 then do
      say 'GIT: object not found' oid
      return 'ERROR'
   end
   if obj.0 < 3 | word(obj.1,1) \= 'OID' |,
      word(obj.2,1) \= 'TYPE' then do
      say 'GIT: corrupt object' oid '- invalid record layout'
      return 'ERROR'
   end
   storedoid = word(obj.1,2)
   objtype = word(obj.2,2)
   if length(storedoid) \= 40 | storedoid \= oid then do
      say 'GIT: corrupt object' oid '- stored OID mismatch'
      return 'ERROR'
   end
   if objtype \= 'BLOB' & objtype \= 'TREE' &,
      objtype \= 'COMMIT' then do
      say 'GIT: unsupported object type' objtype
      return 'ERROR'
   end
   datahex = ''
   if obj.0 = 3 & word(obj.3,1) = 'DATA' then do
      datahex = word(obj.3,2)
   end
   else do
      if word(obj.3,1) \= 'SIZE' then do
         say 'GIT: corrupt object' oid '- SIZE record missing'
         return 'ERROR'
      end
      size = word(obj.3,2)
      if datatype(size,'W') \= 1 | size < 0 then do
         say 'GIT: corrupt object' oid '- invalid SIZE'
         return 'ERROR'
      end
      do i = 4 to obj.0
         if word(obj.i,1) \= 'DATA' then do
            say 'GIT: corrupt object' oid '- invalid DATA record'
            return 'ERROR'
         end
         chunk = word(obj.i,2)
         if length(chunk) > 128 then do
            say 'GIT: corrupt object' oid '- DATA chunk too long'
            return 'ERROR'
         end
         datahex = datahex || chunk
      end
      if length(datahex) % 2 \= size then do
         say 'GIT: corrupt object' oid '- SIZE mismatch'
         return 'ERROR'
      end
   end
   if length(datahex) // 2 \= 0 |,
      verify(datahex,'0123456789ABCDEF') \= 0 then do
      say 'GIT: corrupt object' oid '- invalid DATA hex'
      return 'ERROR'
   end
   return 'OK'

toasciihex: procedure
   parse arg text
   e2ahex = '000102031A091A7F1A1A1A0B0C0D0E0F' ||,
            '101112131A1A081A18191A1A1C1D1E1F' ||,
            '1A1A1C1A1A0A171B1A1A1A1A1A050607' ||,
            '1A1A161A1A1E1A041A1A1A1A14151A1A' ||,
            '20A6E180EB909FE2AB8B9B2E3C282B7C' ||,
            '26A9AA9CDBA599E3A89E21242A293B5E' ||,
            '2D2FDFDC9ADDDE989DACBA2C255F3E3F' ||,
            'D78894B0B1B2FCD6FB603A2340273D22' ||,
            'F861626364656667686996A4F3AFAEC5' ||,
            '8C6A6B6C6D6E6F7071729787CE93F1FE' ||,
            'C87E737475767778797AEFC0DA5BF2F9' ||,
            'B5B6FDB7B8B9E6BBBCBD8DD9BF5DD8C4' ||,
            '7B414243444546474849CBCABEE8ECED' ||,
            '7D4A4B4C4D4E4F505152A1ADF5F4A38F' ||,
            '5CE7535455565758595AA0858EE9E4D1' ||,
            '30313233343536373839B3F7F0FAA7FF'
   e2a = x2c(e2ahex)
   bytes = x2c('000102030405060708090A0B0C0D0E0F' ||,
               '101112131415161718191A1B1C1D1E1F' ||,
               '202122232425262728292A2B2C2D2E2F' ||,
               '303132333435363738393A3B3C3D3E3F' ||,
               '404142434445464748494A4B4C4D4E4F' ||,
               '505152535455565758595A5B5C5D5E5F' ||,
               '606162636465666768696A6B6C6D6E6F' ||,
               '707172737475767778797A7B7C7D7E7F' ||,
               '808182838485868788898A8B8C8D8E8F' ||,
               '909192939495969798999A9B9C9D9E9F' ||,
               'A0A1A2A3A4A5A6A7A8A9AAABACADAEAF' ||,
               'B0B1B2B3B4B5B6B7B8B9BABBBCBDBEBF' ||,
               'C0C1C2C3C4C5C6C7C8C9CACBCCCDCECF' ||,
               'D0D1D2D3D4D5D6D7D8D9DADBDCDDDEDF' ||,
               'E0E1E2E3E4E5E6E7E8E9EAEBECEDEEEF' ||,
               'F0F1F2F3F4F5F6F7F8F9FAFBFCFDFEFF')
   return c2x(translate(text,e2a,bytes))

hashstored: procedure
   parse upper arg type, datahex
   bodylen = length(datahex) % 2
   dec = bodylen
   dechex = ''
   do i = 1 to length(dec)
      digit = substr(dec,i,1)
      dechex = dechex || d2x(digit+48,2)
   end
   if type = 'BLOB' then prefix = '626C6F6220'
   else if type = 'TREE' then prefix = '7472656520'
   else if type = 'COMMIT' then prefix = '636F6D6D697420'
   else return 'HASHERROR'
   streamhex = prefix || dechex || '00' || datahex
   total = length(streamhex) % 2
   header = right(d2x(total),8,'0')
   'MAKEBUF'
   if rc < 0 then return 'HASHERROR'
   queue header
   pos = 1
   do while pos <= length(streamhex)
      remain = length(streamhex) - pos + 1
      take = min(128,remain)
      queue substr(streamhex,pos,take)
      pos = pos + take
   end
   'GITSTRM'
   src = rc
   if src \= 0 then do
      'DROPBUF'
      return 'HASHERROR'
   end
   pull oid
   'DROPBUF'
   return oid
