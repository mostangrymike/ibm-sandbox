/* M9F bounded ordinary-object PACK walker over GITPBUF. */
parse upper arg command extra
if command \= 'WALK' | extra \= '' then do
   say 'Usage: GITPBWLK WALK'
   exit 4
end
address command

call readhex 0,12
if result = 'ERROR' then exit 8
hdr = result
if substr(hdr,1,8) \= '5041434B' then do
   say 'GITPBWLK: bad PACK signature'
   exit 8
end
version = x2d(substr(hdr,9,8))
objects = x2d(substr(hdr,17,8))
if version \= 2 then do
   say 'GITPBWLK: unsupported PACK version' version
   exit 8
end

pos = 12
do entry = 1 to objects
   entrypos = pos
   call readbyte pos
   if result = 'ERROR' then exit 8
   b = result
   pos = pos + 1
   type = (b % 16) // 8
   size = b // 16
   shift = 4
   more = b >= 128
   do while more
      call readbyte pos
      if result = 'ERROR' then exit 8
      b = result
      pos = pos + 1
      size = size + (b // 128) * (2 ** shift)
      shift = shift + 7
      more = b >= 128
   end
   if type = 6 then do
      call ofshdr
      if result = 'ERROR' then exit 8
      basepos = entrypos - distance
      found = 0
      if ctxpos.0 \= 'CTXPOS.0' then do k = 1 to ctxpos.0
         if ctxpos.k = basepos then do
            basehex = ctxdata.k
            found = 1
            leave
         end
      end
      if \found then do
         say 'GITPBWLK: OFS base not found' basepos
         exit 8
      end
   end
   else if type = 7 then do
      call readhex pos,20
      if result = 'ERROR' then exit 8
      baseoid = result
      pos = pos + 20
      found = 0
      if ctxpos.0 \= 'CTXPOS.0' then do k = 1 to ctxpos.0
         if ctxoid.k = baseoid then do
            basehex = ctxdata.k
            found = 1
            leave
         end
      end
      if \found then do
         say 'GITPBWLK: REF base not found' baseoid
         exit 8
      end
   end
   else if type \= 3 then do
      say 'GITPBWLK: unsupported packed object type' type
      exit 8
   end
   'EXEC GITPINFL INFLATESTACK' pos
   if rc \= 0 then exit rc
   if queued() < 2 then do
      say 'GITPBWLK: inflater stack result missing'
      exit 8
   end
   parse pull datahex
   parse pull used
   if length(datahex) % 2 \= size then do
      say 'GITPBWLK: inflated size mismatch'
      exit 8
   end
   if type = 6 | type = 7 then do
      'EXEC GITDAPP APPLYSTACK' basehex datahex
      if rc \= 0 then exit rc
      parse pull datahex
   end
   call bloboid datahex
   if result = 'ERROR' then exit 8
   oid = result
   ctxpos.0 = entry
   ctxpos.entry = entrypos
   ctxdata.entry = datahex
   ctxoid.entry = oid
   say 'ENTRY' entry 'POSITION' entrypos 'TYPE BLOB SIZE' size
   say 'DATA' datahex
   pos = pos + used
end
say 'PACK VERSION' version
say 'PACK OBJECTS' objects
say 'PACK DATA END' pos
exit 0

readbyte:
   parse arg offset
   call readhex offset,1
   if result = 'ERROR' then return 'ERROR'
   return x2d(result)

readhex:
   parse arg offset,count
   'EXEC GITPBUF READSTACK' offset count
   if rc \= 0 | queued() < 1 then return 'ERROR'
   parse pull h
   if length(h) \= count * 2 then return 'ERROR'
   return translate(h)

ofshdr:
   call readbyte pos
   if result = 'ERROR' then return 'ERROR'
   b = result
   pos = pos + 1
   distance = b // 128
   more = b >= 128
   do while more
      call readbyte pos
      if result = 'ERROR' then return 'ERROR'
      b = result
      pos = pos + 1
      distance = (distance + 1) * 128 + (b // 128)
      more = b >= 128
   end
   if distance < 1 | distance > entrypos then do
      say 'GITPBWLK: invalid OFS_DELTA base distance' distance
      return 'ERROR'
   end
   return 'OK'

bloboid:
   parse arg data
   bytes = length(data) % 2
   dec = bytes
   digits = ''
   if dec = 0 then digits = '30'
   else do while dec > 0
      d = dec // 10
      digits = d2x(48+d,2) || digits
      dec = dec % 10
   end
   input = '626C6F62' || '20' || digits || '00' || data
   'MAKEBUF'
   queue right(d2x(length(input)%2),8,'0')
   do while length(input) > 128
      queue left(input,128)
      input = substr(input,129)
   end
   if input \= '' then queue input
   'GITSTRM'
   save = rc
   if save \= 0 then do
      'DROPBUF'
      say 'GITPBWLK: object SHA-1 failed RC=' save
      return 'ERROR'
   end
   parse pull digest
   'DROPBUF'
   return translate(digest)
