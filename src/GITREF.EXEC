/* M5 CMS-native ref prototype; isolated from target-proven GIT EXEC core. */
parse arg command rest
command = translate(command)

if command = 'INIT' then do
   parse var rest extra
   if extra \= '' then exit 4
   drop meta.
   'EXECIO * DISKR GITMETA REPO A 1 (STEM META. FINIS'
   if rc \= 0 then do
      say 'GITREF: repository metadata not found'
      exit 8
   end
   exit 0
end

if command = 'BRANCH' then do
   wc = words(rest)
   if wc = 0 then do
      call readhead
      if result \= 'OK' then exit 8
      call readrefs
      if result \= 'OK' then exit 8
      do i = 1 to refcount
         mark = ' '
         if headref = 'refs/heads/' || refname.i then mark = '*'
         say mark refname.i refoid.i
      end
      exit 0
   end
   if wc \= 2 then do
      say 'Usage: GITREF BRANCH [name commit-object-id]'
      exit 4
   end
   name = word(rest,1)
   oid = translate(word(rest,2))
   call validbranch name
   if result \= 'OK' then exit 4
   if length(oid) \= 40 | verify(oid,'0123456789ABCDEF') \= 0 then do
      say 'GITREF: invalid branch object-id' word(rest,2)
      exit 4
   end
   call requirecommit oid
   if result \= 'OK' then exit 8
   call readrefs
   if result \= 'OK' then exit 8
   do i = 1 to refcount
      if refname.i = name then do
         say 'GITREF: branch already exists' name
         exit 8
      end
   end
   refcount = refcount + 1
   n = refcount
   refname.n = name
   refoid.n = oid
   call writerefs
   if result \= 'OK' then exit 8
   say 'refs/heads/' || name oid
   exit 0
end

if command = 'SYMBOLIC-REF' then do
   wc = words(rest)
   if wc = 0 then do
      call readhead
      if result \= 'OK' then exit 8
      say headref
      exit 0
   end
   if wc \= 1 then do
      say 'Usage: GITREF SYMBOLIC-REF [refs/heads/name]'
      exit 4
   end
   newref = word(rest,1)
   if left(newref,11) \= 'refs/heads/' then do
      say 'GITREF: HEAD must name refs/heads/<branch>'
      exit 4
   end
   name = substr(newref,12)
   call validbranch name
   if result \= 'OK' then exit 4
   call readrefs
   if result \= 'OK' then exit 8
   found = 0
   do i = 1 to refcount
      if refname.i = name then found = 1
   end
   if \found then do
      say 'GITREF: branch not found' name
      exit 8
   end
   call writehead newref
   if result \= 'OK' then exit 8
   say newref
   exit 0
end

if command = 'REV-PARSE' then do
   parse var rest spec extra
   if spec = '' | extra \= '' then exit 4
   call readrefs
   if result \= 'OK' then exit 8
   if translate(spec) = 'HEAD' then do
      call readhead
      if result \= 'OK' then exit 8
      spec = headref
   end
   if left(spec,11) = 'refs/heads/' then name = substr(spec,12)
   else name = spec
   do i = 1 to refcount
      if refname.i = name then do
         say refoid.i
         exit 0
      end
   end
   say 'GITREF: ref not found' spec
   exit 8
end

if command = 'SHOW-REF' then do
   if words(rest) \= 0 then exit 4
   call readrefs
   if result \= 'OK' then exit 8
   do i = 1 to refcount
      say refoid.i 'refs/heads/' || refname.i
   end
   exit 0
end

say 'GITREF: unknown command' command
exit 4

validbranch: procedure
   parse arg name
   if name = '' | name = '.' | name = '..' | pos('/',name) > 0 |,
      pos(' ',name) > 0 | pos('..',name) > 0 | pos('~',name) > 0 |,
      pos('^',name) > 0 | pos(':',name) > 0 | pos('?',name) > 0 |,
      pos('*',name) > 0 | pos('[',name) > 0 | right(name,1) = '.' then do
      say 'GITREF: invalid branch name' name
      return 'ERROR'
   end
   return 'OK'

requirecommit: procedure
   parse upper arg oid
   fn = substr(oid,1,8)
   drop obj.
   'EXECIO * DISKR' fn 'GITOBJ A 1 (STEM OBJ. FINIS'
   if rc \= 0 then do
      say 'GITREF: object not found' oid
      return 'ERROR'
   end
   if obj.0 < 2 | word(obj.1,1) \= 'OID' | word(obj.1,2) \= oid |,
      word(obj.2,1) \= 'TYPE' then do
      say 'GITREF: invalid object record' oid
      return 'ERROR'
   end
   if word(obj.2,2) \= 'COMMIT' then do
      say 'GITREF: branch target is not a COMMIT object' oid
      return 'ERROR'
   end
   return 'OK'

readrefs: procedure expose refcount refname. refoid.
   drop refname. refoid.
   refcount = 0
   'STATE GITREFS REPO A'
   if rc \= 0 then return 'OK'
   drop rr.
   'EXECIO * DISKR GITREFS REPO A 1 (STEM RR. FINIS'
   if rc \= 0 then return 'ERROR'
   do i = 1 to rr.0
      if words(rr.i) \= 3 then do
         say 'GITREF: corrupt refs record' i
         return 'ERROR'
      end
      tag = word(rr.i,1)
      name = word(rr.i,2)
      oid = word(rr.i,3)
      if tag \= 'BRANCH' | name = '' |,
         length(oid) \= 40 | verify(oid,'0123456789ABCDEF') \= 0 then do
         say 'GITREF: corrupt refs record' i
         return 'ERROR'
      end
      refcount = refcount + 1
      n = refcount
      refname.n = name
      refoid.n = oid
   end
   return 'OK'

writerefs: procedure expose refcount refname. refoid.
   drop wr.
   wr.0 = refcount
   do i = 1 to refcount
      wr.i = 'BRANCH' refname.i refoid.i
   end
   'EXECIO' wr.0 'DISKW GITREFS REPO A 1 (STEM WR. FINIS'
   if rc \= 0 then return 'ERROR'
   return 'OK'

readhead: procedure expose headref
   drop hm.
   'EXECIO * DISKR GITMETA REPO A 1 (STEM HM. FINIS'
   if rc \= 0 then return 'ERROR'
   headref = ''
   do i = 1 to hm.0
      if word(hm.i,1) = 'HEAD' then headref = word(hm.i,2)
   end
   if left(headref,11) \= 'refs/heads/' then do
      say 'GITREF: invalid symbolic HEAD'
      return 'ERROR'
   end
   return 'OK'

writehead: procedure expose headref
   parse arg newref
   drop hm.
   'EXECIO * DISKR GITMETA REPO A 1 (STEM HM. FINIS'
   if rc \= 0 then return 'ERROR'
   found = 0
   do i = 1 to hm.0
      if word(hm.i,1) = 'HEAD' then do
         hm.i = 'HEAD' newref
         found = 1
      end
   end
   if \found then do
      hm.0 = hm.0 + 1
      n = hm.0
      hm.n = 'HEAD' newref
   end
   'EXECIO' hm.0 'DISKW GITMETA REPO A 1 (STEM HM. FINIS'
   if rc \= 0 then return 'ERROR'
   headref = newref
   return 'OK'
