/* M157: compact sealed-fixture gate for current presence age. */
address cms
parse arg extra
if extra\='' then do
 say 'Usage: M157CHK'
 exit 4
end

lvl.0=0
'PIPE CMS GIT LEVEL | STEM lvl.'
lrc=rc
if lrc\=0 then do
 say 'M157 LEVEL FAIL RC' lrc
 exit lrc
end
if lvl.0\=2 then exit 8
parse var lvl.1 g1 e1 l1 gv
parse var lvl.2 g2 e2 l2 vv
if g1\='GIT' | e1\='EXEC' | l1\='LEVEL' then exit 8
if g2\='GITVREF' | e2\='EXEC' | l2\='LEVEL' then exit 8
if left(gv,1)\='M' | left(vv,1)\='M' then exit 8
gn=substr(gv,2)
vn=substr(vv,2)
if datatype(gn,'W')\=1 | datatype(vn,'W')\=1 then exit 8
if gn\=vn | gn<157 then exit 8
say 'M157 LEVEL PASS' gv'/'vv
drop sig.
sig.0=0
'PIPE CMS EXEC GITVREF STAMP | STEM sig.'
src=rc
if src\=0 | sig.0\=1 | sig.1\='GITVREF INTERNAL STAMP P2' then do
 say 'M157 GITVREF STAMP FAIL'
 exit 8
end
say 'M157 GITVREF STAMP PASS P2'
spec='6EF11911449C184457F3958ABE4CA7A0692CE8C9'
path='src/GITPBWALK.EXEC'
cmd='EXEC GIT HISTORYFIRSTPRESENCEAGE-REF-FULL' spec 6 path
drop out.
out.0=0
address command 'PIPE COMMAND' cmd '| STEM out.'
grc=rc
if grc\=0 then do
 say 'M157 AGE FAIL RC' grc
 exit grc
end
mark=0
sumok=0
proof=0
dend=0
seenS=''
seenR=''
do i=1 to out.0
 line=space(out.i)
 if line='HISTORYFIRSTPRESENCEAGE FULL SNAPSHOTS VERIFIED' then mark=1
 if pos('HFPA P2 S ',line)=1 then do
  seenS=line
  if line='HFPA P2 S 2 6 1 CHANGE' then sumok=1
 end
 if pos('HFPA P2 R ',line)=1 then do
  seenR=line
  if line='HFPA P2 R ABSENT 6 DELETED 268 268' then proof=1
 end
 if line='HISTORYFIRSTPRESENCEAGE DATA END' then dend=1
end
if mark+sumok+proof+dend\=4 then do
 say 'M157 AGE FAIL PROOF' mark sumok proof dend
 if seenS\='' then say seenS
 if seenR\='' then say seenR
 exit 8
end
say 'M157 AGE PASS ABSENT EDGE 6 DELETED 268/268'
say 'M157 COMPACT TARGET GATE PASS'
exit 0
