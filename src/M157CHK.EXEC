/* M157: compact sealed-fixture gate for current presence age. */
address cms
parse arg extra
if extra\='' then do
 say 'Usage: M157CHK'
 exit 4
end

lvl.0=0
'PIPE CMS GIT LEVEL | STEM lvl.'
lrc=rc
if lrc\=0 then do
 say 'M157 LEVEL FAIL RC' lrc
 exit lrc
end
if lvl.0\=2 then exit 8
parse var lvl.1 g1 e1 l1 gv
parse var lvl.2 g2 e2 l2 vv
if g1\='GIT' | e1\='EXEC' | l1\='LEVEL' then exit 8
if g2\='GITVREF' | e2\='EXEC' | l2\='LEVEL' then exit 8
if left(gv,1)\='M' | left(vv,1)\='M' then exit 8
gn=substr(gv,2)
vn=substr(vv,2)
if datatype(gn,'W')\=1 | datatype(vn,'W')\=1 then exit 8
if gn\=vn | gn<157 then exit 8
say 'M157 LEVEL PASS' gv'/'vv
spec='6EF11911449C184457F3958ABE4CA7A0692CE8C9'
path='src/GITPBWALK.EXEC'
cmd='GIT HISTORYFIRSTPRESENCEAGE-REF-FULL' spec 6 path
drop out.
out.0=0
'PIPE CMS' cmd '| STEM out.'
grc=rc
if grc\=0 then do
 say 'M157 AGE FAIL RC' grc
 exit grc
end
mark=0
proof=0
dend=0
seen=''
want='HISTORYFIRSTPRESENCEAGE PROOF ABSENT 6 DELETED 268 268'
do i=1 to out.0
 line=space(out.i)
 if line='HISTORYFIRSTPRESENCEAGE FULL SNAPSHOTS VERIFIED' then mark=1
 if pos('HISTORYFIRSTPRESENCEAGE PROOF',line)=1 then do
  seen=line
  if line=want then proof=1
 end
 if line='HISTORYFIRSTPRESENCEAGE DATA END' then dend=1
end
if mark+proof+dend\=3 then do
 say 'M157 AGE FAIL PROOF' mark proof dend
 if seen\='' then say seen
 exit 8
end
say 'M157 AGE PASS ABSENT EDGE 6 DELETED 268/268'
say 'M157 COMPACT TARGET GATE PASS'
exit 0
